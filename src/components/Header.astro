---
// Shared site header (SOW-010 V3). Brand + flat nav + light/dark toggle + sign-in, in the V3 design
// language (classes from gbti-v3.css). Token-driven, so it works in both themes. Replaces the legacy
// dark mega-menu. The icon sprite is rendered once in BaseLayout.
// sow-131: the top nav is compressed to Feeds (a dropdown over the six feed views) + the two
// standalone pages. The directories (/articles/, /projects/, /prompts/) keep their URLs and footer
// links; the feed views are the primary browse surface.
// sow-187: the feed list is now the ONE consolidated source (src/lib/site-nav.ts), shared with the FeedView
// tab strip + the footer. SIGNED_IN_NAV / SIGNED_OUT_NAV are the two FLAT header navs; identity swaps which is
// shown (applyHeaderIdentity, mirroring the account-menu swap). Both navs ship in the static HTML to everyone
// (labels + public hrefs only, nothing gated), so a signed-in member sees a brief flash of the signed-out nav.
// sow-131 follow-up (owner, 2026-08-27): the signed-out nav is now flat links too, not a "Feeds" dropdown.
import { SIGNED_IN_NAV, SIGNED_OUT_NAV } from '../lib/site-nav';
import { extensionCtaEnabled } from '../lib/site-settings';
// The signed-out standalone pages (kept out of the signed-in nav per the owner: only the five feed items there).
// sow-201 (owner decision): Revenue Model comes OUT of the header nav and stays in the footer (Footer.astro).
// sow-271: "Get Extension" is extension ADVERTISING, so it is governed by the superadmin site setting. With the
// setting off this array is empty and the map below renders nothing, so the signed-out nav is SIGNED_OUT_NAV
// alone. That is intended, not a bug; if the slot should carry something else, add it here.
const extensionCtaShown = extensionCtaEnabled();
const signedOutExtra = extensionCtaShown
  ? [{ label: 'Get Extension', href: '/extension/' }]
  : [];
---
<header class="site-head" id="top">
  <div class="wrap head-inner">
    <a class="brand" href="/" aria-label="GBTI Network home">
      <span class="brand-mark" aria-hidden="true"></span>
      <span class="brand-word">GBTI</span>
    </a>

    {/* sow-187: two navs baked into the static HTML; applyHeaderIdentity reveals the signed-in one and hides
        the signed-out one once identity resolves (same swap the account menu uses). Default = signed-out, so a
        visitor and a no-JS load both get the correct nav. */}
    <nav class="nav" aria-label="Primary">
      <div class="nav-set" data-nav-set="out">
        {SIGNED_OUT_NAV.map((i) => <a href={i.href}>{i.label}</a>)}
        {signedOutExtra.map((i) => <a href={i.href}>{i.label}</a>)}
      </div>
      <div class="nav-set" data-nav-set="in" hidden>
        {SIGNED_IN_NAV.map((i) => <a href={i.href}>{i.label}</a>)}
      </div>
    </nav>

    <div class="head-cta">
      <button type="button" class="theme-toggle" data-theme-toggle aria-label="Toggle dark mode" data-tooltip="Toggle dark mode" data-tooltip-pos="below">
        <svg class="ico-moon" viewBox="0 0 24 24" aria-hidden="true"><use href="#ico-moon" /></svg>
        <svg class="ico-sun" viewBox="0 0 24 24" aria-hidden="true"><use href="#ico-sun" /></svg>
      </button>
      {/* sow-394 (owner's design, 2026-09-24): the way in to publishing for a signed-out reader. Hidden with Sign in
          once identity resolves (applyHeaderIdentity below), and shown only from 920px up: the nav is centred with
          equal gaps, and this button costs about 150px of them, so below 920px they drop under 35px and collide
          by 821px (measured on the live header). Between 651px and 920px it is simply absent; the end of every
          article and the footer still carry the link. At 650px and below it is an item in the phone menu. */}
      <a href="/submit-content/" class="head-submit" data-submit-cta><svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><use href="#ico-pencil" /></svg> Submit content</a>
      <a href="/login/" class="btn-gh" data-signin><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><use href="#ico-github" /></svg> Sign in</a>
      {/* SOW-186 C2: the site notification bell. Ships inert + hidden; upgrades (setClient + the element module)
          only for a signed-in WEBSITE member with a cookie session, then reveals itself. A visitor never sees it. */}
      <gbti-notification-bell class="head-bell" data-gbti-region="bell" hidden></gbti-notification-bell>
      {/* SOW-030/036: shown only when the GBTI extension stamps a signed-in member signal (presentation only). The
          avatar is a menu button; its items deep-link into the extension's management pages via the content-script
          relay (the site cannot link to chrome-extension:// directly). */}
      <div class="head-me-wrap" data-head-me-wrap hidden>
        <button type="button" class="head-me" data-head-me aria-haspopup="true" aria-expanded="false" aria-label="Account menu">
          <img class="head-me-av" data-head-me-av alt="" width="26" height="26" decoding="async" />
          <span class="head-me-name" data-head-me-name></span>
          <svg class="head-me-caret" viewBox="0 0 16 16" width="13" height="13" aria-hidden="true"><path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
        <div class="head-menu" data-head-menu role="menu" hidden>
          <a class="hm-item" role="menuitem" data-head-me-profile href="/members/">Profile</a>
          <div class="hm-sep" role="separator"></div>
          {/* SOW: shown only in the hint-only state (signed up, extension not installed yet) -> nudge the download.
              sow-271: this is a download NUDGE, so it is extension advertising and the site setting governs it. It
              also frames the extension as needed "to continue", which is the copy class sow-271 exists to retire.
              setMenuMode already guards with `if (dl)`, so the element being absent is a supported state. */}
          {extensionCtaShown && <a class="hm-item hm-download" role="menuitem" href="/extension/" hidden>Get the extension to continue &rarr;</a>}
          {/* sow-158: the signed-in member menu is now SITE-native (no extension relay). Every item is a site link;
              the WorkBench honors #tab= deep-links (Phase 3a/3b). Shown in the 'member' menu mode (a resolved cookie
              OR extension signal). The extension keeps its OWN avatar menu for in-place editing; the public site no
              longer relays actions to it. Admin tools -> a /admin stub until the site admin surface lands (sow-161). */}
          {/* sow-187: News + "Browse the network" moved to the primary signed-in nav, so they are dropped here.
              sow-379 (owner, 2026-09-20): SIX MORE WENT, and the reason is worth keeping, because the list now
              reads as lost functionality and is not. My articles, My prompts, My projects, My pull requests and
              Following were five links into five TABS OF ONE PAGE, so this menu was a second copy of the
              WorkBench's own navigation, kept in step by hand. Workbench opens that page and the tabs are
              still there, listed again on its overview. Notifications went because the bell sits two inches to
              the left of this menu and its own panel already carries "See all notifications" and "Choose what
              arrives here", both landing on the same page.
              BROWSE THE CO-OP IS THE ONE REMOVAL THAT COSTS SOMETHING. /browse/ now has no link anywhere on
              the site, so it is reachable only by typing the address. The owner asked for the item to go and
              that is their call; the page itself is untouched and one link from the WorkBench would bring it
              back. Raised with them in the same pass rather than fixed quietly. */}
          <a class="hm-item hm-member" role="menuitem" href="/workbench/" hidden>Workbench</a>
          <a class="hm-item hm-member" role="menuitem" href="/workbench/#tab=saved" hidden>Saved</a>
          {/* The href stays /account/: the page did not move, only what this menu calls it. */}
          <a class="hm-item hm-member" role="menuitem" href="/account/" hidden>Settings</a>
          <a class="hm-item hm-member hm-admin" role="menuitem" href="/admin/" hidden>Admin tools</a>
          <div class="hm-sep" role="separator"></div>
          <button class="hm-item hm-signout" role="menuitem" type="button" data-head-signout>Sign out</button>
        </div>
      </div>
      <button type="button" class="head-burger" data-mobile-toggle aria-label="Open menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <nav class="head-mobile" data-mobile-menu hidden aria-label="Mobile">
    <div class="wrap">
      {/* sow-187 + sow-131 follow-up: mirror the two nav modes on mobile too. Signed-out = the flat feed links +
          any standalone pages + Sign in; signed-in = the flat member list. Swapped by identity (script below). */}
      <div data-mnav-set="out">
        {SIGNED_OUT_NAV.map((i) => <a href={i.href}>{i.label}</a>)}
        {signedOutExtra.map((i) => <a href={i.href}>{i.label}</a>)}
        {/* sow-394: the phone home of the header's Submit content button. Inside the signed-out set, so the
            identity swap above removes it for a signed-in reader. */}
        <a href="/submit-content/" class="m-submit"><svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><use href="#ico-pencil" /></svg> Submit content</a>
        <a href="/login/" class="m-join">Sign in / Join</a>
      </div>
      <div data-mnav-set="in" hidden>
        {SIGNED_IN_NAV.map((i) => <a href={i.href}>{i.label}</a>)}
      </div>
    </div>
  </nav>
</header>

<style>
  /* Mobile menu + burger. The full nav scales to fit down to 650px (gbti-v3.css); the burger + mobile
     menu only take over below 650px. */
  .head-burger { display: none; flex-direction: column; gap: 5px; width: 40px; height: 38px;
    align-items: center; justify-content: center; background: transparent; border: 0; cursor: pointer; }
  .head-burger span { display: block; width: 22px; height: 2px; background: var(--fg-soft); border-radius: 2px; }
  .head-mobile { border-top: 1px solid var(--line); background: var(--paper); }
  .head-mobile .wrap { display: flex; flex-direction: column; padding-top: 10px; padding-bottom: 14px; }
  .head-mobile a { padding: 11px 0; font-weight: 500; color: var(--fg-soft); border-bottom: 1px solid var(--line); }
  .head-mobile a:last-child { border-bottom: 0; }
  .head-mobile .m-join { color: var(--green-700); font-weight: 600; }
  .head-mobile .m-submit { display: flex; align-items: center; gap: 9px; color: var(--fg); font-weight: 600; }
  .head-mobile .m-submit svg { flex: none; }
  /* sow-394: the outlined Submit content button. The same shape as Sign in (square, 1.5px border, the same size
     steps) with the softer line colour, so Sign in stays the stronger of the two. Transparent, so it takes the
     header's own background in either theme. Hidden by default and shown from 920px up (see the markup). */
  .head-submit { display: none; align-items: center; gap: 8px; padding: 10px 16px; border: 1.5px solid var(--line-2);
    border-radius: 0; background: transparent; color: var(--fg); font-family: var(--f-sans); font-weight: 600;
    font-size: 15px; white-space: nowrap; text-decoration: none; transition: border-color .15s ease; }
  .head-submit svg { width: 17px; height: 17px; flex: none; }
  .head-submit:hover, .head-submit:focus-visible { border-color: var(--fg); color: var(--fg); }
  @media (min-width: 920px) { .head-submit { display: inline-flex; } }
  @media (max-width: 1080px) { .head-submit { padding: 9px 13px; font-size: 13.5px; } }
  .head-mobile .m-group { display: block; padding: 11px 0 4px; font-family: var(--f-mono); font-size: 11px;
    letter-spacing: .12em; text-transform: uppercase; color: var(--fg-mute); }
  .head-mobile .m-sub { padding-left: 14px; }
  /* sow-131: the Feeds nav dropdown. Reuses the account menu's panel/item styles (.head-menu/.hm-item,
     below) with a left-anchored panel; the trigger matches the flat .nav link typography. */
  /* sow-187: center the button in its wrapper too, not just the wrapper in the row. Verifying rather than
     assuming (per the SOW) showed align-items on .nav alone left a ~1.5px offset, the inline-flex button sat on
     a line box inside the block wrapper. display:flex here zeroes it. The absolute dropdown menu is unaffected. */
  .nav-drop { position: relative; display: flex; align-items: center; }
  .nav-drop-btn { display: inline-flex; align-items: center; gap: 5px; background: transparent; border: 0;
    padding: 0; cursor: pointer; font: inherit; font-size: 15.5px; font-weight: 500; color: var(--fg-soft);
    transition: color .15s; white-space: nowrap; }
  .nav-drop-btn:hover, .nav-drop-btn[aria-expanded="true"] { color: var(--fg); }
  .nav-drop-caret { color: var(--fg-mute); transition: transform .15s ease; }
  .nav-drop-btn[aria-expanded="true"] .nav-drop-caret { transform: rotate(180deg); }
  .nav-drop-menu { left: 0; right: auto; min-width: 170px; }
  /* sow-187: the two primary-nav sets. Each is a flex row inheriting the .nav gap; one shows at a time. The
     explicit [hidden] override is required, an explicit display beats the UA [hidden]{display:none}. */
  .nav-set { display: flex; align-items: center; gap: inherit; }
  .nav-set[hidden] { display: none; }
  /* Mobile: display:contents so each set's anchors stack as direct children of the flex column. */
  .head-mobile [data-mnav-set] { display: contents; }
  .head-mobile [data-mnav-set][hidden] { display: none; }
  /* SOW-030/036: the signed-in account control (avatar + @login + caret) and its dropdown menu. Hidden until the
     extension signal arrives; when shown it replaces the "Sign in" button (toggled in the script below). */
  .head-me-wrap { position: relative; }
  .head-me-wrap[hidden] { display: none; }
  .head-me { display: inline-flex; align-items: center; gap: 7px; padding: 4px 10px 4px 4px;
    border: 1px solid var(--line-2); border-radius: var(--r-pill); font-weight: 600; font-size: 14px;
    color: var(--fg); background: var(--paper); cursor: pointer; font-family: inherit; }
  .head-me:hover { border-color: var(--green); }
  .head-me-av { width: 26px; height: 26px; border-radius: 50%; background: var(--line); object-fit: cover; }
  .head-me-caret { color: var(--fg-mute); transition: transform .15s ease; }
  .head-me[aria-expanded="true"] .head-me-caret { transform: rotate(180deg); }
  /* The dropdown panel. Token-driven so it works in both themes. */
  .head-menu { position: absolute; top: calc(100% + 8px); right: 0; min-width: 210px; z-index: 60;
    background: var(--paper); border: 1px solid var(--line-2); border-radius: var(--r-lg);
    box-shadow: 0 12px 30px -12px rgba(0,0,0,.32); padding: 6px; display: flex; flex-direction: column; }
  .head-menu[hidden] { display: none; }
  .hm-item { display: block; width: 100%; text-align: left; padding: 8px 12px; border: 0; border-radius: var(--r);
    background: transparent; color: var(--fg); font: inherit; font-size: 14px; font-weight: 500; cursor: pointer;
    text-decoration: none; }
  .hm-item:hover, .hm-item:focus-visible { background: var(--green-tint); color: var(--green-700); outline: none; }
  .hm-signout { color: var(--fg-soft); }
  .hm-sep { height: 1px; background: var(--line); margin: 5px 4px; }
  @media (max-width: 650px) {
    .head-cta .btn-gh { display: none; }
    .head-me-name { display: none; }
    .head-burger { display: flex; }
  }
  @media (min-width: 651px) { .head-mobile { display: none; } }
</style>

<script>
  import { readMemberSignal, onMemberSignal, currentIdentity, signOutWeb } from '../lib/member-signal';
import { isGithubLogin } from '../lib/github-login.mjs'; // sow-369: the hint is a LOGIN, and only a login

  // SOW-030/036: reflect the extension's signed-in signal into the header. When a member signal is present we show
  // the avatar account menu and hide the "Sign in" button; otherwise the header stays in its logged-out state.
  // Presentation only (the signal is untrusted; authoritative checks stay server-side). The menu's management
  // items deep-link into the extension's pages via the content-script relay (gbti:open); the site cannot link to
  // chrome-extension:// directly. Avatars come from GitHub by login, with a brand fallback on error.
  const RANK = { member: 0, moderator: 1, admin: 2, superadmin: 3 };
  const signin = document.querySelector('[data-signin]');
  const submitCta = document.querySelector<HTMLElement>('[data-submit-cta]'); // sow-394: leaves with Sign in
  const wrap = document.querySelector('[data-head-me-wrap]');
  const me = document.querySelector('[data-head-me]');
  const meAv = document.querySelector('[data-head-me-av]');
  const meName = document.querySelector('[data-head-me-name]');
  const meProfile = document.querySelector('[data-head-me-profile]');
  const headMenu = document.querySelector('[data-head-menu]');
  const adminItem = document.querySelector('.hm-admin');
  // sow-187: the two primary-nav sets (desktop + mobile). Swap them on the same identity resolution as the
  // account menu: a resolved/hint login shows the flat member nav, otherwise the Feeds-dropdown nav. Both are
  // in the static HTML (public hrefs only), so this is presentation, and the default is signed-out.
  const navSets = document.querySelectorAll('[data-nav-set]');
  const mnavSets = document.querySelectorAll('[data-mnav-set]');
  function setNav(signedIn) {
    const want = signedIn ? 'in' : 'out';
    navSets.forEach((el) => { (el as HTMLElement).hidden = el.getAttribute('data-nav-set') !== want; });
    mnavSets.forEach((el) => { (el as HTMLElement).hidden = el.getAttribute('data-mnav-set') !== want; });
  }

  function closeMenu() {
    if (!headMenu || !me) return;
    headMenu.hidden = true;
    me.setAttribute('aria-expanded', 'false');
  }
  function openMenu() {
    if (!headMenu || !me) return;
    headMenu.hidden = false;
    me.setAttribute('aria-expanded', 'true');
    // Focus the first item for keyboard users.
    headMenu.querySelector('.hm-item')?.focus();
  }

  // SOW: a DISPLAY-ONLY signed-in hint for the window between trial signup and installing the extension. The signup
  // redirect carries ?u=<github_login> (the PUBLIC login, NOT auth); we stash it in localStorage and show the avatar
  // so the header reflects "signed in". The real extension signal (once installed) always overrides the hint.
  // sow-369: `u` is a GITHUB LOGIN and nothing else. It was taken verbatim, stored forever and printed as the
  // handle, so a link carrying `?u=<a video url>` put that url in the header (owner, 2026-09-19) and a link
  // carrying `?u=<someone-else>` printed their name and avatar to whoever opened it. Anything that is not
  // login-shaped is ignored, and a stored value that is not login-shaped is DELETED on the way past, so a
  // browser already carrying one heals itself on the next page it loads.
  function readHint() {
    let login = null;
    try {
      const u = new URLSearchParams(location.search).get('u');
      if (u && isGithubLogin(u)) { localStorage.setItem('gbti_hello', u); login = u; }
      else if (!u) {
        const stored = localStorage.getItem('gbti_hello');
        if (stored && isGithubLogin(stored)) login = stored;
        else if (stored) localStorage.removeItem('gbti_hello');
      }
    } catch { /* no storage */ }
    return login ? { login, hintOnly: true } : null;
  }
  // sow-158: two menu modes now. 'hint' = signed up via the signup redirect but no resolved session yet (the
  // display-only ?u= hint) -> nudge the download, no member actions. 'member' = a resolved cookie OR extension
  // signal -> the SITE-native member menu (WorkBench tabs, feeds, account, admin-if-staff). The web/extension split
  // is gone: the site items work regardless of the extension (they need the cookie session, which web sign-in sets).
  function menuModeFor(eff) {
    return (eff && eff.hintOnly) ? 'hint' : 'member';
  }
  function setMenuMode(mode) {
    const dl = headMenu?.querySelector('.hm-download');
    const signout = headMenu?.querySelector('[data-head-signout]');
    if (dl) dl.hidden = mode !== 'hint';
    headMenu?.querySelectorAll('.hm-member').forEach((el) => { el.hidden = mode !== 'member'; });
    if (signout) signout.hidden = mode === 'hint'; // a member shows Sign out; the display-only hint does not
  }
  function applyHeaderIdentity(s) {
    if (!wrap || !signin) return;
    const eff = (s && s.login) ? s : readHint(); // the extension signal wins; else the display-only signup hint
    const login = eff && eff.login;
    setNav(!!login); // sow-187: signed-in flat nav vs the Feeds-dropdown nav
    if (login) {
      const folder = eff.username || login;
      if (meName) meName.textContent = '@' + login;
      if (meAv) { meAv.src = 'https://github.com/' + encodeURIComponent(login) + '.png?size=52'; meAv.alt = '@' + login; }
      if (meProfile) meProfile.href = '/members/' + encodeURIComponent(folder) + '/';
      setMenuMode(menuModeFor(eff)); // reveals the .hm-member items in member mode...
      if (adminItem) adminItem.hidden = (RANK[eff.role] ?? 0) < RANK.moderator; // ...then the role gate hides Admin for non-staff (must run AFTER setMenuMode)
      wrap.hidden = false;
      signin.style.display = 'none';
      if (submitCta) submitCta.style.display = 'none';
    } else {
      closeMenu();
      wrap.hidden = true;
      signin.style.display = '';
      if (submitCta) submitCta.style.display = ''; // back to the stylesheet, which shows it from 920px up
    }
  }
  meAv?.addEventListener('error', () => { if (meAv) meAv.src = '/favicon-32x32.png'; });
  applyHeaderIdentity(currentIdentity(readMemberSignal()));
  onMemberSignal(applyHeaderIdentity);

  // SOW-186 C2: upgrade the notification bell for a signed-in WEBSITE member (a real cookie session). The bell
  // computes "members I follow published X" on read (getFollows() intersected with the public activity index),
  // so it needs the cookie session to authenticate getFollows. An extension-only or display-only-hint signal has
  // no gbti_csrf cookie, so the inert bell stays hidden for them. Mirrors SubscribeButton.astro's upgrade.
  function readCookie(name: string): string | null {
    for (const part of document.cookie.split(';')) {
      const eq = part.indexOf('=');
      if (eq >= 0 && part.slice(0, eq).trim() === name) return part.slice(eq + 1).trim() || null;
    }
    return null;
  }
  let bellUpgraded = false;
  async function upgradeBell(signal: any) {
    if (bellUpgraded || !signal || !signal.login || !readCookie('gbti_csrf')) return;
    bellUpgraded = true;
    const signupBase = document.documentElement.dataset.signupBase || '';
    const { createWorkbenchClient } = await import('../lib/workbench-client');
    const { setClient, getClient } = await import('../../client-ui/src/base.mjs');
    // sow-334: never REPLACE a client the page already set. The header runs on every page, and /admin/ sets a
    // richer one (isSuperadmin attaches the Channels methods). Whichever setClient landed last won, so in 19 of 30
    // runs of the built admin page the header's replaced it and the Channels manager lost its methods. The bell
    // needs only the shared methods, which every page's client carries.
    if (!getClient()) setClient(createWorkbenchClient({ signupBase, login: String(signal.login), githubId: signal.githubId != null ? String(signal.githubId) : null }));
    await import('../../client-ui/src/elements/gbti-notification-bell.mjs');
  }
  upgradeBell(currentIdentity(readMemberSignal()));
  onMemberSignal(upgradeBell);

  // Toggle the dropdown; close on Esc, on outside-click, and after choosing an item.
  me?.addEventListener('click', (e) => {
    e.stopPropagation();
    headMenu?.hidden ? openMenu() : closeMenu();
  });
  document.addEventListener('click', (e) => { if (!headMenu?.hidden && !wrap?.contains(e.target)) closeMenu(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !headMenu?.hidden) { closeMenu(); me?.focus(); } });

  // sow-158: the menu items are now plain SITE links (no extension relay). Close the dropdown when one is chosen so a
  // same-page hash link (e.g. /workbench/#tab=post from /workbench) does not leave the menu open.
  headMenu?.querySelectorAll('.hm-item').forEach((b) => b.addEventListener('click', () => { if (b.getAttribute('data-head-signout') === null) closeMenu(); }));
  // sow-158 Phase 2: sign out of BOTH sessions -- dispatch the extension signout (clears its token if installed)
  // AND clear the httpOnly cookie session via the Worker (no-op when there is no web session), then reload so the
  // page re-hydrates signed-out. Both are idempotent/harmless when the respective session is absent.
  document.querySelector('[data-head-signout]')?.addEventListener('click', async () => {
    closeMenu();
    document.dispatchEvent(new CustomEvent('gbti:request-signout'));
    await signOutWeb();
    location.reload();
  });

  // Light/dark toggle: flip data-theme on <html>, persist to localStorage. The no-FOUC initial theme is
  // set in BaseLayout's <head> before paint; this only handles the click + persistence.
  const root = document.documentElement;
  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
    const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    try { localStorage.setItem('gbti-theme', next); } catch {}
  });

  // Mobile menu.
  const burger = document.querySelector('[data-mobile-toggle]');
  const menu = document.querySelector('[data-mobile-menu]');
  burger?.addEventListener('click', () => {
    const open = menu?.toggleAttribute('hidden');
    burger.setAttribute('aria-expanded', String(open === false));
  });

  // sow-131: generic nav dropdown wiring (the Feeds menu): toggle, outside-click, Esc, focus-first.
  // The account menu above keeps its own wiring (it is entangled with the identity signal).
  document.querySelectorAll('[data-dropdown]').forEach((dd) => {
    const btn = dd.querySelector<HTMLButtonElement>('[data-dropdown-btn]');
    const panel = dd.querySelector<HTMLElement>('[data-dropdown-menu]');
    if (!btn || !panel) return;
    const close = () => { panel.hidden = true; btn.setAttribute('aria-expanded', 'false'); };
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      if (panel.hidden) {
        panel.hidden = false;
        btn.setAttribute('aria-expanded', 'true');
        panel.querySelector<HTMLElement>('.hm-item')?.focus();
      } else {
        close();
      }
    });
    document.addEventListener('click', (e) => { if (!panel.hidden && !dd.contains(e.target as Node)) close(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !panel.hidden) { close(); btn.focus(); } });
  });
</script>
