---
import { authorDisplay } from '../lib/authors';
import { refCodeForAuthor, REF_COOKIE, REF_VIA_COOKIE, REF_COOKIE_DAYS } from '../lib/referral';
import { offeredTiers, benefitProse, revenueFragments } from '../lib/tiers';

interface Props {
  /** Content author username. Resolved to the author's immutable github_id referral code. */
  author: string;
  /** Where the invite is shown, recorded for attribution, e.g. "post:my-slug". */
  via?: string;
}
const { author, via } = Astro.props;
const display = authorDisplay(author);

// Join CTA carries the author's ref CODE (their immutable github_id) so a converting reader credits this
// content's author. refCode is undefined for house content and unknown authors, so the CTA omits ?ref.
const refCode = refCodeForAuthor(author);
const params = new URLSearchParams();
if (refCode) params.set('ref', refCode);
if (via) params.set('via', via);
const query = params.toString();
const joinHref = query ? `/membership/?${query}` : '/membership/';

// Tier copy is BOUND to the registry (house/membership-tiers.yml via src/lib/tiers.ts) so this CTA can never
// advertise a benefit a tier does not carry: benefitProse renders a tier's benefit labels as one clause, and
// the prices come from the same record. This is the same governance the membership page follows, and
// test/community-invite-parity.test.mjs asserts the invite never hand-writes a benefit label.
// sow-323: ONE row now. The owner collapsed the two paid plans on 2026-09-12, so a second row would advertise
// a plan nobody can buy, on a component that is mounted on EVERY article. The row is built from offeredTiers so
// it follows the registry rather than naming a key: if a tier stops being offered, its row stops rendering, and
// if another is added its row appears, with no edit here. The revenue line goes through revenueFragments for
// the same reason the cards do, since the registry value carries an inline markdown link.
const tierRows = offeredTiers()
  .filter((t) => t.priceAnnual > 0 || t.priceMonthly > 0)
  .map((t) => {
    const frag = revenueFragments(t.revenue);
    const link = frag.find((f) => f.href);
    return {
      label: t.label,
      priceLabel: `$${t.priceAnnual}/year`,
      lead: '',
      prose: benefitProse(t),
      // The text before the link, so the markup can render the link itself as an anchor.
      revenue: frag.filter((f) => !f.href).map((f) => f.text).join('').trim().replace(/\.$/, ''),
      revenueHref: link?.href ?? null,
    };
  }) as {
  label: string;
  priceLabel: string;
  lead: string;
  prose: string;
  revenue: string;
  revenueHref: string | null;
}[];
const isMemberAuthored = author !== 'gbti';
---
<section class="dark community-invite" style="max-width:820px;margin:48px auto 0;border-radius:var(--r-lg);overflow:hidden;padding:40px">
  <div class="chip" style="display:inline-flex"><span class="chip-dot"></span> A creator network, powered by Git</div>
  <h2 class="h2 mt16" style="color:#fff">Join the GBTI Network</h2>
  <p class="lead mt12">
    The GBTI Network is a creator community. Browse, follow, and save across the network for free, no card
    required. Join a paid tier to take part and share in the revenue.
  </p>
  <div class="flex col g14 mt24">
    {tierRows.map((t) => (
      <div class="flex g12">
        <svg viewBox="0 0 24 24" width="20" height="20" style="color:var(--green-mint);flex:none;margin-top:3px"><use href="#ico-check"/></svg>
        <span style="color:#fff;line-height:1.5">
          <strong>{t.label}</strong> ({t.priceLabel}): {t.lead}{t.prose}.
          {t.revenueHref
            ? <> {t.revenue}{' '}<a href={t.revenueHref} style="color:var(--green-mint);text-decoration:underline">revenue program</a>.</>
            : <> {t.revenue}</>}
        </span>
      </div>
    ))}
  </div>
  <div class="flex wrap-w items-center g20 mt28">
    <a href={joinHref} class="btn btn-primary">Become a member <svg class="ar" viewBox="0 0 24 24" width="18" height="18"><use href="#ico-arrow"/></svg></a>
    {isMemberAuthored && (
      <span class="body-sm" style="color:var(--on-dark-mute)">You are reading {display}'s work. Joining from this page credits {display}.</span>
    )}
  </div>
</section>
<style is:global>
  /* SOW-050: the Join CTA is irrelevant to an ACTIVE member (paid or trial). member-signal.ts toggles
     html.is-gbti-member-active when the extension reports a paid/trial membership; hide the invite for them.
     Presentation-only (the signal is untrusted by design; the CTA is cosmetic). Visitors + lapsed accounts,
     for whom joining/renewing matters, still see it. */
  html.is-gbti-member-active .community-invite { display: none; }
</style>
{refCode && (
  <script
    define:vars={{ refCode, via: via ?? '', cookie: REF_COOKIE, viaCookie: REF_VIA_COOKIE, days: REF_COOKIE_DAYS }}
  >
    // First-touch referral: set the cookie ONLY if it is not already present, so the FIRST member whose
    // content a visitor lands on wins the attribution across the rest of their visit. Self-referral is
    // rejected server-side at signup (the Worker drops a ref equal to the new member's own github_id),
    // so we do not need to know who is viewing here.
    (function () {
      try {
        var has = document.cookie.split('; ').some(function (c) { return c.indexOf(cookie + '=') === 0; });
        if (has) return;
        var maxAge = 60 * 60 * 24 * days;
        document.cookie = cookie + '=' + encodeURIComponent(refCode) + '; path=/; max-age=' + maxAge + '; SameSite=Lax';
        if (via) {
          document.cookie = viaCookie + '=' + encodeURIComponent(via) + '; path=/; max-age=' + maxAge + '; SameSite=Lax';
        }
      } catch (e) { /* cookies disabled: attribution simply does not persist, no error surfaced */ }
    })();
  </script>
)}
