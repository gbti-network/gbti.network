---
// A single member avatar. The member's BLOBATAR (sow-428: a small creature drawn from their GBTI name, the same one
// on every surface) is ALWAYS rendered as the base; the profile image is layered on top and removed if it fails to
// load, so the creature shows through. It replaced the letter disc (owner, 2026-09-30: "We can use blobatar library
// for anyone who does not have a linked avatar"). Member avatars are external (Gravatar/GitHub) URLs, so this uses a
// plain <img> (not astro:assets). For Gravatar we force the default to `404` (instead of the generic "mystery person"
// silhouette) so a member with no real avatar yields a failed image and the blobatar shows instead.
import { blobSrc } from '../lib/blob-seeds.mjs'; // one shared file per known member, else an inline data URL

interface Props {
  /** `seed` is the member's folder (GBTI name). Without it the blobatar is drawn from the display name. */
  item: { name: string; avatar?: string; seed?: string };
  class?: string;
  size?: number;
  /** Optional native hover tooltip (e.g. the member's display name). */
  title?: string;
}
const { item, class: cls = '', size, title } = Astro.props;
const name = (item?.name || '?').trim();
const blob = blobSrc(item?.seed || name);

// Force Gravatar (and any avatar URL carrying a `d=` default) to 404 when there is no real image, so
// the blobatar underneath shows through. Other absolute image URLs (e.g. GitHub) are left untouched.
function withFallback404(url?: string): string | undefined {
  if (!url) return undefined;
  try {
    const u = new URL(url);
    if (/(^|\.)gravatar\.com$/i.test(u.hostname) || u.searchParams.has('d')) u.searchParams.set('d', '404');
    return u.toString();
  } catch {
    return url;
  }
}
const src = withFallback404(item?.avatar);
// flex-shrink:0 with the size (owner report, 2026-09-13): a sized avatar placed in a flex row beside text that wraps
// gave up WIDTH to the text while keeping its height, so the circle rendered as a tall oval (52px measured at 43x52
// in the share page's sidebar author card, beside a two-line headline). A fixed size is never negotiable.
const dim = size ? `width:${size}px;height:${size}px;flex-shrink:0;` : '';
const layer = 'position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block;border:0';
---
<span
  class:list={[cls]}
  title={title}
  style={`position:relative;display:inline-flex;overflow:hidden;background:var(--tint);${dim}`}
>
  <img src={blob} alt="" aria-hidden="true" data-blob style={layer} />
  {src && (
    <img
      src={src}
      alt=""
      loading="lazy"
      decoding="async"
      onerror="this.remove()"
      style={layer}
    />
  )}
</span>
