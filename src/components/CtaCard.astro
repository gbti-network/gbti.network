---
// sow-281: the per-item partner CTA. A superadmin registers a CTA in house/ctas.yml and assigns it to items there;
// this card renders the ENABLED CTA assigned to the item it is mounted on, and nothing at all otherwise (no CTA,
// a disabled CTA, or an assignment the registry carries for some other item). It is its own sidebar card, above
// the weekly-digest card, and its button is never the page's primary button: on a prompt, Copy stays the one
// primary action. The link is DIRECT (the destination as registered, the Amazon rule in house/ctas.yml), opens in
// a new tab, and carries rel="sponsored nofollow noopener" because it is a paid placement.
//
// `wrap` is the chrome the mounting page wants (each rail has its own: the prompt aside uses .card, the project
// rail .pd-block, the share aside .card.side-card, the article rail a bare div), because an empty wrapper on a
// page with no CTA would be a visible blank card.
//
// sow-337: the card's markup and stylesheet come from membership/cta-card-render.mjs, the same drawing the
// superadmin preview uses, so a card cannot look one way in the admin and another on the page. This component only
// picks the chrome. A boxed chrome (.card) tells an Image first card how far to reach so its image meets the card's
// edges, and an Image only card fills the box with no padding; any other chrome gets the card's own border. The
// classes are prefixed pcta- because the site stylesheet already has a marketing .cta-card with 56px padding.
import { readCtas, ctaImageInfo } from '../../scripts/lib/ctas-store.mjs';
import { ctaFor, ctaImageUrl, trackedHrefFor } from '../lib/ctas.mjs';
import { outboundLinkSummaries } from '../../scripts/lib/outbound-links-store.mjs'; // sow-359: the tracked links this build knows about
import { renderCtaCard, ctaLayoutOf, layoutUses, CTA_CARD_CSS } from '../../membership/cta-card-render.mjs';

interface Props { type: 'prompt' | 'post' | 'project' | 'share'; ref: string; wrap?: string; pad?: boolean }
const { type, ref, wrap = 'card', pad = false } = Astro.props;
const root = process.cwd();
const cta = ctaFor(readCtas(root), type, ref);

let html = '';
let style: string | undefined;
let classes: string[] = [];
let layout = 'text';
if (cta) {
  layout = ctaLayoutOf(cta);
  let image = null;
  if (layoutUses(layout).image && typeof cta.image === 'string') {
    const info = ctaImageInfo(root, cta.image);
    if (!info.ok) throw new Error(`CTA "${cta.id}" image ${cta.image}: ${info.problem}`);
    image = { url: ctaImageUrl(cta.image), width: info.width, height: info.height };
  }
  // sow-359: a card may name a tracked /outbound/ path. It is honoured only when THIS build's store carries
  // it live, so the deploy that starts using a path is the same deploy that emits its redirect, and a card
  // can never render a masked link that does not resolve.
  const href = trackedHrefFor(cta, outboundLinkSummaries(root));
  html = renderCtaCard(cta, { image, href });
  const chrome = String(wrap || '').split(/\s+/).filter(Boolean);
  const boxed = chrome.includes('card');
  const sideCard = chrome.includes('side-card');
  classes = ['pcta', ...chrome, boxed ? '' : 'pcta-boxless', `pcta-l-${layout}`].filter(Boolean);
  if (boxed && layout === 'image') style = 'padding:0;overflow:hidden';
  else if (boxed && (pad || sideCard)) {
    style = `${pad ? 'padding:22px;' : ''}--pcta-pad:22px;--pcta-top-radius:calc(var(--r-lg, 12px) - 1.5px) calc(var(--r-lg, 12px) - 1.5px) 0 0`;
  }
}
---
{cta && (
  <div class:list={classes} style={style} data-cta={cta.id} data-cta-partner={cta.partner} data-cta-layout={layout}>
    <style is:inline set:html={CTA_CARD_CSS}></style>
    <Fragment set:html={html} />
  </div>
)}
