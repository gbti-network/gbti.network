---
// sow-166 / sow-202: the PUBLIC digest capture component. The weekly-digest engine had a live subscribe
// route (`POST /mail/subscribe`) and no front door: nothing in the site, client-ui or the extension pointed
// at it, so the compile would enqueue 0 recipients forever. This is that front door.
//
// THE COPY FOLLOWS THE WORKER'S MODE, NOT A FIXED PROMISE (sow-202). The route runs double opt-in by default
// (a PENDING record and a confirmation email, nobody enrolled until the link is clicked), but production turned
// it off on 2026-08-26, and sow-270 made off the shipped default (`optin.double` in house/digest-config.yml:
// the address is active at submit and no confirmation email is
// sent). The small print therefore promises neither, and the success message reads the JSON `direct` flag
// through src/lib/digest-subscribe-copy.mjs. Never state one mode's outcome in static copy: the old small print
// promised a confirmation email to every visitor for over two weeks after production stopped sending one.
//
// SIGNED-IN MEMBERS GET A LINK TO THEIR DIGEST SWITCH INSTEAD OF THE FORM (sow-202, owner 2026-09-13, superseding
// the same-day "form plus a link" decision). The switch on /account/notifications/ turns the digest on or off for
// the account's own address, so asking a signed-in member to type an email is asking for one we already have. The
// swap is CSS on html.is-gbti-member, so it needs no script and no Worker call here; the switch page does the rest.
//
// WORKS WITH NO JAVASCRIPT, on purpose. The Worker content-negotiates: a plain form navigation gets a real
// HTML page back, a fetch with `Accept: application/json` gets JSON. Turnstile is loaded with IMPLICIT
// rendering, so it injects its own `cf-turnstile-response` input into this form without any script of ours.
// The enhancement script below only upgrades the experience: it posts by fetch and reports inline instead of
// navigating away.
//
// SAFE FOR MULTIPLE INSTANCES PER PAGE (sow-166 revision). The Turnstile api.js tag below is emitted per
// render, but the inline loader guards on a window flag so api.js is appended to the document only once, no
// matter how many times this component renders. Content detail pages now carry two instances (a sidebar
// `rail` plus the kept under-content `inline`), and the enhancement script already iterates every instance
// and reads each form's own token, so both work. Do not go back to a bare `<script src>` tag: two of those
// execute the implicit-render scan twice and Turnstile warns about re-rendering an existing widget.
//
// sow-388: THE FULL-SCREEN INVITATION EMBEDS THIS COMPONENT RATHER THAN A COPY OF IT (variant `invite`, rendered
// only by DigestInvite.astro, which is on every page). Two things follow. Its bot check is ON DEMAND: the widget
// carries no `cf-turnstile` class until the invitation opens and dispatches `gbti:load-turnstile`, so the
// implicit-render scan skips it and a page with no other box never fetches api.js for a dialog most readers never
// see. And a successful subscribe from ANY box dispatches `gbti:digest-subscribed` on document, which is how the
// invitation learns it worked and stops asking on that browser.
import { TURNSTILE_SITE_KEY, SIGNUP_BASE } from '../../lib/membership';
import { SUBSCRIBE_HEADING, SUBSCRIBE_BLURB } from '../../lib/digest-subscribe-copy.mjs'; // sow-383: shared with the web edition

interface Props {
  /** `band` is the standalone homepage block; `inline` sits inside a content page's closing column;
   *  `rail` is the chromeless single-column form the homepage sidebar wraps in a `.card.side-card`. */
  variant?: 'band' | 'inline' | 'rail' | 'invite';
  heading?: string;
  blurb?: string;
  /** Run Turnstile interaction-only, so the widget stays invisible for a normal visitor while still
   *  producing and verifying a token. `rail` is always quiet; this opts the other variants in too. */
  quietTurnstile?: boolean;
  /** sow-388: one extra sentence at the start of the small print (the invitation says which morning it arrives). */
  note?: string;
  /** sow-388: render the bot check only when `gbti:load-turnstile` is dispatched (see the header comment). */
  turnstileOnDemand?: boolean;
}
const { variant = 'inline', heading, blurb, quietTurnstile = false, note, turnstileOnDemand = false } = Astro.props;
// The rail and the invitation are quiet by design; the flag opts inline/band into the same invisible-badge behavior.
const quiet = quietTurnstile || variant === 'rail' || variant === 'invite';

const title = heading ?? SUBSCRIBE_HEADING;
const sub = blurb ?? SUBSCRIBE_BLURB;
---

<section class:list={['dsub', `dsub-${variant}`]} data-digest-subscribe data-quiet-ts={quiet ? '' : undefined} aria-labelledby={`dsub-h-${variant}`}>
  <div class="dsub-in">
    <div class="dsub-copy">
      <h2 class="dsub-h" id={`dsub-h-${variant}`}>{title}</h2>
      <p class="dsub-sub">{sub}</p>
    </div>

    <form class="dsub-form" method="post" action={`${SIGNUP_BASE}/mail/subscribe`} data-dsub-form novalidate>
      <div class="dsub-row">
        <label class="dsub-lab" for={`dsub-email-${variant}`}>Email address</label>
        <input
          class="dsub-input"
          id={`dsub-email-${variant}`}
          type="email"
          name="email"
          required
          autocomplete="email"
          spellcheck="false"
          placeholder="you@example.com"
          data-dsub-email
        />
        <button class="btn btn-primary dsub-btn" type="submit" data-dsub-go>{variant === 'rail' ? 'Get the digest' : 'Subscribe'}</button>
      </div>

      <div class:list={[{ 'cf-turnstile': !turnstileOnDemand }, 'dsub-ts']} data-ts-on-demand={turnstileOnDemand ? '' : undefined} data-sitekey={TURNSTILE_SITE_KEY} data-theme="auto" data-size="flexible" data-appearance={quiet ? 'interaction-only' : undefined}></div>

      <p class="dsub-fine">
        {note ? `${note} ` : ''}Unsubscribe in one click from any issue. Read the <a href="/privacy/">privacy policy</a>.
      </p>
      <p class="dsub-msg" data-dsub-msg role="status" aria-live="polite" hidden></p>
    </form>

    <p class="dsub-member" data-dsub-member>You are signed in. <a href="/account/notifications/">Edit Notification Settings</a></p>
  </div>
</section>

{turnstileOnDemand ? (
  <script is:inline>
    // sow-388: the on-demand bot check. Nothing loads until something dispatches `gbti:load-turnstile` (the
    // invitation does, as it opens). Then each deferred widget gets the `cf-turnstile` class: if api.js is still to
    // come, its implicit-render scan finds it; if api.js already ran its scan (another box on the page loaded it),
    // the widget is rendered explicitly with its own data attributes. Registered once per document.
    if (!window.__gbtiTurnstileOnDemand) {
      window.__gbtiTurnstileOnDemand = true;
      document.addEventListener('gbti:load-turnstile', function () {
        document.querySelectorAll('[data-ts-on-demand]').forEach(function (el) {
          if (el.classList.contains('cf-turnstile')) return;
          el.classList.add('cf-turnstile');
          if (window.turnstile && typeof window.turnstile.render === 'function') {
            var opts = { sitekey: el.getAttribute('data-sitekey') };
            ['theme', 'size', 'appearance'].forEach(function (k) {
              var v = el.getAttribute('data-' + k);
              if (v) opts[k] = v;
            });
            try { window.turnstile.render(el, opts); } catch (e) { /* the submit handler reports a missing token */ }
          }
        });
        if (!window.__gbtiTurnstileLoading) {
          window.__gbtiTurnstileLoading = true;
          var s = document.createElement('script');
          s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js';
          s.async = true;
          s.defer = true;
          document.head.appendChild(s);
        }
      });
    }
  </script>
) : (
  <script is:inline>
    // Load Turnstile's api.js exactly once per document. This block is emitted per component instance, but the
    // window flag makes the actual append happen once, so two DigestSubscribe instances on one page (a content
    // page's sidebar rail + its under-content inline) do not load api.js twice and do not re-run the
    // implicit-render scan over an already-rendered widget.
    if (!window.__gbtiTurnstileLoading) {
      window.__gbtiTurnstileLoading = true;
      var s = document.createElement('script');
      s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js';
      s.async = true;
      s.defer = true;
      document.head.appendChild(s);
    }
  </script>
)}

<script>
  import { subscribeSuccessMessage } from '../../lib/digest-subscribe-copy.mjs';

  // Progressive enhancement only. Everything here is optional: with scripting off, the form is a plain POST
  // and the Worker answers with a real HTML page. Querying ALL instances rather than one, because Astro
  // bundles this script once per page no matter how many times the component renders.
  document.querySelectorAll('[data-digest-subscribe]').forEach((root) => {
    const form = root.querySelector('[data-dsub-form]');
    const email = root.querySelector('[data-dsub-email]');
    const btn = root.querySelector('[data-dsub-go]');
    const msg = root.querySelector('[data-dsub-msg]');
    if (!form || !email || !btn || !msg) return;

    const say = (text, kind) => {
      msg.textContent = text;
      msg.dataset.kind = kind;
      msg.hidden = false;
    };

    // sow-266: ONE SEND PER FORM. Disabling every control after a success is not the same property: a submit
    // can also arrive from Enter in a field or from a dispatched event, which is how a second request was
    // measured going out through a fully disabled form on the built homepage.
    let done = false;

    form.addEventListener('submit', async (ev) => {
      // Let the plain navigation happen if fetch is unavailable for any reason.
      if (typeof window.fetch !== 'function') return;
      ev.preventDefault();
      if (done) return;

      const addr = String(email.value || '').trim();
      // A deliberately loose shape check. The Worker is the authority and re-validates; this only spares a
      // round trip on an obvious typo.
      if (!addr || !/^[^@\s]+@[^@\s.]+\.[^@\s]+$/.test(addr)) {
        say('Please enter a valid email address.', 'err');
        email.focus();
        return;
      }

      // Turnstile injects this input into the form itself under implicit rendering.
      const tokenInput = form.querySelector('input[name="cf-turnstile-response"]');
      const token = tokenInput ? String(tokenInput.value || '') : '';
      if (!token) {
        say('Human verification has not finished loading. Wait a moment and try again, or allow challenges.cloudflare.com if you use a content blocker.', 'err');
        return;
      }

      btn.disabled = true;
      const label = btn.textContent;
      btn.textContent = 'Sending...';
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ email: addr, turnstileToken: token }),
        });
        let body = null;
        try { body = await res.json(); } catch { /* a non-JSON body is handled as a failure below */ }

        if (res.ok && body && body.ok) {
          // The Worker answers identically whether or not this address was already known (anti-enumeration),
          // so this copy must not claim a NEW subscription was created.
          done = true;
          form.querySelectorAll('input, button').forEach((el) => { el.disabled = true; });
          say(subscribeSuccessMessage(body), 'ok');
          // sow-388: tell the page. The invitation swaps to its confirmation on this, and stops asking on this
          // browser however the reader subscribed (any box on the page counts).
          document.dispatchEvent(new CustomEvent('gbti:digest-subscribed', {
            detail: { direct: body.direct === true, message: subscribeSuccessMessage(body) },
          }));
          return;
        }

        const code = body && body.error ? String(body.error) : '';
        say(
          code === 'rate_limited' ? 'Too many requests from here. Please try again in a few minutes.'
            : code === 'invalid_email' ? 'That does not look like a valid email address.'
              : code === 'challenge_failed' ? 'We could not verify that request. Please refresh the page and try again.'
                : 'Something went wrong. Please try again in a moment.',
          'err',
        );
      } catch {
        say('We could not reach the network. Please check your connection and try again.', 'err');
      } finally {
        if (!done) { btn.disabled = false; btn.textContent = label; }
        // Turnstile tokens are single use, so a retry needs a fresh one. Scope the reset to THIS form's own
        // widget (a page may carry two), so a failed submit on one does not reset the other's token.
        const tsEl = form.querySelector('.cf-turnstile');
        if (window.turnstile && typeof window.turnstile.reset === 'function' && tsEl) {
          try { window.turnstile.reset(tsEl); } catch { /* a reset failure must not break the form */ }
        }
      }
    });
  });
</script>

<style>
  .dsub { --dsub-pad: 22px; }
  .dsub-in { display: grid; gap: 16px; }

  /* The standalone homepage block. */
  .dsub-band {
    border: 1px solid var(--line);
    background: var(--paper);
    border-radius: var(--r-lg);
    padding: var(--dsub-pad);
    margin: 0 0 18px;
  }

  /* Inside a content page's closing column, ABOVE the discussion (owner request, 2026-08-28). It wears the
     same card chrome as FollowNetwork.astro so the two closing blocks read as one family. The card is
     THEME-AWARE rather than literally white: both --paper (#ffffff -> #2d2a34) and --line-2 flip under
     [data-theme="dark"], so this needs no dark-mode rule of its own. */
  .dsub-inline {
    max-width: 820px;
    margin: 40px auto 0;
    padding: 28px 32px;
    border: 1px solid var(--line-2);
    border-radius: var(--r-lg);
    background: var(--paper);
  }
  @media (max-width: 520px) { .dsub-inline { padding: 22px 18px; } }

  /* Homepage sidebar rail: the wrapper (a .card.side-card) supplies the chrome and the signed-out gate, so
     the section itself is chromeless here. Stack the field above a full-width button for the ~256px column. */
  .dsub-rail { --dsub-pad: 0; }
  .dsub-rail .dsub-in { gap: 12px; }
  .dsub-rail .dsub-row { flex-direction: column; align-items: stretch; gap: 9px; min-width: 0; }
  .dsub-rail .dsub-input { flex: 1 1 auto; width: 100%; min-width: 0; }
  /* The project and prompt sidebars mount this rail in a ~150px column, narrower than the ~256px homepage
     card it was first designed for. Keep every child from imposing a wider min-content than the column: the
     grids size to the column rather than to their widest child, and the email input does not fall back to its
     intrinsic (~208px) size. Without this the rail overflowed the document at 768px (sow-166 follow-up). */
  .dsub-rail .dsub-in, .dsub-rail .dsub-form { grid-template-columns: minmax(0, 1fr); }
  /* sow-192 CTA match: the rail button is the design's theme-aware outline (foreground text + a subtle
     border, no green fill), not the band/inline solid green. Reads correctly in light and dark from the
     tokens alone. */
  .dsub-rail .dsub-btn { width: 100%; background: transparent; color: var(--fg); border-color: var(--line-2); box-shadow: none; }
  .dsub-rail .dsub-btn:hover { background: var(--tint); border-color: var(--fg-mute); transform: none; }
  /* Turnstile runs interaction-only in the rail (invisible for the normal visitor), so collapse its space.
     The flexible widget still reserves a ~200px-wide box; clamp and clip it to the column so it cannot widen
     the rail. It is invisible here, and a managed challenge renders in its own overlay, not inline. */
  .dsub-rail .dsub-ts { min-height: 0; min-width: 0; max-width: 100%; overflow: hidden; }
  .dsub-rail .dsub-ts > * { max-width: 100%; }

  .dsub-h { font-size: 1.15rem; line-height: 1.25; margin: 0 0 4px; font-weight: 700; }
  .dsub-sub { margin: 0; color: var(--fg-mute); font-size: .94rem; line-height: 1.55; max-width: 62ch; }

  .dsub-form { display: grid; gap: 12px; }
  .dsub-row { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
  .dsub-lab {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }
  .dsub-input {
    flex: 1 1 260px; min-width: 0;
    padding: 11px 13px;
    border: 1px solid var(--line-2);
    border-radius: var(--r-sm);
    background: var(--paper-2);
    color: var(--fg);
    font: inherit;
    font-size: .95rem;
  }
  .dsub-input:focus-visible { outline: 2px solid var(--green); outline-offset: 1px; }
  /* .btn supplies the shape; only the field-row sizing is overridden, so the button matches the input
     height instead of the 14px/26px hero padding. */
  .dsub-btn { flex: 0 0 auto; padding: 12px 22px; font-size: .95rem; }
  .dsub-ts { min-height: 65px; }
  /* Interaction-only Turnstile is invisible for the normal visitor, so reserve no space for it. Covers the
     rail (always quiet) and any inline/band opted in via quietTurnstile. */
  .dsub[data-quiet-ts] .dsub-ts { min-height: 0; }

  .dsub-fine { margin: 0; color: var(--fg-mute); font-size: .82rem; line-height: 1.5; }
  .dsub-fine a { color: inherit; text-decoration: underline; }

  .dsub-msg { margin: 0; font-size: .9rem; line-height: 1.5; font-weight: 600; }
  .dsub-msg[data-kind='ok'] { color: var(--green-600); }
  .dsub-msg[data-kind='err'] { color: var(--clay); }
  /* An explicit display on a flex/grid element beats the user-agent [hidden] rule, so state it outright.
     Cheap here, and it is the exact failure that has bitten the shadow-DOM components. */
  .dsub-msg[hidden] { display: none !important; }

  /* sow-202: a signed-in member gets the link to their digest switch in place of the form. The member signal stamps
     html.is-gbti-member; the class sits outside this component, so it is matched through :global. */
  .dsub-member { display: none; margin: 0; font-size: 14px; line-height: 1.5; color: var(--fg-soft); }
  .dsub-member a { color: inherit; font-weight: 600; text-decoration: underline; }
  :global(html.is-gbti-member) .dsub-member { display: block; }
  :global(html.is-gbti-member) .dsub-form { display: none; }

  @media (min-width: 720px) {
    .dsub-band .dsub-in { grid-template-columns: minmax(0, 1fr) minmax(320px, 420px); align-items: center; gap: 24px; }
  }

  /* sow-388: the full-screen invitation (DigestInvite.astro, the only place this variant renders). Its headline and
     pitch ARE this section's heading and blurb, so the dialog is labelled by them and each exists once. The type is
     the newspaper pairing the owner chose for it: Playfair Display headlines, Libre Franklin labels, Georgia to
     read. DigestInvite.astro imports the two web fonts; Georgia is a system face. Square corners throughout. */
  .dsub-invite { --dsub-pad: 0; width: 100%; text-align: center; }
  /* The vertical rhythm is the invitation's --dinv-gap (22px, tighter on a short screen), so the overlay and this
     form tighten together. */
  .dsub-invite .dsub-in { gap: var(--dinv-gap); }
  .dsub-invite .dsub-copy { display: grid; gap: var(--dinv-gap); justify-items: center; }
  .dsub-invite .dsub-h {
    margin: 0;
    font-family: 'Playfair Display Variable', 'Playfair Display', 'Times New Roman', Georgia, serif;
    font-weight: 800; font-size: clamp(38px, min(5.2vw, 8.4vh), 62px); line-height: 1.04; letter-spacing: -.01em;
    color: var(--fg);
  }
  /* The short rule under the headline, drawn here so it cannot drift away from the heading it belongs to. */
  .dsub-invite .dsub-h { text-wrap: balance; }
  /* Never tighter than 18px under the headline: the descenders sit close to the line box at this size. */
  .dsub-invite .dsub-h::after { content: ''; display: block; width: 72px; height: 3px; margin: max(18px, var(--dinv-gap)) auto 0; background: var(--fg); }
  .dsub-invite .dsub-sub {
    max-width: 620px; text-wrap: pretty;
    font-family: Georgia, 'Times New Roman', serif; font-size: clamp(18px, min(1.9vw, 3.1vh), 22px); line-height: 1.55;
    color: var(--fg-soft);
  }
  .dsub-invite .dsub-form { width: 100%; max-width: 620px; margin: 0 auto; gap: 12px; text-align: left; }
  .dsub-invite .dsub-row { gap: 12px; }
  /* The label is visible here, above the field, where the other variants hide it. */
  .dsub-invite .dsub-lab {
    position: static; width: auto; height: auto; margin: 0; overflow: visible; clip: auto; white-space: normal;
    flex: 0 0 100%;
    font-family: 'Libre Franklin Variable', 'Libre Franklin', 'Franklin Gothic', Helvetica, Arial, sans-serif;
    font-size: 14px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--fg-soft);
  }
  .dsub-invite .dsub-input {
    flex: 1 1 280px; height: 60px; padding: 0 16px;
    border-radius: 0; border-color: color-mix(in srgb, var(--fg) 24%, var(--paper)); background: var(--paper);
    font-family: Georgia, 'Times New Roman', serif; font-size: 18px;
  }
  .dsub-invite .dsub-btn {
    height: 60px; padding: 0 32px; border-radius: 0; box-shadow: none;
    font-family: 'Libre Franklin Variable', 'Libre Franklin', 'Franklin Gothic', Helvetica, Arial, sans-serif;
    font-size: 17px; font-weight: 700; letter-spacing: .04em;
  }
  .dsub-invite .dsub-btn:hover { transform: none; }
  .dsub-invite .dsub-fine, .dsub-invite .dsub-msg {
    font-family: 'Libre Franklin Variable', 'Libre Franklin', 'Franklin Gothic', Helvetica, Arial, sans-serif;
  }
  .dsub-invite .dsub-fine { margin-top: 4px; font-size: 14.5px; line-height: 1.55; }
  .dsub-invite .dsub-msg { font-size: 15px; }
  /* --fg-mute on the dark card is under 4.5:1 at this size, so the small print steps up a shade there. */
  :global([data-theme="dark"]) .dsub-invite .dsub-fine { color: var(--fg-soft); }
  /* One line on a wide screen, as designed; below that the headline may wrap rather than overflow. */
  @media (min-width: 900px) { .dsub-invite .dsub-h { white-space: nowrap; } }
  @media (max-width: 640px) {
    .dsub-invite { text-align: left; }
    .dsub-invite .dsub-copy { justify-items: start; }
    .dsub-invite .dsub-h::after { margin-left: 0; }
    /* No wrapping in a column: with wrap on, the full-basis label pushed the field and button into a second
       column, 114px off the right edge of a 390px phone (found by driving the built page). */
    .dsub-invite .dsub-row { flex-direction: column; flex-wrap: nowrap; align-items: stretch; }
    .dsub-invite .dsub-lab { flex: none; }
    .dsub-invite .dsub-input { flex: none; width: 100%; }
    .dsub-invite .dsub-btn { width: 100%; }
  }
</style>
