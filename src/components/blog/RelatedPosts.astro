---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { isPublic, notStale } from '../../lib/content'; // sow-189: a stale article is never suggested
import ArticleTeaser from './ArticleTeaser.astro';

interface Props {
  post: CollectionEntry<'post'>;
}
const { post } = Astro.props;

// Related = most shared categories/tags (build-time), like the legacy ".related-posts" block.
const cats = new Set(post.data.categories);
const tags = new Set(post.data.tags);
const related = (await getCollection('post'))
  .filter(isPublic)
  .filter(notStale)
  .filter((p) => p.id !== post.id)
  .map((p) => {
    const score =
      p.data.categories.filter((c) => cats.has(c)).length +
      p.data.tags.filter((t) => tags.has(t)).length;
    return { p, score };
  })
  .filter((x) => x.score > 0)
  .sort((a, b) => b.score - a.score || (b.p.data.publishedAt?.valueOf() ?? 0) - (a.p.data.publishedAt?.valueOf() ?? 0))
  .slice(0, 3)
  .map((x) => x.p);
---
{related.length > 0 && (
  <section class="rel-posts" style="margin-top:64px">
    <div class="sec-head center">
      <h2 class="h2">Related posts</h2>
    </div>
    {/* sow-188: as many columns as there are items, never wider than a three-up card. auto-fit gives the
        count-aware track list; the cap (n cards of 340px plus the gaps, centred) stops one or two items
        stretching into banners; the 240px floor lets the 660px Journal column hold two, so a third wraps. */}
    <div class="rel-grid" style={`--n:${related.length}`}>
      {related.map((p) => <ArticleTeaser post={p} />)}
    </div>
  </section>
)}

<style>
  .rel-grid { display: grid; gap: 32px; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); max-width: calc(var(--n) * 340px + (var(--n) - 1) * 32px); margin: 0 auto; }
</style>
