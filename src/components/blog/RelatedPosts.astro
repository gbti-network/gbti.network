---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { isPublic, notStale } from '../../lib/content'; // sow-189: a stale article is never suggested
import ArticleTeaser from './ArticleTeaser.astro';

interface Props {
  post: CollectionEntry<'post'>;
}
const { post } = Astro.props;

// Related = most shared categories/tags (build-time), like the legacy ".related-posts" block.
const cats = new Set(post.data.categories);
const tags = new Set(post.data.tags);
const related = (await getCollection('post'))
  .filter(isPublic)
  .filter(notStale)
  .filter((p) => p.id !== post.id)
  .map((p) => {
    const score =
      p.data.categories.filter((c) => cats.has(c)).length +
      p.data.tags.filter((t) => tags.has(t)).length;
    return { p, score };
  })
  .filter((x) => x.score > 0)
  .sort((a, b) => b.score - a.score || (b.p.data.publishedAt?.valueOf() ?? 0) - (a.p.data.publishedAt?.valueOf() ?? 0))
  .slice(0, 9) // owner, 2026-10-14: up to nine (three rows of three) when that many share a category or tag
  .map((x) => x.p);
---
{related.length > 0 && (
  <section class="rel-posts">
    <div class="sec-head center">
      <h2 class="h2">Related posts</h2>
    </div>
    {/* sow-188: a card is never wider than a three-up card, so one or two never stretch into banners. Owner,
        2026-10-14: the section sits full width under the article, the same width as the extension banner above it,
        and shows up to nine. Every card is a third of the section (three fill a row exactly), half on a mid-width
        screen, the full width on a phone, whatever the count; a short last row is centred under the heading. */}
    <div class="rel-grid">
      {related.map((p) => <ArticleTeaser post={p} />)}
    </div>
  </section>
)}

<style>
  .rel-posts { margin-top: 64px; container-type: inline-size; }
  /* Three to a row while each card can be at least 240px wide (a 784px section), two down to 512px, then one. The
     size comes from the section, not the count, so a row of two is two three-up cards, centred. Container queries
     last: they add no specificity, so an earlier one would lose to the base rule. */
  .rel-grid { display: flex; flex-wrap: wrap; justify-content: center; gap: 32px; }
  .rel-grid > :global(*) { flex: 0 0 calc((100% - 64px) / 3); min-width: 0; }
  @container (max-width: 783px) { .rel-grid > :global(*) { flex-basis: calc((100% - 32px) / 2); } }
  @container (max-width: 511px) { .rel-grid > :global(*) { flex-basis: 100%; } }
</style>
