---
import { getCollection } from 'astro:content';
import { authorDisplay, authorAvatar, formatDate } from '../../lib/authors';
import { profileHref } from '../../lib/profile-pages'; // sow-362: undefined when the member has no page yet
import { commitHistoryHref, itemComments, authorNotesOf } from '../../lib/comments';
import Avatar from '../Avatar.astro';
import LockedBody from '../LockedBody.astro';
import CommentBox from './CommentBox.astro';
import AuthorNote from './AuthorNote.astro'; // sow-459: the pinned intro, also placed on its own by the prompt page

interface Props {
  targetType: 'post' | 'project' | 'prompt' | 'share'; // sow-094: the public share page mounts the discussion
  targetSlug: string;
  author?: string; // content owner; their earliest comment renders as the pinned "From the author" block (SOW-014)
  wide?: boolean; // when true, span the full content width (prompt detail) instead of the 800px reading column
  aliases?: string[]; // SOW-112: pre-rename slugs, unioned so the discussion follows a renamed item
  note?: boolean; // sow-459: false when the page renders the author note elsewhere (the prompt page); notes stay out of the thread
}
const { targetType, targetSlug, author, wide = false, aliases = [], note = true } = Astro.props;
// SOW-112 QA: the parent item's index.md path, for the paid-member open-in-extension reader deep link.
const SUB = { post: 'posts', project: 'projects', product: 'projects', prompt: 'prompts' } as Record<string, string>;
// sow-094: a share's targetSlug is "<author>/<id>" and its file is flat (members/<author>/shares/<id>.md).
const itemReaderPath = targetType === 'share'
  ? `members/${targetSlug.split('/')[0]}/shares/${targetSlug.split('/').slice(1).join('/')}.md`
  : SUB[targetType]
    ? (author === 'gbti' || author === 'house' ? `house/${SUB[targetType]}/${targetSlug}/index.md` : `members/${author}/${SUB[targetType]}/${targetSlug}/index.md`)
    : undefined;
// Comments are authored by members via the local client -> PR (auto-merged for paid members);
// rendered here read-only. See .data/specs/comments.md. itemComments (src/lib/comments.ts) is the item's published
// comments, oldest first: SOW-016 drops drafts only, so member-only comments render locked; sow-196 matches on the
// CANONICAL type, so a comment stored under the retired `product` name still attaches; SOW-112 unions the
// pre-rename slugs, so the discussion follows a renamed item.
const published = itemComments(await getCollection('comment'), targetType, targetSlug, aliases);

// SOW-014: the content author's deliberate note (flagged `authorNote`) is the required "from the author"
// introduction, lifted out and pinned REGARDLESS of when it was written, so an author may post it after a
// discussion has begun and it still reads as the headline (a casual conversational comment is never pinned).
// authorNotesOf keeps the owner's PUBLIC authorNote comments; the newest is pinned (AuthorNote.astro renders it)
// and EVERY one is excluded from the thread, so an intro can never render as a plain member comment, including
// when the page shows the note somewhere else (note={false}, sow-459).
const notes = authorNotesOf(published, author);
const intro = note && notes.length ? notes[notes.length - 1] : null;
// Thread = the rest. A member-only comment (SOW-016) renders as a locked placeholder via its encryptedBody;
// a legacy member-only comment with no encrypted body stays excluded (matches the prior soft-gate behavior).
const thread = published
  .filter((c) => !notes.includes(c))
  .filter((c) => c.data.visibility !== 'members' || c.data.encryptedBody);
// Resolve each comment author's avatar from their member profile (else the house Gravatar for `gbti`,
// else the letter disc). authorAvatar needs the profile avatar passed in, so build a username -> url map.
const profiles = await getCollection('profile');
const profileAvatar = new Map(profiles.map((p) => [p.data.username, p.data.avatar]));
const avatarOf = (username: string) => authorAvatar(username, profileAvatar.get(username));
// sow-454 (reported by a member 2026-10-13): his "From the author" card read `gsusi` while his profile
// held "Jesus Iniesta". authors.ts states the intended design in its own header, that a caller holding a
// profile prefers its displayName and only a caller without one falls through to the handle, and
// ContentMeta/AuthorBox both do that. This file had the profiles in hand for the avatars and still used
// the bare handle for the name, and computed introName ABOVE the line that loads them, so it could not
// have done otherwise. One map, read wherever a name is shown here (the intro card's name moved with the card to
// AuthorNote.astro in sow-459, which builds the same map the same way).
const profileName = new Map(
  profiles.filter((p) => p.data.displayName).map((p) => [p.data.username, p.data.displayName as string]),
);
const nameOf = (username: string) => profileName.get(username) ?? authorDisplay(username);
---
<section id="comments" class:list={[!wide && 'mx-auto']} style={`margin-top:48px${wide ? '' : ';max-width:800px'}`}>
  {intro && <AuthorNote targetType={targetType} targetSlug={targetSlug} author={author} aliases={aliases} />}

  <h2 class="h3" style={intro ? 'margin-top:40px' : ''} data-comments-count={thread.length}>
    {thread.length} {thread.length === 1 ? 'Comment' : 'Comments'}
  </h2>

  {/* Owner, 2026-10-14: no empty-thread card. It repeated the composer's own "Comments are for members" invitation just
      below it (and still described the retired local client), so an empty thread is the heading and the composer. */}
  {thread.length > 0 && (
    <ul style="list-style:none;padding:0;margin-top:24px;display:flex;flex-direction:column;gap:24px">
      {thread.map((c) => (
        <li class="card" style="padding:20px;display:flex;gap:14px;align-items:flex-start;--embed-out-l:78px;--embed-out-r:20px">
          <a href={profileHref(c.data.author)} class="shrink-0"><Avatar item={{ name: nameOf(c.data.author), avatar: avatarOf(c.data.author), seed: c.data.author }} size={44} class="rounded-full" /></a>
          <div class="cmt-col" style="flex:1;min-width:0">
            <div class="cmt-meta flex items-center g8 body-sm muted">
              <a href={profileHref(c.data.author)} class="link" style="font-size:15px">{nameOf(c.data.author)}</a>
              <span aria-hidden="true">·</span>
              <time datetime={c.data.createdAt.toISOString()}>{formatDate(c.data.createdAt)}</time>
            </div>
            {c.data.visibility === 'members'
              ? <div style="margin-top:8px"><LockedBody encPath={c.data.encryptedBody} kind="comment" readerType={targetType} readerPath={itemReaderPath} /></div>
              : <div class="cmt-rich" style="margin-top:8px;color:var(--fg-soft)" set:html={c.rendered?.html ?? ''} />}
            <div class="flex items-center g12" style="margin-top:10px">
              {c.data.updatedAt && commitHistoryHref(c.filePath) && (
                <a href={commitHistoryHref(c.filePath)} rel="noopener" class="cmt-edited">edited &middot; view history</a>
              )}
              {/* SOW-027: inert edit affordance; the client shows "Edit" only to this comment's author. */}
              <CommentBox targetType={targetType} targetSlug={targetSlug} commentId={c.data.id} commentAuthor={c.data.author} />
            </div>
          </div>
        </li>
      ))}
    </ul>
  )}

  {/* SOW-076 on the website (2026-09-11): the signed-in author's own comments still posting, rendered here as
      cards with a merge-status note the moment they post, so a fresh comment does not look lost for the 2 to 3
      minutes the site takes to rebuild. Inert (empty) for everyone else; the built thread above stays the record. */}
  <gbti-comment-echoes data-gbti-target-type={targetType} data-gbti-target-slug={targetSlug}></gbti-comment-echoes>

  {/* SOW-027: the inert comment composer; the GBTI client upgrades it for a paid member, inert otherwise. */}
  <CommentBox targetType={targetType} targetSlug={targetSlug} readerPath={itemReaderPath} />
</section>

<style is:global>
  /* Rendered comment / author-note markdown: give paragraphs real spacing and make links read as links. */
  .cmt-rich { overflow-wrap: anywhere; } /* sow-443: a bare long link wraps instead of running past the card */
  .cmt-rich > :first-child { margin-top: 0; }
  .cmt-rich > :last-child { margin-bottom: 0; }
  .cmt-rich p { margin: 0.7em 0; }
  .cmt-rich a { color: var(--green-700); text-decoration: underline; text-underline-offset: 2px; }
  .cmt-rich a:hover { color: var(--green-600); }
  .cmt-rich ul, .cmt-rich ol { margin: 0.7em 0; padding-left: 1.4em; }
  .cmt-rich li { margin: 0.3em 0; }
  .cmt-rich ul li { list-style: disc; }
  .cmt-rich ol li { list-style: decimal; }
  .cmt-rich blockquote { border-left: 4px solid var(--green); margin: 0.8em 0; padding: 0.1em 0 0.1em 14px; color: var(--fg); font-style: italic; }
  /* A video in a comment: full container width, rounded, 16:9 (9:16 for a portrait provider). The built markup
     is the sanitizer's iframe in .embed-wrap; the script below swaps it for the poster the client renderers use,
     which opens the page lightbox. Both shapes get the same box. */
  .cmt-rich .embed-wrap, .cmt-rich .md-embed { position: relative; width: 100%; margin: .6em 0 1em; aspect-ratio: 16 / 9; border-radius: 10px; overflow: hidden; background: #000; }
  .cmt-rich .md-embed.md-embed-portrait { aspect-ratio: 9 / 16; max-width: 360px; }
  /* sow-261: a bare tweet line. The link shows until X's frame reports the tweet's size, then the frame takes its
     height (client-ui/src/tweet-frames.mjs TWEET_CSS, the same rules for the shadow-root comment surfaces). */
  .cmt-rich .md-tweet { margin: .6em 0 1em; max-width: 550px; }
  .cmt-rich .md-tweet > iframe { display: block; width: 100%; height: 0; border: 0; overflow: hidden; background: transparent; color-scheme: normal; } /* normal: no white backdrop on a dark page */
  .cmt-rich .md-tweet.is-ready > a { display: none; }
  /* sow-444 (owner, 2026-10-06): in a comment card an embed sits under the avatar, card edge to card edge. The card
     sets --embed-out-l / --embed-out-r (how far its text column sits in: padding 20 + avatar 44 + gap 14, and padding
     20; the author intro 24 / 24); unset elsewhere, so nothing else moves. A tweet is at most 550px (X's own cap),
     centred; a portrait video keeps 360px, centred. The same rules as COMMENT_EMBED_CSS in client-ui/src/tweet-frames.mjs. */
  .cmt-rich .md-tweet.is-ready { margin-left: calc(-1 * var(--embed-out-l, 0px)); margin-right: calc(-1 * var(--embed-out-r, 0px)); max-width: none; }
  .cmt-rich .md-tweet.is-ready > iframe { max-width: 550px; margin-inline: auto; }
  .cmt-rich .md-embed, .cmt-rich .embed-wrap { width: auto; margin-left: calc(-1 * var(--embed-out-l, 0px)); margin-right: calc(-1 * var(--embed-out-r, 0px)); }
  /* A body that BEGINS with an embed would start beside the avatar and run into it; the name row then takes the
     avatar's height (44px), so the embed starts below it. A members-only body flags its host (data-embed-first). */
  .cmt-col:has(> .cmt-rich > :is(.md-tweet.is-ready, .md-embed, .embed-wrap):first-child) > .cmt-meta,
  .cmt-col:has(gbti-locked-content[data-embed-first]) > .cmt-meta { min-height: 44px; }
  .cmt-rich .md-embed.md-embed-portrait { width: min(360px, calc(100% + var(--embed-out-l, 0px) + var(--embed-out-r, 0px))); max-width: none; margin-right: 0; margin-left: calc(max(0px, (100% + var(--embed-out-l, 0px) + var(--embed-out-r, 0px) - 360px) / 2) - var(--embed-out-l, 0px)); }
  .cmt-rich .embed-wrap iframe, .cmt-rich .md-embed iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .cmt-rich .md-embed-open { position: absolute; inset: 0; width: 100%; height: 100%; display: block; padding: 0; border: 0; background: #111; cursor: pointer; }
  .cmt-rich .md-embed-thumb { width: 100%; height: 100%; object-fit: cover; display: block; }
  .cmt-rich .md-embed-panel { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; color: #fff; font: 600 14px/1 var(--f-mono); letter-spacing: .08em; text-transform: uppercase; }
  .cmt-rich .md-embed-play { position: absolute; left: 50%; top: 50%; width: 64px; height: 64px; margin: -32px 0 0 -32px; border-radius: 999px; background: rgba(0, 0, 0, .65); color: #fff; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 18px rgba(0, 0, 0, .4); transition: background .15s ease, transform .15s ease; }
  .cmt-rich .md-embed-open:hover .md-embed-play, .cmt-rich .md-embed-open:focus-visible .md-embed-play { background: var(--green); transform: scale(1.06); }
  .cmt-rich :not(pre) > code { background: var(--tint); color: var(--fg); padding: 0.15em 0.4em; border-radius: 4px; font-size: 0.9em; }
  /* "edited" affordance: a quiet link to the comment file's git commit history (the public repo is the database). */
  .cmt-edited { display: inline-block; font-size: 12px; color: var(--fg-mute); text-decoration: none; }
  .cmt-edited:hover { color: var(--green-700); text-decoration: underline; text-underline-offset: 2px; }
</style>

<script>
  // 2026-09-11: a public comment's built video (the sanitizer's iframe inside .embed-wrap, from the remark pass)
  // becomes the same poster the client renderers draw, so a click opens the page lightbox instead of playing
  // in place. Comment sections only; an article body keeps its inline player. Runs for every reader.
  import { embedPosterHtml } from '../../../client/src/video-embed.mjs';
  // sow-459: and the author note where a page places it outside the thread (AuthorNote.astro, [data-author-note]).
  document.querySelectorAll<HTMLElement>('#comments .cmt-rich .embed-wrap, [data-author-note] .cmt-rich .embed-wrap').forEach((wrap) => {
    const src = wrap.querySelector('iframe')?.getAttribute('src') || '';
    const html = src ? embedPosterHtml(src, { frameSrc: src }) : '';
    if (html) wrap.outerHTML = html;
  });
  // sow-261: a built comment's bare tweet line (the remark pass emits <div class="md-tweet"><a>) becomes the live
  // tweet, framed straight from X (the site's CSP admits platform.twitter.com), sized from X's own messages.
  import { wireTweets } from '../../../client-ui/src/tweet-frames.mjs';
  const thread = document.querySelector('#comments');
  if (thread) wireTweets(thread, { via: 'direct' });
  document.querySelectorAll<HTMLElement>('[data-author-note]').forEach((n) => { if (!n.closest('#comments')) wireTweets(n, { via: 'direct' }); });
</script>

<script>
  // sow-158: the public content pages never called setClient(), so a member signed in on the WEBSITE saw only
  // the inert "use the GBTI extension" fallback, even though the whole comment pipeline (cookie auth + CSRF +
  // server-side paid gate) has shipped. This wires it: it REUSES the header's existing cookie hydration
  // (member-signal.ts runs hydrateMemberSignal once, cached, so this adds no extra /membership/status call);
  // when that resolves a signed-in member, it injects the client and upgrades every <gbti-comment-box> on the
  // page. The element then renders per membership on its own (a compose form for a paid member, an upgrade
  // nudge for trial/locked). An anonymous visitor resolves to null, nothing is imported, and the inert fallback
  // stays, so their page weight is unchanged. The server + the SOW-005 gate remain the real boundary; this is
  // presentation wiring only, and paid-only posting is enforced server-side regardless of what renders here.
  import { onMemberSignal, currentIdentity, readMemberSignal } from '../../lib/member-signal';

  // Read a non-HttpOnly cookie (the gbti_csrf double-submit token); its presence is the cheap "there is a web
  // session" signal the gated pages already use, with no network.
  function readCookie(name: string): string | null {
    for (const part of document.cookie.split(';')) {
      const eq = part.indexOf('=');
      if (eq >= 0 && part.slice(0, eq).trim() === name) return part.slice(eq + 1).trim() || null;
    }
    return null;
  }

  let mounted = false;
  async function mountComments(signal: any) {
    if (mounted || !signal || !signal.login) return; // signed out / not yet resolved -> leave the fallback
    // Only mount the WEBSITE client for a real cookie session. An extension-only member (a display signal but no
    // gbti_csrf cookie) is upgraded by the extension itself; a web client would have no session to authenticate.
    if (!readCookie('gbti_csrf')) return;
    if (!document.querySelector('gbti-comment-box, gbti-locked-content')) return; // no composer or gated body/comment here
    mounted = true;
    const signupBase = document.documentElement.dataset.signupBase || '';
    const { createWorkbenchClient } = await import('../../lib/workbench-client');
    const { setClient } = await import('../../../client-ui/src/base.mjs');
    setClient(createWorkbenchClient({ signupBase, login: String(signal.login), username: String(signal.username || signal.login), githubId: signal.githubId != null ? String(signal.githubId) : null }));
    // Defining the elements upgrades every baked tag on the page: the composer (<gbti-comment-box>) and every
    // member-only placeholder (<gbti-locked-content> — a member-only comment body, and the SOW-016 content
    // body/section on this same page). Each renders per membership on the setClient subscriber fan-out; a
    // member-only body/comment decrypts via the injected client's decrypt() (the AES key stays in the Worker,
    // a non-authorized reader gets the locked message). This is the wiring the extension host already has, now
    // on the web, so a signed-in member reads member-only content on the site instead of being sent away.
    await Promise.all([
      import('../../../client-ui/src/elements/gbti-comment-box.mjs'),
      import('../../../client-ui/src/elements/gbti-locked-content.mjs'),
      // The author's own pending comments (SOW-076 echoes on the website). Without this import the baked
      // <gbti-comment-echoes> tag is an unknown element and stays inert: the harness bundled the whole registry
      // and hid exactly that (2026-09-11), so the pin in test/comment-echo-website.test.mjs reads this list.
      import('../../../client-ui/src/elements/gbti-comment-echoes.mjs'),
    ]);
  }

  mountComments(currentIdentity(readMemberSignal())); // extension signal, if present, before the cookie resolves
  onMemberSignal(mountComments);                      // the winning cookie member arrives here once hydrated
</script>
