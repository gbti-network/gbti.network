---
// Article body styling — reproduces the legacy blog post-content look
// (source: .data/ops/design-ops/legacy-css/portfolio-lite-child__post.css):
// ~1.2em body, deep-green blockquotes, monospace figcaptions, rounded media.
import { dataBlocksCss } from '../../../client/src/content-blocks.mjs';
// sow-453: the article component library (tags, bar, facts, button), styled from the V3 tokens in both themes.
const blocksCss = dataBlocksCss('.prose-gbti', {
  fg: 'var(--fg)', soft: 'var(--fg-soft)', mute: 'var(--fg-mute)', line: 'var(--line)', line2: 'var(--line-2)', rest: 'var(--line-2)',
  green: 'var(--green)', green700: 'var(--green-700)', green700Solid: '#0f6f40', greenTint: 'var(--green-tint)',
  greenBorder: 'color-mix(in srgb, var(--green) 40%, transparent)', surface: 'var(--paper-2)', card: 'var(--paper)', mono: 'var(--f-mono)',
});
---
<style is:inline set:html={blocksCss}></style>
<div class="prose-gbti">
  <slot />
</div>

<style is:global>
  .prose-gbti {
    color: var(--fg-soft);
    font-size: 1.15rem;
    line-height: 1.75;
  }
  .prose-gbti > :first-child { margin-top: 0; }
  .prose-gbti p { margin: 1.1em 0; }
  .prose-gbti h2,
  .prose-gbti h3,
  .prose-gbti h4 {
    font-family: var(--f-display);
    font-weight: 800;
    color: var(--fg);
    line-height: 1.25;
    margin: 1.6em 0 0.5em;
  }
  .prose-gbti h2 { font-size: 1.9rem; }
  .prose-gbti h3 { font-size: 1.5rem; }
  .prose-gbti h4 { font-size: 1.2rem; }
  .prose-gbti a { color: var(--green-700); text-decoration: underline; text-underline-offset: 2px; }
  .prose-gbti a:hover { color: var(--green-600); }
  .prose-gbti ul, .prose-gbti ol { margin: 1.25em 0; padding-left: 1.5em; }
  .prose-gbti li { margin: 0.4em 0; }
  /* sow-321: an item takes the marker of its OWN list (child combinator), so bullets nested under a numbered item
     stay bullets (the descendant rule made them numbers); a nested list sits close under its parent item. */
  .prose-gbti ul > li { list-style: disc; }
  .prose-gbti ol > li { list-style: decimal; }
  .prose-gbti li > ul, .prose-gbti li > ol { margin: 0.25em 0 0; }
  /* sow-322: a marker style chosen from the list bar ({square}, {lower-alpha} on the item that opens a run:
     client/src/list-attrs.mjs) on that list's OWN items, the child combinator again so a sublist keeps its own
     marker. Kept by hand in step with listStyleProseCss (client-ui/src/list-style-ui.mjs); test/list-styles.test.mjs
     compares the two rule by rule. */
  .prose-gbti ul.list-circle > li { list-style: circle; }
  .prose-gbti ul.list-square > li { list-style: square; }
  .prose-gbti ol.list-lower-alpha > li { list-style: lower-alpha; }
  .prose-gbti ol.list-upper-alpha > li { list-style: upper-alpha; }
  .prose-gbti ol.list-lower-roman > li { list-style: lower-roman; }
  .prose-gbti ol.list-upper-roman > li { list-style: upper-roman; }
  .prose-gbti blockquote {
    border-left: 9px solid var(--green);
    margin: 1.5em 0;
    padding: 0.2em 0 0.2em 20px;
  }
  .prose-gbti blockquote p { color: var(--fg); font-style: italic; }
  .prose-gbti blockquote cite { display: block; margin-top: 0.5em; color: var(--green-700); font-style: normal; font-size: 0.95rem; }
  .prose-gbti img { border-radius: 10px; margin: 1.5em auto; max-width: 100%; height: auto; }
  /* Image layout words (client/src/image-attrs.mjs, set from the WorkBench Preview's image bar or the editor's
     image card): {full} spans the column; {left} / {center} / {right} place the image on its own line;
     {left wrap} / {right wrap} float it at up to half the column so the following text flows beside it. Full width
     wins over a float. A phone column is too narrow to share, so a float falls back to a block there. The container
     is a flow root so a trailing float never spills under the article footer. Mirrored for the client renderers by
     imageLayoutProseCss in client-ui/src/image-layout-ui.mjs; test/image-layout.test.mjs pins the two in step. */
  .prose-gbti { display: flow-root; }
  .prose-gbti img.img-full { display: block; width: 100%; }
  .prose-gbti img.img-left, .prose-gbti img.img-center, .prose-gbti img.img-right { display: block; }
  .prose-gbti img.img-left { margin-left: 0; margin-right: auto; }
  .prose-gbti img.img-right { margin-left: auto; margin-right: 0; }
  .prose-gbti img.img-center { margin-left: auto; margin-right: auto; }
  .prose-gbti img.img-wrap.img-left:not(.img-full) { float: left; max-width: 50%; margin: 0.35em 1.5em 0.75em 0; }
  .prose-gbti img.img-wrap.img-right:not(.img-full) { float: right; max-width: 50%; margin: 0.35em 0 0.75em 1.5em; }
  /* A captioned image is a figure (the image title is the caption); the layout classes sit on the FIGURE so a
     float or full width carries the caption strip along. Same numbers as the img rules above. */
  .prose-gbti figure img { display: block; margin: 0 auto; }
  .prose-gbti figure.img-full { width: 100%; }
  .prose-gbti figure.img-full img { width: 100%; }
  .prose-gbti figure.img-left, .prose-gbti figure.img-center, .prose-gbti figure.img-right { width: fit-content; max-width: 100%; }
  .prose-gbti figure.img-left { margin-left: 0; margin-right: auto; }
  .prose-gbti figure.img-right { margin-left: auto; margin-right: 0; }
  .prose-gbti figure.img-center { margin-left: auto; margin-right: auto; }
  .prose-gbti figure.img-wrap.img-left:not(.img-full) { float: left; max-width: 50%; margin: 0.35em 1.5em 0.75em 0; }
  .prose-gbti figure.img-wrap.img-right:not(.img-full) { float: right; max-width: 50%; margin: 0.35em 0 0.75em 1.5em; }
  @media (max-width: 640px) {
    .prose-gbti img.img-wrap.img-left:not(.img-full), .prose-gbti img.img-wrap.img-right:not(.img-full) { float: none; max-width: 100%; margin: 1.5em auto; }
    .prose-gbti figure.img-wrap.img-left:not(.img-full), .prose-gbti figure.img-wrap.img-right:not(.img-full) { float: none; max-width: 100%; margin: 1.5em auto; width: fit-content; }
  }
  .prose-gbti figure { margin: 1.5em auto; text-align: center; }
  .prose-gbti figcaption { font-family: var(--f-mono); background: var(--tint); color: var(--fg-mute); font-size: 0.85rem; padding: 4px 8px; text-align: left; }
  .prose-gbti :not(pre) > code { background: var(--tint); color: var(--fg); padding: 0.15em 0.4em; border-radius: 4px; font-size: 0.9em; overflow-wrap: anywhere; }
  .prose-gbti pre { background: var(--ink-2); color: var(--on-dark); padding: 1em; border-radius: 8px; overflow-x: auto; margin: 1.5em 0; }
  .prose-gbti pre code { background: none; padding: 0; }
  /* sow-248: a table is the one wide block that had no scroll container, so five of the 52 articles pushed a
     phone page sideways by up to 213px (measured at 390px). The GitHub-markdown rule: the table keeps its own
     layout at its natural width and scrolls INSIDE the column, which is the one nested-scroll shape that does not
     trap a thumb (horizontal inside vertical).
     sow-470: that scroll now comes from a WRAPPER (rehype-table-scroll.mjs, at build so it survives with
     JavaScript off), not from `display: block` on the table itself. The old rule bought the scroll by stopping
     the table being a table: it could not fill its column, and column widths stopped being negotiated across
     rows. `min-width: 100%` is what `width: max-content` used to do, without that cost. */
  .prose-gbti .table-wrap { position: relative; margin: 1.6em 0; }
  .prose-gbti .table-scroll { overflow-x: auto; }
  .prose-gbti table { border-collapse: collapse; min-width: 100%; width: max-content; font-size: .95em; }
  .prose-gbti .table-scroll table { margin: 0; }
  /* sow-470 (design round "Article tables", option A: ruled rows). Horizontal rules only, no vertical lines and
     no outer box, so a table reads as part of the article rather than interrupting it. The first and last cells
     lose their outer padding so the table shares the prose column's left edge. Every value is a token that
     exists in BOTH themes, so dark mode needs no second copy of any of this. */
  .prose-gbti th, .prose-gbti td { padding: 9px 12px; text-align: left; vertical-align: top; border: 0; }
  .prose-gbti tr > th:first-child, .prose-gbti tr > td:first-child { padding-left: 0; }
  .prose-gbti tr > th:last-child, .prose-gbti tr > td:last-child { padding-right: 0; }
  .prose-gbti thead th { font-family: var(--f-mono); font-size: 10.5px; font-weight: 500; letter-spacing: .07em;
    text-transform: uppercase; color: var(--fg-mute); padding-top: 0; padding-bottom: 8px;
    border-bottom: 1.5px solid var(--fg); white-space: nowrap; }
  .prose-gbti tbody td { border-bottom: 1px solid var(--line); }
  .prose-gbti tbody tr:last-child td { border-bottom: 0; }
  /* A column of figures is only comparable down its length when the digits line up, which needs both the right
     edge and tabular figures. The class is set by the enhancer, which is also what decides a column is numeric. */
  .prose-gbti th.tnum, .prose-gbti td.tnum { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  /* A table that continues past the edge looks finished without this, and nobody scrolls a block that looks
     finished. Painted only while there is somewhere to scroll (the enhancer sets data-overflow). */
  /* On the OUTER wrapper, which does not scroll. Inside the scroller an absolutely positioned fade is placed
     against the scrolled content, not the visible edge: measured at 390px it rendered 216px off-screen. */
  .prose-gbti .table-wrap[data-overflow="1"]::after { content: ''; position: absolute; top: 0; right: 0; width: 34px;
    height: 100%; pointer-events: none; background: linear-gradient(to right, transparent, var(--paper-2)); }
  /* sow-470: the sort control. A real <button> inside the th, so Tab reaches it and the th can carry aria-sort.
     The idle chevron sits at 25% so a sortable column says so without the header becoming a row of arrows. */
  .prose-gbti .tsort-btn { display: inline-flex; align-items: center; gap: 6px; background: none; border: 0; padding: 0;
    margin: 0; font: inherit; color: inherit; letter-spacing: inherit; text-transform: inherit; cursor: pointer; }
  .prose-gbti .tsort-btn:hover { color: var(--fg); }
  .prose-gbti .tsort-ind { opacity: .25; flex: none; transition: opacity .12s, color .12s, transform .12s; }
  .prose-gbti .tsort-btn:hover .tsort-ind { opacity: .65; }
  .prose-gbti .tsort-btn.on { color: var(--fg); }
  .prose-gbti .tsort-btn.on .tsort-ind { opacity: 1; color: var(--green); }
  .prose-gbti .tsort-btn.on.asc .tsort-ind { transform: rotate(180deg); }
  .prose-gbti .tsort-btn:focus-visible { outline: 2px solid var(--green); outline-offset: 3px; border-radius: 3px; }
  /* Without this nothing says the headings are clickable, and a reader does not try. */
  .prose-gbti caption.tsort-cap { caption-side: top; text-align: left; padding: 0 0 9px; font-size: 11.5px;
    color: var(--fg-mute); }
  @media (prefers-reduced-motion: reduce) { .prose-gbti .tsort-ind { transition: none; } }
  /* sow-248, measured after the table rule landed: the two named articles STILL overflowed (195px and 128px at
     390px), and the offenders were bare URLs used as link text in footnotes and a blockquote, which have no
     break opportunity. overflow-wrap inherits, so one rule on the container covers every paragraph, list item
     and footnote; `anywhere` (not `break-word`) also shrinks the min-content width, so a grid or flex column
     holding the prose cannot be stretched by an unbreakable run either. */
  .prose-gbti { overflow-wrap: anywhere; }
  /* Code cards: the enhancer script wraps each pre in a .code-card with a header bar (language + a working
     Copy button), mirroring the extension reader's codecard so the two surfaces match. 7px house radius. */
  .prose-gbti .code-card { margin: 1.5em 0; border-radius: 7px; overflow: hidden; border: 1px solid var(--line); }
  .prose-gbti .code-card pre { margin: 0; border-radius: 0; }
  .prose-gbti .code-bar { display: flex; align-items: center; justify-content: space-between; gap: 10px;
    background: var(--ink); color: var(--on-dark); padding: 6px 12px; }
  .prose-gbti .code-lang { font-family: var(--f-mono); font-size: 11px; letter-spacing: .04em; text-transform: uppercase; opacity: .7; }
  .prose-gbti .code-copy { font-family: var(--f-sans); font-size: 11.5px; font-weight: 600; color: var(--on-dark);
    background: transparent; border: 1px solid rgba(255,255,255,.25); border-radius: 6px; padding: 2px 10px; cursor: pointer;
    transition: border-color .15s, color .15s; }
  .prose-gbti .code-copy:hover { border-color: var(--green); color: var(--green); }
  .prose-gbti hr { border: 0; border-top: 1px solid var(--line); margin: 2em 0; }
  .prose-gbti iframe { width: 100%; max-width: 100%; aspect-ratio: 16 / 9; margin: 1.5em 0; border-radius: 10px; }
  /* SOW-062 5d: body callout + embed blocks (rendered by remark-content-blocks.mjs) */
  .prose-gbti .callout { margin: 1.4em 0; border: 1.5px solid var(--line); border-radius: 12px; padding: 14px 16px 14px 46px; position: relative; background: var(--tint, rgba(0,0,0,.02)); }
  .prose-gbti .callout::before { content: ""; position: absolute; left: 16px; top: 17px; width: 18px; height: 18px; border-radius: 50%; }
  .prose-gbti .callout-info { border-color: rgba(63,116,214,.4); background: rgba(63,116,214,.08); }
  .prose-gbti .callout-info::before { background: #3f74d6; }
  .prose-gbti .callout-note::before { background: var(--fg-mute, #888); }
  .prose-gbti .callout-warning { border-color: rgba(216,144,26,.4); background: rgba(224,163,61,.1); }
  .prose-gbti .callout-warning::before { background: #d8901a; }
  .prose-gbti .callout-tip { border-color: rgba(69,192,141,.4); background: rgba(69,192,141,.1); }
  .prose-gbti .callout-tip::before { background: var(--green, #45c08d); }
  .prose-gbti .embed-wrap { position: relative; margin: 1.5em 0; aspect-ratio: 16 / 9; border-radius: 10px; overflow: hidden; background: var(--ink, #000); }
  .prose-gbti .embed-wrap iframe { width: 100%; height: 100%; margin: 0; border: 0; }
  /* GFM footnotes (remark-gfm): superscript refs in the body; the generated end section gets a rule +
     smaller muted type (its own "Footnotes" h2 ships sr-only, so the separation must come from us).
     Sized in em (a proportion of the article body) rather than rem, so the reduction holds at every
     breakpoint instead of collapsing toward body size when the body scales down. */
  .prose-gbti sup a { text-decoration: none; font-weight: 700; padding: 0 1px; }
  .prose-gbti section[data-footnotes] { margin-top: 2.5em; padding-top: 1.2em; border-top: 1px solid var(--line); font-size: 0.8em; color: var(--fg-mute); }
  .prose-gbti section[data-footnotes] p { margin: 0 0 0.5em; }
  .prose-gbti section[data-footnotes] p:last-child { margin: 0; }
  .prose-gbti section[data-footnotes] li { margin: 0.5em 0; }
  .prose-gbti .data-footnote-backref { text-decoration: none; margin-left: 4px; }
  /* ```embed lightbox (owner, 2026-10-13): full column width, 16:9, the thumbnail and a play button; a click opens the
     page lightbox (Lightbox.astro), so no player loads until then. The built fallback is the linked thumbnail. */
  .prose-gbti .embed-lightbox, .prose-gbti .md-embed { position: relative; width: 100%; margin: 1.5em 0; aspect-ratio: 16 / 9; border-radius: 10px; overflow: hidden; background: #000; }
  .prose-gbti .embed-lightbox a, .prose-gbti .embed-lightbox img { display: block; width: 100%; height: 100%; margin: 0; object-fit: cover; border-radius: 0; }
  .prose-gbti .md-embed.md-embed-portrait { aspect-ratio: 9 / 16; max-width: 360px; margin-inline: auto; }
  .prose-gbti .md-embed-open { position: absolute; inset: 0; width: 100%; height: 100%; display: block; padding: 0; border: 0; background: #111; cursor: pointer; }
  .prose-gbti .md-embed-thumb { width: 100%; height: 100%; object-fit: cover; display: block; margin: 0; border-radius: 0; }
  .prose-gbti .md-embed-panel { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; color: #fff; font: 600 14px/1 var(--f-mono); letter-spacing: .08em; text-transform: uppercase; }
  .prose-gbti .md-embed-play { position: absolute; left: 50%; top: 50%; width: 64px; height: 64px; margin: -32px 0 0 -32px; border-radius: 999px; background: rgba(0, 0, 0, .65); color: #fff; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 18px rgba(0, 0, 0, .4); transition: background .15s ease, transform .15s ease; }
  .prose-gbti .md-embed-open:hover .md-embed-play, .prose-gbti .md-embed-open:focus-visible .md-embed-play { background: var(--green); transform: scale(1.06); }
  .prose-gbti .md-embed-open:focus-visible { outline: 3px solid var(--green); outline-offset: 2px; }
  @media (prefers-reduced-motion: reduce) { .prose-gbti .md-embed-play { transition: none; } }
  /* sow-452: the ```directory block. The bar reuses the Projects directory filter pill (.tfilter); the items are
     the article's own h3 entries, reordered by src/lib/sort-list.mjs. */
  .prose-gbti .sortlist { margin: 1.6em 0 0.4em; --sortlist-top: 0px; --sortlist-bar: 66px; } /* sort-list.mjs sets the real offset and bar height inline */
  /* An entry reached by its link stops under the site header AND the pinned bar, not behind them. */
  .prose-gbti .sortlist :where(h2, h3)[id] { scroll-margin-top: calc(var(--sortlist-top) + var(--sortlist-bar) + 16px); }
  .prose-gbti .sortlist-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; padding: 12px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);
    position: sticky; top: var(--sortlist-top); z-index: 5; background: var(--paper-2); } /* sticky under the site header (sort-list.mjs sets the offset) */
  .prose-gbti .sortlist-lab { font-family: var(--f-mono); font-size: 12px; color: var(--fg-mute); margin-right: 4px; }
  .prose-gbti .sortlist-btn { display: inline-flex; align-items: center; cursor: pointer; font-family: var(--f-mono); font-size: 12px; font-weight: 500; padding: 8px 13px; border-radius: var(--r);
    border: 1.5px solid var(--line-2); color: var(--fg-soft); background: var(--paper); transition: all .15s; white-space: nowrap; }
  .prose-gbti .sortlist-btn:hover { border-color: var(--ink); color: var(--ink); }
  .prose-gbti .sortlist-btn.on { border-color: var(--green); color: var(--green-700); background: var(--green-tint); }
  .prose-gbti .sortlist-btn:focus-visible { outline: 2px solid var(--green); outline-offset: 2px; }
  .prose-gbti .sortlist-count { margin-left: auto; font-family: var(--f-mono); font-size: 12px; color: var(--fg-mute); }
  /* Owner, 2026-10-13: in the category view the categories are sub-filters, a second row inside the sticky bar. On a
     wide screen the row wraps with compact pills, so every category stays visible and clickable with a mouse (a
     sideways-scrolling row clipped the chosen pill there). On a phone or tablet it is one line you swipe, so the pinned bar
     stays short, and sort-list.mjs scrolls the chosen pill into view. Below 900px the column is too narrow for two lines. */
  .prose-gbti .sortlist-sub { flex-basis: 100%; display: flex; flex-wrap: wrap; gap: 6px; padding-top: 4px; }
  .prose-gbti .sortlist-sub[hidden] { display: none; }
  .prose-gbti .sortlist-subbtn { flex: none; padding: 4px 10px; font-family: var(--f-sans); font-size: 12.5px; font-weight: 600; letter-spacing: 0; line-height: 1.5; }
  @media (max-width: 900px) {
    .prose-gbti .sortlist-sub { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; padding-right: 28px;
      -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 28px), transparent); mask-image: linear-gradient(to right, #000 calc(100% - 28px), transparent); }
    .prose-gbti .sortlist-sub::-webkit-scrollbar { display: none; }
  }
  /* Owner, 2026-10-13 (option B of the YouTube sort bar round): ```directory youtube. Grey chips with 8px corners and
     the body face, the chosen sort and category in YouTube red. The red is #e00000, not the brand #ff0000, because white
     14px text on #ff0000 is 4.0:1 and on #e00000 it is 5.0:1. */
  .prose-gbti .sortlist-youtube { --yt-chip: #ecebe9; --yt-chip-hover: #dfddda; --yt-chip-fg: #0f0f0f; --yt-label: #606060; --yt-red: #e00000; --yt-red-hover: #c40000; }
  [data-theme="dark"] .prose-gbti .sortlist-youtube { --yt-chip: #3b3941; --yt-chip-hover: #4a4852; --yt-chip-fg: #f1f1f1; --yt-label: #aaaaaa; }
  .prose-gbti .sortlist-youtube .sortlist-lab { font-family: var(--f-sans); font-size: 13px; font-weight: 600; color: var(--yt-label); }
  .prose-gbti .sortlist-youtube .sortlist-btn { min-height: 40px; padding: 0 14px; border: 0; border-radius: 8px; font-family: var(--f-sans); font-size: 14px; font-weight: 600; letter-spacing: 0; color: var(--yt-chip-fg); background: var(--yt-chip); }
  .prose-gbti .sortlist-youtube .sortlist-subbtn { min-height: 32px; padding: 0 12px; font-size: 13px; }
  .prose-gbti .sortlist-youtube .sortlist-btn:hover { background: var(--yt-chip-hover); color: var(--yt-chip-fg); }
  .prose-gbti .sortlist-youtube .sortlist-btn.on, .prose-gbti .sortlist-youtube .sortlist-btn.on:hover { background: var(--yt-red); color: #ffffff; }
  .prose-gbti .sortlist-youtube .sortlist-btn.on:hover { background: var(--yt-red-hover); }
  .prose-gbti .sortlist-youtube .sortlist-btn:focus-visible { outline: 2px solid var(--yt-red); outline-offset: 2px; }
  @media (max-width: 480px) { .prose-gbti .sortlist-youtube .sortlist-btn { min-height: 36px; padding: 0 10px; font-size: 13px; } .prose-gbti .sortlist-youtube .sortlist-subbtn { min-height: 32px; } }
  .prose-gbti .sortlist-group { margin: 2em 0 0.2em; padding-bottom: 6px; border-bottom: 1px solid var(--line); font-family: var(--f-mono); font-size: 12px; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; color: var(--fg-mute); }
  @media (prefers-reduced-motion: reduce) { .prose-gbti .sortlist-btn { transition: none; } }
</style>

<script>
  // sow-452: a ```directory block becomes a sort bar over the entries after it.
  import { enhanceSortList } from '../../lib/sort-list.mjs';
  // An ```audio block in the card style gets its play button and progress line (client/src/audio-card.mjs).
  import { enhanceAudioCards } from '../../../client/src/audio-card.mjs';
  // sow-470: article tables get their numeric columns aligned, their overflow fade, and (only where the table
  // earns it) column sorting. The table itself is already styled and already scrolls without this.
  import { enhanceTables } from '../../lib/table-enhance.mjs';
  import { embedUrl, embedPosterHtml } from '../../../client/src/video-embed.mjs';
  // ```embed lightbox: the built thumbnail link becomes the poster the comments use; Lightbox.astro opens it.
  document.querySelectorAll<HTMLElement>('.prose-gbti .embed-lightbox').forEach((wrap) => {
    const url = wrap.querySelector('a')?.getAttribute('href') || '';
    const src = embedUrl(url);
    const html = src ? embedPosterHtml(url, { frameSrc: src }) : '';
    if (html) wrap.outerHTML = html;
  });
  document.querySelectorAll('.prose-gbti').forEach((el) => enhanceSortList(el));
  document.querySelectorAll('.prose-gbti').forEach((el) => enhanceAudioCards(el));
  document.querySelectorAll('.prose-gbti').forEach((el) => enhanceTables(el));

  // Code cards: upgrade every fenced code block in rendered prose into a card with a language tag + a
  // working Copy button (the same enhancement the extension reader applies, so the two surfaces match).
  // Runs once per page; shiki emits data-language on the <pre>.
  (() => {
    document.querySelectorAll('.prose-gbti pre').forEach((pre) => {
      if (pre.closest('.code-card')) return; // already enhanced (defensive against double-run)
      const code = pre.querySelector('code');
      const card = document.createElement('div');
      card.className = 'code-card';
      const bar = document.createElement('div');
      bar.className = 'code-bar';
      const tag = document.createElement('span');
      tag.className = 'code-lang';
      tag.textContent = pre.getAttribute('data-language') || 'code';
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'code-copy';
      btn.textContent = 'Copy';
      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(code ? code.innerText : pre.innerText);
          btn.textContent = 'Copied';
        } catch {
          btn.textContent = 'Copy failed';
        }
        setTimeout(() => { btn.textContent = 'Copy'; }, 1200);
      });
      bar.append(tag, btn);
      pre.replaceWith(card);
      card.append(bar, pre);
    });
  })();
</script>
