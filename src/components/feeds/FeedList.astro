---
// sow-131: the shared feed list. Server-renders the items in page CHUNKS with a ladder pager row
// after every chunk except the last (only chunk 1 + its pager start visible). Clicking Next converts
// the clicked pager into an empty separator box of the same dimensions (owner directive, 2026-07-21),
// reveals the next chunk below it, and reveals that chunk's own pager below the new items. Earlier
// pages stay on screen, so the ladder has no Prev. JS only toggles hidden + swaps classes; nothing is
// built in the DOM. Rows carry data-visibility + data-tags so the /feeds/ chrome (FeedView) can filter
// them client-side; when a filter is active FeedView flattens the ladder (all chunks shown, pagers +
// separators hidden) and restores it on clear.
import Avatar from '../Avatar.astro';
import FavoriteButton from '../FavoriteButton.astro';
import CollectionButton from '../CollectionButton.astro';
import { authorDisplay, authorHref } from '../../lib/authors';
import { authorItem } from '../../lib/avatars';
import type { AvatarIndex } from '../../lib/avatars';
import type { FeedItem } from '../../lib/feed-items';
import { chunkPages, relativeTime } from '../../lib/home-feed.mjs';
import { catsAttr } from '../../lib/feed-filter.mjs';

interface Props {
  items: FeedItem[];
  avatarIndex: AvatarIndex;
  pageSize?: number;
  /** Insert the condensed join CTA after this row index inside chunk 1 (omit for none). */
  ctaAfter?: number;
}
const { items, avatarIndex, pageSize = 10, ctaAfter } = Astro.props;

const chunks = chunkPages(items, pageSize) as FeedItem[][];
const pages = chunks.length;
const NOW = Date.now();
const kindLabel: Record<string, string> = { article: 'article', project: 'project', prompt: 'prompt' };
const tagsAttr = (it: FeedItem) => (it.tags ?? []).map((t) => String(t).trim().toLowerCase()).filter(Boolean).join(' ');
// sow-174: every segment of the category path, so a breadcrumb at any depth can drill down here.
const catsOf = (it: FeedItem) => catsAttr(it.categories);
---
<div class="feed-list" data-feedlist>
  {chunks.map((chunk, ci) => (
    <>
      <div class="feed-chunk" data-chunk={ci} hidden={ci > 0}>
        {chunk.map((it, ri) => (
          <>
            <article
              class:list={['feed-item', !it.cover && 'nocover']}
              data-fi
              data-kind={it.kind}
              data-author={it.author}
              data-comments={it.comments ?? 0}
              data-visibility={it.stub ? 'members' : 'public'}
              data-tags={tagsAttr(it)}
              data-cats={catsOf(it)}
              data-share-slug={it.kind === 'share' ? it.slug : undefined}
            >
              <div class="feed-main">
                <div class="feed-meta">
                  <Avatar item={authorItem(it.author, avatarIndex)} class="av" size={26} />
                  <span class="tmeta"><a class="who" href={authorHref(it.author)}>{authorDisplay(it.author)}</a><span class="dotsep"></span>{relativeTime(it.date, NOW)}</span>
                  {it.kind === 'share'
                    ? <span class="kind-tag kt-share">shared{it.srcDomain ? ` · ${it.srcDomain}` : ''}</span>
                    : <span class={`kind-tag kt-${it.kind}`}>{kindLabel[it.kind]}</span>}
                  {it.stub && <span class="kind-tag kt-members">members</span>}
                </div>
                <h2 class="feed-title">
                  {it.href
                    ? <a href={it.href} target={it.external ? '_blank' : undefined} rel={it.external ? 'noopener nofollow' : undefined}>{it.title}</a>
                    : it.title}
                </h2>
                {it.excerpt && <p class="feed-ex">{it.excerpt}</p>}
                <div class="feed-foot">
                  {/* Save / collect / follow are free member perks (sow-060), so they act for any signed-in
                      member and drive sign-up for a signed-out visitor (the light-DOM [data-signin] pills open
                      the SigninModal until the feed bootstrap upgrades them for a member). */}
                  {!it.stub && <FavoriteButton targetType={it.targetType} targetSlug={it.slug} count={it.favorites} size="sm" />}
                  {!it.stub && <CollectionButton targetType={it.targetType} targetSlug={it.slug} size="sm" />}
                  {!it.stub && (
                    <span class="feed-follow" data-follow-user={it.author}>
                      <button type="button" class="follow-pill" data-signin data-tooltip="Follow" aria-label={`Follow ${authorDisplay(it.author)}`}>
                        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><use href="#ico-mega"/></svg>
                        <span class="follow-t">Follow</span>
                      </button>
                    </span>
                  )}
                  <span class="rx rx-static"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#ico-chat"/></svg> {it.comments}<span class="sr-only"> comments</span></span>
                  <span class="fsp"></span>
                </div>
              </div>
              {/* A real cover renders in every density; the branded thumb fallback (feed-cover-fb)
                  exists only for the card grid, where an imageless tile would break the rhythm. */}
              {/* sow-278: THE FIRST CARD'S COVER IS THE LCP ELEMENT and it is the slowest thing the site
                  measures, p75 2,840ms in Cloudflare RUM, because it was lazy like the other 290 images on
                  the page. Astro defaults to lazy and nothing had ever overridden it, so a hero inherited a
                  default meant for thumbnails. Field data across the whole site showed lcpFetchPriority was
                  only ever `n/a` or `auto`, never `high`.
                  EXACTLY ONE IMAGE IS PROMOTED, and the narrowness IS the optimisation: telling the browser
                  that everything matters is identical to telling it that nothing does. Widening this past
                  the first card would undo it, which is what the guard test in test/feed-lcp-priority.test.mjs
                  exists to prevent. */}
              {(it.cover || it.thumb) && (it.href
                ? <a class:list={['feed-cover', !it.cover && 'feed-cover-fb']} href={it.href} target={it.external ? '_blank' : undefined} rel={it.external ? 'noopener nofollow' : undefined} aria-hidden="true" tabindex="-1"><img src={it.cover ?? it.thumb} alt="" loading={ci === 0 && ri === 0 ? 'eager' : 'lazy'} fetchpriority={ci === 0 && ri === 0 ? 'high' : undefined} decoding="async" /></a>
                : <span class:list={['feed-cover', !it.cover && 'feed-cover-fb']}><img src={it.cover ?? it.thumb} alt="" loading={ci === 0 && ri === 0 ? 'eager' : 'lazy'} fetchpriority={ci === 0 && ri === 0 ? 'high' : undefined} decoding="async" /></span>)}
            </article>
            {ci === 0 && ctaAfter !== undefined && ri === ctaAfter && (
              <aside class="feed-cta" aria-label="Join the GBTI Network">
                <slot name="cta" />
              </aside>
            )}
          </>
        ))}
      </div>
      {ci < pages - 1 && (
        <nav class="pager" data-ladder data-chunk={ci} aria-label="Load more feed items" hidden={ci > 0}>
          <span class="pos">{ci + 1} / {pages}</span>
          <button type="button" data-ladder-next>Next <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#ico-arrow"/></svg></button>
        </nav>
      )}
    </>
  ))}
</div>

<script>
  // The ladder: consume the clicked pager (same-dimension empty separator box), reveal the next chunk
  // and its pager. Delegated per list so multiple feed lists on one site share one bundled handler.
  document.querySelectorAll<HTMLElement>('[data-feedlist]').forEach((list) => {
    list.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('[data-ladder-next]');
      if (!btn) return;
      const pager = btn.closest<HTMLElement>('[data-ladder]');
      if (!pager) return;
      const i = Number(pager.dataset.chunk);
      pager.classList.add('pager-done');
      pager.replaceChildren();
      pager.removeAttribute('aria-label');
      pager.setAttribute('aria-hidden', 'true');
      const nextChunk = list.querySelector<HTMLElement>(`.feed-chunk[data-chunk="${i + 1}"]`);
      if (nextChunk) nextChunk.hidden = false;
      const nextPager = list.querySelector<HTMLElement>(`[data-ladder][data-chunk="${i + 1}"]`);
      if (nextPager) nextPager.hidden = false;
    });
  });
</script>

<style is:global>
  /* The follow pill mirrors the sm favorite/collection pills. Its sibling gbti-subscribe renders a fixed large
     "Subscribe to activity" toggle that does not fit the feed foot, so the pill drives client.setFollow directly
     over the same free-tier follow store; the feed bootstrap toggles .on. Unique class, so is:global is safe. */
  .feed-follow { display: inline-flex; }
  .follow-pill {
    display: inline-flex; align-items: center; gap: 6px; cursor: pointer;
    font-family: var(--f-mono); font-size: 12px; font-weight: 600; color: var(--fg-mute);
    background: var(--paper); border: 1.5px solid var(--line-2); border-radius: var(--r-pill);
    padding: 4px 9px; transition: color .15s ease, border-color .15s ease;
  }
  .follow-pill:hover { color: var(--green-700); border-color: var(--green); }
  .follow-pill svg { flex: none; }
  .follow-pill.on { color: var(--green-700); border-color: var(--green); background: var(--green-tint); }
  [data-theme="dark"] .follow-pill { background: transparent; border-color: var(--line-dark-2); color: var(--on-dark-soft); }
  [data-theme="dark"] .follow-pill:hover,
  [data-theme="dark"] .follow-pill.on { color: var(--green-mint); border-color: var(--green); }
</style>

<script>
  // Feed member actions (owner 2026-08-27): save / collect / follow act for any signed-in member and drive
  // sign-up for a signed-out visitor. Mirrors Comments.astro / SubscribeButton: a cookie session upgrades the
  // inert client-ui elements and wires the follow pills; an anonymous visitor resolves to null, nothing loads,
  // and the [data-signin] fallbacks keep opening the SigninModal. Free-tier is admitted server-side (sow-060:
  // follows via authorizeMember, favorite/collection via authorizeMemberCheap; both deny banned).
  import { onMemberSignal, currentIdentity, readMemberSignal } from '../../lib/member-signal';

  function readCookie(name: string): string | null {
    for (const part of document.cookie.split(';')) {
      const eq = part.indexOf('=');
      if (eq >= 0 && part.slice(0, eq).trim() === name) return part.slice(eq + 1).trim() || null;
    }
    return null;
  }

  function setFollowState(btn: HTMLElement, on: boolean) {
    btn.classList.toggle('on', on);
    const t = btn.querySelector('.follow-t');
    if (t) t.textContent = on ? 'Following' : 'Follow';
    btn.setAttribute('aria-pressed', String(on));
  }

  let wired = false;
  async function upgradeFeedActions(signal: any) {
    if (!signal || !signal.login || !readCookie('gbti_csrf')) return; // signed-out / extension-only: leave inert
    if (wired) return;
    wired = true;
    const mine = String(signal.login).toLowerCase();
    const signupBase = document.documentElement.dataset.signupBase || '';
    const { createWorkbenchClient } = await import('../../lib/workbench-client');
    const client = createWorkbenchClient({ signupBase, login: String(signal.login), githubId: signal.githubId != null ? String(signal.githubId) : null });
    const { setClient } = await import('../../../client-ui/src/base.mjs');
    setClient(client);
    // Upgrade the inert favorite + collection pills (they read no per-item state on connect, so upgrading
    // every row is cheap; the follow list is fetched once in wireFollows).
    await Promise.all([
      import('../../../client-ui/src/elements/gbti-favorite.mjs'),
      import('../../../client-ui/src/elements/gbti-collection.mjs'),
    ]);
    wireFollows(client, mine);
  }

  async function wireFollows(client: any, mine: string) {
    const byUser = new Map<string, HTMLElement[]>();
    document.querySelectorAll<HTMLElement>('.feed-follow').forEach((wrap) => {
      const user = (wrap.dataset.followUser || '').trim().toLowerCase();
      const btn = wrap.querySelector<HTMLElement>('.follow-pill');
      if (!btn) return;
      if (!user || user === mine) { wrap.style.display = 'none'; return; } // no follow-yourself
      btn.removeAttribute('data-signin'); // signed-in: our handler owns the click, not the SigninModal
      const list = byUser.get(user) ?? [];
      list.push(btn);
      byUser.set(user, list);
    });
    if (!byUser.size) return;
    let following = new Set<string>();
    try {
      const r = await client.getFollows();
      const arr = Array.isArray(r) ? r : (r?.following ?? []);
      following = new Set(arr.map((e: any) => (e?.username || '').toLowerCase()).filter(Boolean));
    } catch { /* leave all unfollowed; a click still attempts the toggle */ }
    for (const [user, btns] of byUser) {
      const on = following.has(user);
      for (const b of btns) {
        setFollowState(b, on);
        b.addEventListener('click', (e) => { e.preventDefault(); toggleFollow(client, user, btns); });
      }
    }
  }

  async function toggleFollow(client: any, user: string, btns: HTMLElement[]) {
    const next = !btns[0].classList.contains('on');
    btns.forEach((b) => { setFollowState(b, next); (b as HTMLButtonElement).disabled = true; }); // optimistic, all rows by this author
    try {
      const r = await client.setFollow({ username: user, on: next });
      const arr = Array.isArray(r) ? r : (r?.following ?? null);
      const truth = arr ? arr.some((e: any) => (e?.username || '').toLowerCase() === user) : next;
      btns.forEach((b) => setFollowState(b, truth));
    } catch {
      btns.forEach((b) => setFollowState(b, !next)); // revert
    } finally {
      btns.forEach((b) => { (b as HTMLButtonElement).disabled = false; });
    }
  }

  upgradeFeedActions(currentIdentity(readMemberSignal()));
  onMemberSignal(upgradeFeedActions);
</script>
