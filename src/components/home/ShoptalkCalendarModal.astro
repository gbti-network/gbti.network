---
// sow-302 Phase 2: the Add to calendar chooser. Owner feedback on sow-191, which shipped an .ics that
// DOWNLOADS: "not a good experience. We need a way for them to add it to their cal from the browser."
//
// Three rows (owner decision 2026-09-01): Google, Outlook, and the file. Apple Calendar has no web deep link,
// so "Apple" and "download" are the same row, and the file is the native path on that platform anyway.
// Auto-detect was REJECTED: it guesses from the device and gets the common iPhone-plus-Google-Calendar
// pairing wrong, with no recovery once it has guessed.
//
// The links are built HERE, at build time, from the same normalized event the .ics uses. house/shoptalk.yml
// stays the one source: a second hardcoded time in a URL is the defect this whole design exists to prevent,
// and test/shoptalk-ics.test.mjs asserts the Google link and the .ics agree on start, end and recurrence.
//
// PROGRESSIVE ENHANCEMENT is load-bearing, not a nicety. The CTA is an <a href="/shoptalk.ics"> that works
// with JavaScript off. This dialog needs showModal(), so the handler in index.astro preventDefault()s only
// when the dialog is actually available; otherwise the anchor does what it does today. Replacing the anchor
// with a <button> would have turned a working control into nothing for those readers, silently.
import { loadShoptalk } from '../../lib/shoptalk';
import { googleCalendarUrl, outlookCalendarUrl } from '../../lib/shoptalk-core.mjs';

const event = loadShoptalk();
const google = googleCalendarUrl(event);
const outlook = outlookCalendarUrl(event);
---

<dialog class="sc" data-shoptalk-cal aria-labelledby="sc-title">
  <div class="sc-card">
    <header class="sc-head">
      <div>
        <div class="sc-eyebrow">Add to calendar</div>
        <h2 class="sc-title" id="sc-title">{event.cardTitle}</h2>
      </div>
      <button type="button" class="sc-x" data-sc-close aria-label="Close">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      </button>
    </header>

    <p class="sc-when">{event.cardTitle} runs every Saturday.</p>

    {/* sow-466: the SEAT block. Everything below it copies the event onto the member's own calendar, which is
        useful and is not the same thing as being on the call: a copy carries no Google Meet link and nobody
        on it is a guest of the real event. A signed-in member clicking "Add to calendar" means "put me on the
        call", so that is what this offers first, and the copy rows keep their place underneath.

        Inert until the dialog opens for a member. A signed-out visitor, and anyone with JavaScript off, sees
        exactly the three rows this dialog has always had. */}
    <section class="sc-seat" data-sc-seat hidden>
      <h3 class="sc-seat-h" data-sc-headline></h3>
      <p class="sc-seat-b" data-sc-body></p>
      <form class="sc-addr" data-sc-addr hidden>
        <label class="sc-addr-l" for="sc-addr-input" data-sc-addr-label></label>
        <div class="sc-addr-row">
          <input class="sc-addr-i" id="sc-addr-input" type="email" inputmode="email" autocomplete="email"
                 spellcheck="false" placeholder="you@example.com" data-sc-addr-input />
          <button class="sc-addr-go" type="submit" data-sc-addr-go></button>
        </div>
        <p class="sc-note" data-sc-addr-hint></p>
      </form>
      <p class="sc-note sc-seat-note" data-sc-note hidden></p>
      <button class="sc-seat-act" type="button" data-sc-action hidden></button>
      <a class="sc-seat-link" data-sc-href hidden></a>
    </section>

    <p class="sc-sub" data-sc-copy-head hidden>Or keep a copy on your own calendar. A copy is not a seat on the
      call: it carries no Meet link and does not put you on the guest list.</p>

    <ul class="sc-list">
      <li>
        <a class="sc-row" href={google} target="_blank" rel="noopener">
          <span class="sc-name">Google Calendar</span>
          <span class="sc-note">Adds every Saturday.</span>
        </a>
      </li>
      <li>
        <a class="sc-row" href={outlook} target="_blank" rel="noopener">
          <span class="sc-name">Outlook</span>
          {/* sow-302: Outlook's compose deep link has NO recurrence parameter, so it can only create the first
              occurrence. Saying so HERE is the point: without it the member finds out next Saturday, when
              nothing appears, and reads it as our bug rather than a limitation of the link. */}
          <span class="sc-note">Adds the next call only. Outlook cannot take a repeating event from a link.</span>
        </a>
      </li>
      <li>
        <a class="sc-row" href="/shoptalk.ics">
          <span class="sc-name">Apple Calendar, or download the file</span>
          <span class="sc-note">Adds every Saturday. Works with any calendar app.</span>
        </a>
      </li>
    </ul>
  </div>
</dialog>

<style>
  /* Centered on purpose: the site's global reset zeroes every margin, which strips the browser's own
     `margin: auto` that centres a modal dialog, so without this the chooser sat in the top-left corner
     (owner screenshot, 2026-09-11). inset: 0 + margin: auto is the native centring, restated. */
  .sc { border: 0; padding: 0; background: transparent; max-width: min(92vw, 26rem); position: fixed; inset: 0; margin: auto; }
  .sc::backdrop { background: rgb(0 0 0 / 0.5); }
  /* sow-366: --bg-1, --bg-2 and --accent were never tokens. Their light fallbacks made the card WHITE in
     both themes while --fg, which is a real token, flipped to near-white in dark: white on white, and the
     chooser was unreadable (owner screenshot, 2026-09-19). The real surface tokens are --paper (a card) and
     --tint (its hover), and both flip. A fallback on a token that does not exist is what hid this in light. */
  /* sow-466: the seat block made this dialog tall enough to run off a laptop screen, so the card scrolls
     rather than overflowing the viewport with its own close button out of reach. */
  .sc-card { background: var(--paper); color: var(--fg); border: 1px solid var(--line); border-radius: 14px; padding: 20px; max-height: 86vh; overflow-y: auto; }
  .sc-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
  .sc-eyebrow { font-size: 12px; letter-spacing: .06em; text-transform: uppercase; color: var(--fg-mute); }
  .sc-title { margin: 2px 0 0; font-size: 20px; }
  .sc-x { background: none; border: 0; color: var(--fg-mute); cursor: pointer; padding: 4px; border-radius: 8px; }
  .sc-x:hover { color: var(--fg); }
  .sc-when { margin: 10px 0 14px; color: var(--fg-mute); font-size: 14px; }
  .sc-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .sc-row { display: block; padding: 12px 14px; border: 1px solid var(--line); border-radius: 10px; text-decoration: none; color: inherit; }
  .sc-row:hover, .sc-row:focus-visible { border-color: var(--green); background: var(--tint); }
  .sc-name { display: block; font-weight: 600; }
  .sc-note { display: block; margin-top: 2px; font-size: 13px; color: var(--fg-mute); }
  /* sow-466: the seat block. [hidden] is restated against the explicit displays below, which otherwise win. */
  .sc-seat[hidden], .sc-addr[hidden], .sc-note[hidden], .sc-seat-act[hidden], .sc-seat-link[hidden], .sc-sub[hidden] { display: none; }
  .sc-seat { border: 1px solid var(--line); border-radius: 10px; padding: 14px; margin-bottom: 14px; background: var(--tint); }
  .sc-seat-h { margin: 0; font-size: 15px; font-weight: 600; }
  .sc-seat-b { margin: 4px 0 0; font-size: 13px; color: var(--fg-mute); }
  .sc-addr { display: block; margin-top: 10px; }
  .sc-addr-l { display: block; font-size: 12px; letter-spacing: .04em; text-transform: uppercase; color: var(--fg-mute); }
  .sc-addr-row { display: flex; gap: 8px; margin-top: 4px; flex-wrap: wrap; }
  .sc-addr-i { flex: 1 1 11rem; min-width: 0; padding: 8px 10px; border: 1px solid var(--line); border-radius: 8px; background: var(--paper); color: var(--fg); font: inherit; font-size: 14px; }
  .sc-addr-go { flex: 0 0 auto; padding: 8px 12px; border: 1px solid var(--green); border-radius: 8px; background: var(--green); color: #fff; font: inherit; font-size: 14px; font-weight: 600; cursor: pointer; }
  .sc-addr-go:disabled { opacity: .6; cursor: default; }
  .sc-seat-act { margin-top: 10px; padding: 6px 10px; border: 1px solid var(--line); border-radius: 8px; background: none; color: var(--fg-mute); font: inherit; font-size: 13px; cursor: pointer; }
  .sc-seat-act:hover:not(:disabled) { color: var(--fg); border-color: var(--green); }
  .sc-seat-link { display: inline-block; margin-top: 10px; font-size: 13px; color: var(--green); }
  .sc-sub { margin: 0 0 10px; font-size: 13px; color: var(--fg-mute); }
</style>

<script is:inline>
  (function () {
    var dialog = document.querySelector('[data-shoptalk-cal]');
    if (!dialog) return;
    // Close on the X and on a backdrop click, mirroring PersonalizeModal. Escape is native to <dialog>.
    dialog.addEventListener('click', function (e) {
      if (e.target === dialog) { dialog.close(); return; }
      if (e.target.closest && e.target.closest('[data-sc-close]')) dialog.close();
    });
    // Focus returns to the CTA on close, so a keyboard user is not dumped at the top of the page.
    dialog.addEventListener('close', function () {
      var cta = document.querySelector('[data-shoptalk-cta]');
      if (cta && typeof cta.focus === 'function') cta.focus();
    });
  })();
</script>

<script>
  // sow-466: the seat block. The member asked to be on the call, so this talks to the real event rather than
  // composing a copy. It is a MODULE script, not the inline one above, because it imports the same pure card
  // helpers and the same website client the account page uses: one state machine, two surfaces.
  //
  // Nothing here runs until the dialog is opened BY A MEMBER (index.astro dispatches gbti:shoptalk-open after
  // showModal, and only on the member path). A visitor never triggers a Worker read, and the three copy rows
  // below are untouched either way.
  import { shoptalkCardState, shoptalkAfterAction, shoptalkAddressLine } from '../../lib/shoptalk-card-core.mjs';
  import { readMemberSignal, currentIdentity } from '../../lib/member-signal';

  const dialog = document.querySelector('[data-shoptalk-cal]') as HTMLDialogElement | null;
  const seat = document.querySelector('[data-sc-seat]') as HTMLElement | null;
  if (dialog && seat) {
    const form = seat.querySelector('[data-sc-addr]') as HTMLFormElement | null;
    const input = seat.querySelector('[data-sc-addr-input]') as HTMLInputElement | null;
    const go = seat.querySelector('[data-sc-addr-go]') as HTMLButtonElement | null;
    const note = seat.querySelector('[data-sc-note]') as HTMLElement | null;
    const act = seat.querySelector('[data-sc-action]') as HTMLButtonElement | null;
    const copyHead = document.querySelector('[data-sc-copy-head]') as HTMLElement | null;
    let client: any = null;
    let loaded = false;

    function paint(res: any) {
      const st = shoptalkCardState(res);
      const h = seat!.querySelector('[data-sc-headline]'); if (h) h.textContent = st.headline;
      const b = seat!.querySelector('[data-sc-body]'); if (b) b.textContent = st.body;
      if (act) { act.hidden = !st.action; act.textContent = st.actionLabel || ''; act.dataset.action = st.action || ''; act.disabled = false; }
      const a = seat!.querySelector('[data-sc-href]') as HTMLAnchorElement | null;
      if (a) { a.hidden = !st.href; if (st.href) { a.href = st.href; a.textContent = st.hrefLabel || ''; } }
      const line = shoptalkAddressLine(res);
      if (form && input && go) {
        form.hidden = !line;
        if (line) {
          const l = seat!.querySelector('[data-sc-addr-label]'); if (l) l.textContent = line.label;
          const hint = seat!.querySelector('[data-sc-addr-hint]'); if (hint) hint.textContent = line.hint;
          // Only ever seeded, never overwritten mid-edit: a repaint after a save must not wipe what they typed.
          if (document.activeElement !== input) input.value = line.value;
          go.textContent = line.cta;
          go.disabled = false;
        }
      }
      seat!.hidden = false;
      if (copyHead) copyHead.hidden = false;
    }

    function say(text: string) { if (note) { note.textContent = text; note.hidden = false; } }

    async function load() {
      if (loaded) return;
      loaded = true;
      try {
        const signal = currentIdentity(readMemberSignal());
        const { websiteClient } = await import('../../lib/save-controls');
        client = await websiteClient(signal);
        // A failed load must not look like "not tried": reset the latch so opening the dialog again retries,
        // rather than leaving the member staring at a block that never fills in.
        if (!client) { loaded = false; return; }
        paint(await client.getShoptalk());
      } catch { loaded = false; }
    }

    dialog.addEventListener('gbti:shoptalk-open', load);

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!client || !input) return;
      const address = input.value.trim();
      if (!address) return;
      if (go) go.disabled = true;
      try {
        const res = await client.setShoptalk('rejoin', address);
        say(shoptalkAfterAction(res, 'rejoin').note);
        paint(await client.getShoptalk());
      } catch (err: any) {
        say(err?.message || 'That did not go through. Try again in a moment.');
        if (go) go.disabled = false;
      }
    });

    act?.addEventListener('click', async () => {
      const action = act.dataset.action as 'leave' | 'rejoin';
      if (!client || !action) return;
      act.disabled = true;
      try {
        const res = await client.setShoptalk(action);
        say(shoptalkAfterAction(res, action).note);
        paint(await client.getShoptalk());
      } catch (err: any) {
        say(err?.message || 'That did not go through. Try again in a moment.');
        act.disabled = false;
      }
    });
  }
</script>
