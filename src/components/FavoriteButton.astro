---
// FavoriteButton (SOW-013, store updated by SOW-024): the INERT favorite control. Ships in the public static
// build carrying only public data-gbti-* hooks (target type/slug + the build-time count, read from
// house/favorite-counts.yml). A plain visitor sees a heart + count; the light-DOM button is [data-signin], so
// clicking opens the sign-in modal (SOW-019) — favoriting requires a GitHub identity, so there is no anonymous
// public path, by design. When a member's client/extension loads @gbti/client-ui, <gbti-favorite> upgrades into
// a working toggle that writes the DELETABLE edge store (KV), NOT git (SOW-024). The displayed count refreshes
// on the next reconcile + batched build (two-tier model, like comments).
interface Props {
  targetType: 'post' | 'project' | 'prompt' | 'share'; // SOW-050 P3: Shares are a first-class basket type
  targetSlug: string;
  count?: number;
  size?: 'sm' | 'md' | 'rail'; // sow-179: 'rail' is the icon-only 38px button for the Editorial/Journal sticky rail
  inert?: boolean; // sow-434: the invitation preview's disabled copy, see below
}
const { targetType, targetSlug, count = 0, size = 'md', inert = false } = Astro.props;
// sow-434: `inert` is the invitation preview's copy (/claim/), for a listing nobody has published yet. The markup
// stays the same elements in the same order, and every live hook is switched off attribute by attribute, so the
// default output is byte for byte what it was (test/claim-render.test.mjs pins the template; a site build diffed
// before and after proved it). Wrapping either version in a conditional would not do: Astro drops the whitespace
// between elements inside an expression, which changes the published markup.
// Inert, the host is a plain <span> rather than <gbti-favorite>: save-controls.ts upgrades ANY <gbti-favorite> on the
// page, and the claimant is signed in, so a real tag would write a favorite against a slug nobody has published.
// No data-gbti-* hooks, no data-signin, and the button is disabled with the one tooltip.
const Host = inert ? 'span' : 'gbti-favorite';
const live = <T,>(v: T): T | undefined => (inert ? undefined : v);
---
<Host
  data-gbti-target-type={live(targetType)}
  data-gbti-target-slug={live(targetSlug)}
  data-gbti-count={live(count)}
  data-gbti-size={live(size)}
  data-gbti-region={live('favorite')}
  class:list={['gbti-favorite', size === 'sm' && 'fav-sm', size === 'rail' && 'fav-rail']}
  style={inert ? 'display:inline-flex' : undefined}
>
  <button type="button" class="fav-pill" data-signin={live('')} disabled={inert || undefined} aria-disabled={inert ? 'true' : undefined} style={inert ? 'cursor:not-allowed' : undefined} data-tooltip={inert ? 'Available once published' : 'Favorite'} aria-label={inert ? `Favorite this ${targetType}, available once published` : `Favorite this ${targetType}${count > 0 ? `, ${count} so far` : ''}`}>
    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><use href="#ico-heart" /></svg>
    {count > 0 && <span class="fav-count">{count}</span>}
  </button>
</Host>
<style is:global>
  /* The light-DOM pill is the public (inert) display; when <gbti-favorite> upgrades, its Shadow DOM covers it. */
  gbti-favorite { display: inline-flex; }
  .fav-pill {
    display: inline-flex; align-items: center; gap: 6px; cursor: pointer;
    font-family: var(--f-mono); font-size: 12.5px; font-weight: 600; color: var(--fg-mute);
    background: var(--paper); border: 1.5px solid var(--line-2); border-radius: var(--r-pill);
    padding: 5px 11px; transition: color .15s ease, border-color .15s ease;
  }
  .fav-pill:hover { color: var(--green-700); border-color: var(--green); }
  .fav-pill svg { flex: none; }
  .fav-sm .fav-pill { padding: 4px 9px; font-size: 12px; }
  /* sow-179: icon-only, count stacked below, matching the sticky rail's 38px rounded-square buttons. */
  .fav-rail .fav-pill {
    flex-direction: column; gap: 2px; width: 38px; height: 38px; padding: 0; justify-content: center;
    border-radius: 7px; background: var(--paper-2); font-size: 10.5px;
  }
  [data-theme="dark"] .fav-pill { background: transparent; border-color: var(--line-dark-2); color: var(--on-dark-soft); }
  [data-theme="dark"] .fav-pill:hover { color: var(--green-mint); border-color: var(--green); }
  [data-theme="dark"] .fav-rail .fav-pill { background: var(--paper-2); }
</style>
