---
// sow-323 Phase 4: APPROVE THIS FOR THE PUBLIC SITE, on the item's own page.
//
// The queue in the admin area lists what is waiting, but a superadmin decides by READING the thing, and the
// place they read it is the page itself. Without this the decision means opening a second screen and matching
// a title by eye, which is how the wrong item gets approved.
//
// SUPERADMIN ONLY, and only on a members-only item: an approved item has nothing left to approve. The control
// renders hidden and is revealed client-side from the member signal, exactly as the Edit pill beside it is
// (wireEditAffordance), because these pages are static and cached. This is UX, never the boundary: the Worker
// re-checks superadmin on every call.
import { contentRepoPath, isApprovable } from '../lib/content';

interface Props {
  type: 'post' | 'project' | 'prompt';
  owner: string;
  slug: string;
  visibility?: string;
  /**
   * `hero` for a page whose header is a full-bleed image (the project detail, an article with a cover).
   *
   * Without positioning the pill is a flex item in the hero's own flow, which drops it at the hero's
   * bottom-left across the project artwork and straddling the hero's bottom edge: measured at 1280px on
   * 2026-10-16, x=69 y=274, while Edit sat at x=201 y=225, their centres 46px apart. It is NOT painted under
   * the cover image, which a first reading of this assumed; a hit test at its centre returns the pill. It is
   * simply in the wrong place and in the artwork's way. Edit had escaped that alone with position:absolute,
   * so the two now share one positioned row (.pd-hero-tools) rather than each solving it separately.
   */
  placement?: 'hero' | 'flow';
}
const { type, owner, slug, visibility, placement = 'flow' } = Astro.props as Props;
// Only a members-only item can be approved. Silence is public (the schema default), so anything that is not
// explicitly members has nothing waiting on it.
const path = isApprovable(visibility) ? contentRepoPath(type, owner, slug) : null;
---

{path && (
  <button type="button" class:list={['detail-approve', placement === 'hero' && 'detail-approve-hero']} data-approve-item data-approve-path={path} hidden>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 13 4 4L19 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
    <span data-approve-label>Approve for the public site</span>
  </button>
)}

<style>
  .detail-approve {
    display: inline-flex; align-items: center; gap: 6px;
    font: inherit; font-size: 13px; font-weight: 700; line-height: 1;
    padding: 7px 12px; border-radius: 999px; cursor: pointer;
    background: none; border: 1.5px solid var(--green, #1f9e5f); color: var(--green-700);
  }
  .detail-approve:hover:not([disabled]) { background: var(--green, #1f9e5f); color: #fff; }
  .detail-approve[disabled] { opacity: .55; cursor: default; }
  .detail-approve svg { width: 15px; height: 15px; flex: none; }
  .detail-approve[hidden] { display: none !important; }

  /* On a photographic hero, borrow Edit's glass treatment (gbti-v3-detail.css .pd-hero-edit) rather than
     inventing a second look: white on blurred ink reads on any cover image, where the green-on-transparent
     flow variant does not. Positioning is the row's job (.pd-hero-tools), not this button's. */
  .detail-approve-hero {
    color: #fff; border-color: rgba(255, 255, 255, .38);
    background: rgba(37, 35, 43, .45); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
    padding: 9px 16px; font-weight: 600;
  }
  .detail-approve-hero:hover:not([disabled]) { background: var(--green, #1f9e5f); border-color: var(--green, #1f9e5f); color: #fff; }
  @media (max-width: 480px) { .detail-approve { font-size: 12.5px; padding: 6px 10px; } }
</style>

<script>
  import { readMemberSignal, currentIdentity, onMemberSignal } from '../lib/member-signal';
  import { decidePrompt } from '../../client-ui/src/editorial-queue-view.mjs';

  const btn = document.querySelector<HTMLButtonElement>('[data-approve-item]');
  if (btn) {
    const path = btn.getAttribute('data-approve-path') || '';
    const label = btn.querySelector('[data-approve-label]');
    const readCookie = (name: string) => document.cookie.split('; ').find((c) => c.startsWith(`${name}=`))?.slice(name.length + 1) || '';

    // A SUPERADMIN ALWAYS SEES THIS, website session or not (owner, 2026-10-16: "Superadmin should be able to
    // approve from the listing page itself"). It used to hide whenever gbti_csrf was absent, which is the case
    // for an identity stamped by the EXTENSION: that signal proves who you are but carries no web session, so
    // the call cannot be authenticated. Hiding was the safe answer and the wrong one, because the control then
    // vanishes with no way to tell a missing session from a missing feature, which is exactly how this was
    // reported. Now it says what is needed and sends you there. Still UX only: the Worker re-checks superadmin
    // on every call, so showing the button to the wrong person grants nothing.
    const signedInHere = () => Boolean(readCookie('gbti_csrf'));
    const apply = (identity: any) => {
      const superadmin = Boolean(identity && identity.role === 'superadmin');
      btn.hidden = !superadmin;
      btn.dataset.needsSignin = superadmin && !signedInHere() ? '1' : '';
      if (label) label.textContent = superadmin && !signedInHere()
        ? 'Sign in here to approve'
        : 'Approve for the public site';
    };
    apply(currentIdentity(readMemberSignal()));
    onMemberSignal(apply);

    btn.addEventListener('click', async () => {
      // No web session: open the site's own sign-in rather than making a call that cannot be authenticated.
      // /login/ is where the header's Sign in goes, and SigninModal intercepts any [data-signin] click, so this
      // works whether or not the dialog is on the page.
      if (btn.dataset.needsSignin === '1') {
        const opener = document.querySelector<HTMLElement>('[data-signin]');
        if (opener) opener.click(); else window.location.href = '/login/';
        return;
      }
      const title = document.querySelector('h1')?.textContent?.trim() || '';
      if (!confirm(decidePrompt({ title }, 'approve'))) return;
      btn.disabled = true;
      if (label) label.textContent = 'Approving...';
      try {
        const signupBase = document.documentElement.dataset.signupBase || '';
        const signal = currentIdentity(readMemberSignal());
        const { createWorkbenchClient } = await import('../lib/workbench-client');
        const client = createWorkbenchClient({
          signupBase,
          login: String(signal?.login || ''),
          username: String(signal?.username || signal?.login || ''),
          githubId: signal?.githubId != null ? String(signal.githubId) : null,
          isSuperadmin: true,
        });
        const res: any = await client.decideEditorial({ path, decision: 'approve' });
        // The page is static and already built as a members-only item, so it does not become public in front of
        // the reader. Saying "within a few minutes" is the honest answer, and it stops a superadmin refreshing
        // and approving again because nothing changed.
        if (label) label.textContent = res?.alreadyPublic ? 'Already public' : 'Approved. Public within a few minutes.';
      } catch (err: any) {
        btn.disabled = false;
        if (label) label.textContent = err?.message || 'That did not go through. Try again in a minute.';
      }
    });
  }
</script>
