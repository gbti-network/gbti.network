---
// The shared site layout (SOW-010 V3). Loads the V3 fonts + design system (global.css imports
// gbti-v3.css), renders the shared icon sprite + V3 header/footer, and sets the light/dark theme before
// paint (no flash). Every page uses this; the homepage included.
import '@fontsource-variable/baloo-da-2';
import '@fontsource-variable/hanken-grotesk';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import IconSprite from '../components/IconSprite.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SigninModal from '../components/SigninModal.astro';
import ReferralCapture from '../components/ReferralCapture.astro';
import TouchTracker from '../components/TouchTracker.astro';
import { SITE_NAME } from '../lib/brand';
import CookieConsent from '../components/CookieConsent.astro';
import DigestInvite from '../components/mail/DigestInvite.astro';
import Lightbox from '../components/Lightbox.astro';
import CloudflareAnalytics from '../components/CloudflareAnalytics.astro';
import { knownImageSize } from '../lib/og-image-size.mjs';
import { SIGNUP_BASE } from '../lib/membership'; // sow-158 Phase 2: the Worker origin, stamped site-wide for the cookie hydrator

interface Props {
  title?: string;
  description?: string;
  /** Absolute or root-relative OG image URL. */
  ogImage?: string;
  /** Open Graph type, e.g. 'website' (default) or 'article' for posts. */
  ogType?: string;
  /** When true, emit <meta name="robots" content="noindex"> (auth shells, stubs); a string is emitted as the
   *  robots value itself (sow-189: an unindexed article sends "noindex, follow"). */
  noindex?: boolean | string;
  /** When true, omit the site Header/Footer chrome (standalone landing pages that carry their own). */
  bare?: boolean;
  /** The measured pixel size of `ogImage`, when the caller read it from the file itself (sow-283: a share's
      hosted cover). Wins over knownImageSize, which only recognizes URLs whose size is fixed by their name. */
  ogImageSize?: { width: number; height: number };
}

const {
  title = SITE_NAME,
  description = 'A creator network: plugins, prompts, and people building the open internet together.',
  ogImage,
  ogType = 'website',
  noindex = false,
  bare = false,
  ogImageSize: measuredOgImageSize,
} = Astro.props;

const siteName = SITE_NAME;
// sow-256: the destructuring default above fires only on `undefined`, so a caller passing an empty or
// whitespace title still reached the template and rendered " | GBTI Network". The schema now refuses a blank
// title on authored CONTENT; this closes the same hole for the pages that pass the prop directly, which no
// content schema can reach.
const pageTitle = String(title ?? '').trim() || siteName;
const fullTitle = pageTitle === siteName ? pageTitle : `${pageTitle} | ${siteName}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Every page gets an OG image so a shared link never previews blank. A page-specific image (a post cover, a
// product banner) wins and renders as a large card; otherwise the branded 1200x630 GBTI Network card is
// the default, so the homepage + any page without its own image previews as a proper large card.
const DEFAULT_OG_IMAGE = '/og-image.png';
const ogImageUrl = new URL(ogImage || DEFAULT_OG_IMAGE, Astro.site).href;
// og:image:width/height are advisory but load-bearing for the strict scrapers: several apply a minimum-width
// floor and will not fetch the image to measure it themselves, so an undeclared thumbnail is dropped in
// favour of their own or of nothing. Emitted ONLY for a URL whose size we actually know (knownImageSize
// returns null otherwise), because a wrong number is worse than a missing one.
const ogImageSize = measuredOgImageSize ?? knownImageSize(ogImage || DEFAULT_OG_IMAGE);
---

<!doctype html>
<html lang="en" data-signup-base={SIGNUP_BASE}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Brand favicon set: the GBTI monogram on an ink tile (see /brand). */}
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {/* The signup Worker serves the public news feed + membership oracles; warm the connection early. */}
    <link rel="preconnect" href="https://signup.gbti.network" crossorigin />
    {/* sow-283: no preconnect to i.ytimg.com any more. Public share covers are served from gbti.network, and a
        preconnect opens a connection to the third party (handing it the visitor's IP) on every page load whether
        or not an image from it is ever requested. */}
    {/* Speculation Rules (owner directive, 2026-07-21): hover-triggered PRERENDER of news item shells
        runs their fetch chain before the click, so the first open feels instant; every other internal
        link gets a cheap hover prefetch. Browsers without the API ignore the script. Note: a
        prerendered-but-unclicked page may log one Cloudflare Web Analytics view (cookieless beacon);
        accepted at moderate eagerness, where hover intent makes activation likely. */}
    <script type="speculationrules" is:inline set:html={JSON.stringify({
      prerender: [{ where: { href_matches: '/news/item/*' }, eagerness: 'moderate' }],
      prefetch: [{ where: { and: [{ href_matches: '/*' }, { not: { href_matches: '/news/item/*' } }] }, eagerness: 'moderate' }],
    })} />
    {/* Set the light/dark theme before paint to avoid a flash of the wrong theme. */}
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('gbti-theme');
          if (t !== 'light' && t !== 'dark') {
            t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          document.documentElement.setAttribute('data-theme', t);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content={typeof noindex === 'string' ? noindex : 'noindex'} />}
    <link rel="canonical" href={canonical} />

    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogImageSize && <meta property="og:image:width" content={String(ogImageSize.width)} />}
    {ogImageSize && <meta property="og:image:height" content={String(ogImageSize.height)} />}
    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

    <meta name="generator" content={Astro.generator} />

    {/* SOW-024: Cloudflare Web Analytics — cookieless, so it loads site-wide with no consent gate. (The
        CookieConsent hook below stays available for any future cookie-based analytics.) No-op until the owner
        sets GBTI_CF_ANALYTICS_TOKEN. */}
    <CloudflareAnalytics />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only rounded bg-brand px-4 py-2 font-semibold text-white focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:z-[100]"
      >Skip to content</a
    >
    <IconSprite />
    {!bare && <Header />}
    <main id="main" class="flex-1">
      <slot />
    </main>
    {!bare && <Footer />}
    <SigninModal />
    <ReferralCapture />
    <TouchTracker />
    <CookieConsent />
    {/* sow-388: the full-screen digest invitation, for a signed-out reader a minute into the visit. Not on a `bare`
        page, which carries its own chrome (today only the archived Codeable lander, a sales page it stays off anyway). */}
    {!bare && <DigestInvite />}
    <Lightbox />{/* SOW-175: site-wide click-to-enlarge for body images + product galleries */}
    {/* SOW-030: reflect the GBTI extension's page-safe identity signal onto <html> (is-gbti-member /
        is-gbti-paid / data-gbti-role) so components + CSS can show a signed-in / member experience. Presentation
        only and UNTRUSTED for security (see src/lib/member-signal.ts); the token never reaches the page.
        Race note: this parse-time module runs BEFORE the extension content script stamps the signal (at
        document_idle), so readMemberSignal() is usually null on first paint; onMemberSignal() then catches the
        gbti:identity event and applies the classes. Keep this a parse-time module script (not async/defer). */}
    <script>
      import { readMemberSignal, onMemberSignal, applyMemberSignalClasses, hydrateMemberSignal, currentIdentity } from '../lib/member-signal';
      import { upgradeSaveControls } from '../lib/save-controls'; // sow-316: hearts + collections for a website session, site-wide
      applyMemberSignalClasses(readMemberSignal());
      onMemberSignal(applyMemberSignalClasses);
      // sow-316: upgrade every save control on the page for a signed-in WEBSITE member, from here rather than per
      // surface, so a page that renders a heart cannot forget the wiring (five surfaces had). No-op without a
      // website session or without controls. The extension being installed does not matter (website first,
      // 2026-09-12): its content script cannot upgrade page elements, so standing down left every control inert.
      upgradeSaveControls(currentIdentity(readMemberSignal()));
      onMemberSignal(upgradeSaveControls);
      // sow-158 Phase 2: hydrate the signed-in state from the httpOnly gbti_session cookie (fetches the public
      // /membership/status with credentials; the token never reaches the page). The cookie session WINS over the
      // extension signal; the cheap gate skips the network when there is no gbti_csrf cookie (anonymous pageload).
      hydrateMemberSignal();
    </script>
  </body>
</html>
