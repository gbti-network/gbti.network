---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleTeaser from '../../components/blog/ArticleTeaser.astro';
import { isDiscoverable, byNewest } from '../../lib/content'; // sow-189: a stale article leaves the directory

import DirectorySearch from '../../components/DirectorySearch.astro'; // sow-177: search in the hero
const posts = (await getCollection('post')).filter(isDiscoverable).sort(byNewest);
const categories = [...new Set(posts.map((p) => p.data.categories?.[0]).filter(Boolean))].sort();
---
<BaseLayout title="News" description="Articles from the GBTI Network.">
  <section class="band tint">
    <div class="wrap">
      <div class="sec-head center">
        <p class="eyebrow">From the Network</p>
        <h1 class="h1 mt12">Latest Articles from the Network</h1>
        <p class="lead">Writing from the GBTI Network: tutorials, essays, and field notes from across the membership.</p>
        <DirectorySearch id="article-search" placeholder="Search articles" label="Search articles" />
      </div>

      <div class="filter-row" style="justify-content:center" role="tablist" aria-label="Filter by category">
        <button type="button" data-cat="all" class="chip filter cat-pill on" aria-selected="true">All</button>
        {categories.map((c) => <button type="button" data-cat={c} class="chip filter cat-pill" aria-selected="false">{c}</button>)}
      </div>

      <div id="post-grid" class="works-grid blog-grid">
        {posts.map((post) => <ArticleTeaser post={post} />)}
      </div>
      <p id="post-empty" class="body muted" style="text-align:center;padding:28px 0" hidden>No articles match that search.</p>
      {/* sow-250: said when a ?cat= deep link names a category this page does not have. Mirrors #post-empty. */}
      <p id="post-catmissing" class="body-sm muted" style="text-align:center;margin:10px 0 0" hidden>That category was not found. Showing all articles. <button type="button" id="post-catmissing-clear" class="chip filter">Dismiss</button></p>
    </div>
  </section>

  <style>
    /* Active styling comes from the global .filter.on (light + dark), not a per-page duplicate. */
    .cat-pill { text-transform: capitalize; }
    .blog-grid { grid-template-columns: repeat(3, 1fr); }
    @media (max-width: 1080px) { .blog-grid { grid-template-columns: 1fr 1fr; } }
    @media (max-width: 640px) { .blog-grid { grid-template-columns: 1fr; } }
  </style>

  <script>
    const pills = document.querySelectorAll<HTMLButtonElement>('.cat-pill');
    const cards = document.querySelectorAll<HTMLElement>('#post-grid .archive-card');
    // sow-177: the hero search composes with the category chips. A card's searchable text is read once from
    // the card itself (title, excerpt, author), so no data attribute has to be kept in step with the teaser.
    const searchEl = document.getElementById('article-search') as HTMLInputElement | null;
    const emptyEl = document.getElementById('post-empty');
    const text = new Map<HTMLElement, string>();
    cards.forEach((card) => text.set(card, (card.textContent || '').replace(/\s+/g, ' ').toLowerCase()));
    let cat = 'all';
    let query = '';
    function applyFilter(nextCat: string) {
      cat = nextCat;
      pills.forEach((p) => {
        const on = p.dataset.cat === cat;
        p.classList.toggle('on', on);
        p.setAttribute('aria-selected', String(on));
      });
      let shown = 0;
      cards.forEach((card) => {
        const show = (cat === 'all' || card.dataset.category === cat) && (!query || (text.get(card) || '').includes(query));
        card.style.display = show ? '' : 'none';
        if (show) shown++;
      });
      if (emptyEl) emptyEl.hidden = shown > 0;
    }
    pills.forEach((pill) => {
      pill.addEventListener('click', () => applyFilter(pill.dataset.cat || 'all'));
    });
    searchEl?.addEventListener('input', () => { query = searchEl.value.trim().toLowerCase(); applyFilter(cat); });
    // Deep link: /articles/?cat=<key> (from a related-article card's category eyebrow) preselects that pill on load.
    // The article page's own category link goes to /feeds/?cat=<leaf> instead (sow-287), because this list filters by
    // top-level category only.
    const params = new URLSearchParams(location.search);
    const catParam = params.get('cat');
    if (catParam && Array.from(pills).some((p) => p.dataset.cat === catParam)) applyFilter(catParam);
    else if (catParam) {
      // sow-250 (owner decision 2026-09-12): an unknown category used to be ignored silently, so a stale link
      // showed every article and read as a filter that matched everything. Keep showing everything, and say so.
      // Dismissing drops `cat` from the URL so a reload does not bring the notice back.
      const missing = document.getElementById('post-catmissing');
      if (missing) {
        missing.hidden = false;
        document.getElementById('post-catmissing-clear')?.addEventListener('click', () => {
          missing.hidden = true;
          const u = new URLSearchParams(location.search);
          u.delete('cat');
          const q = u.toString();
          history.replaceState(null, '', location.pathname + (q ? `?${q}` : '') + location.hash);
        });
      }
    }
  </script>
</BaseLayout>
