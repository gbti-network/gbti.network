---
// SOW-092 follow-up: the video-embed RELAY. YouTube's embedded player now rejects requests with no HTTP
// Referer (its error 153), and a chrome-extension:// page can never send one, so the in-extension share
// views frame THIS https page instead and it frames the provider. The inner player then sees a valid
// https referrer and plays. NOT an open iframe proxy: the ?u= value is validated through the ONE shared
// embedUrl extractor, so only a normalized YouTube/Vimeo/TikTok/Rumble embed URL ever renders; anything
// else shows a plain "cannot play here" note. No site chrome on purpose (this page exists to be framed).
// sow-261: it relays TWEETS too. A ?u= tweet link (validated by the shared tweetId) frames X's own tweet page in the
// requested theme, and the tweet's size and outcome messages are forwarded to the parent as { gbtiTweet }, so the
// extension can size its frame to the tweet (a tweet has no fixed aspect ratio, unlike a player).
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    {/* FAIL-SAFE for the public/_headers /embed rules, which `! ` remove the global CSP and set a bespoke one.
        That remove-and-reset in one rule block is verified but UNDOCUMENTED Cloudflare behavior, so if it ever
        degenerates to the removal alone this page would ship naked. This meta carries the same directives MINUS
        frame-ancestors, which the CSP spec REQUIRES a meta-delivered policy to ignore, so it can neither restore
        the framing block that broke the extension nor be relied on to set one. Header and meta intersect, so keep
        the two in step: anything permitted here must also be permitted there. */}
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'none'; script-src 'self'; style-src 'unsafe-inline'; frame-src https://www.youtube.com https://player.vimeo.com https://www.tiktok.com https://rumble.com https://platform.twitter.com; base-uri 'none'; object-src 'none'; form-action 'none'"
    />
    <title>Video</title>
    <style is:global>
      html, body { margin: 0; padding: 0; width: 100%; height: 100%; background: #000; overflow: hidden; }
      iframe { display: block; width: 100%; height: 100%; border: 0; }
      .note { color: #9aa; font: 13px system-ui, sans-serif; padding: 16px; }
    </style>
  </head>
  <body>
    <script>
      import { embedUrl } from '../../client/src/video-embed.mjs';
      import { tweetId, tweetFrameUrl, parseTweetMessage, TWEET_FRAME_ORIGIN } from '../../client/src/tweet-embed.mjs';
      const params = new URLSearchParams(location.search);
      const u = params.get('u') || '';
      const src = embedUrl(u);
      if (tweetId(u)) {
        // sow-261: transparent, so the tweet's own rounded card sits on the parent page's background.
        document.documentElement.style.background = 'transparent';
        document.body.style.background = 'transparent';
        document.title = 'Post on X';
        const f = document.createElement('iframe');
        f.title = 'Post on X';
        f.setAttribute('scrolling', 'no');
        f.src = tweetFrameUrl(u, { theme: params.get('theme') || 'light' });
        document.body.appendChild(f);
        // Forward only X's messages from THIS frame, reduced to the three the parent acts on (height, rendered,
        // nothing to show). The payload is a number and a word, so the parent's origin needs no pinning.
        addEventListener('message', (e) => {
          if (e.origin !== TWEET_FRAME_ORIGIN || e.source !== f.contentWindow) return;
          const m = parseTweetMessage(e.data);
          if (m && parent !== window) parent.postMessage({ gbtiTweet: m }, '*');
        });
      } else if (src) {
        const f = document.createElement('iframe');
        f.src = src;
        f.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
        f.allowFullscreen = true;
        document.body.appendChild(f);
      } else {
        const p = document.createElement('p');
        p.className = 'note';
        p.textContent = 'This video cannot play here.';
        document.body.appendChild(p);
      }
    </script>
  </body>
</html>
