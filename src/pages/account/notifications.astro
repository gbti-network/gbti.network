---
// SOW-186 C3: the account "Notifications" settings surface. A signed-in member sets the global default matrix
// (what arrives when someone they follow publishes) and fine-tunes any one follow. Reuses the client-ui
// <gbti-notifications-settings> element wired to the cookie-session adapter (no GitHub token in the page).
// A stable, linkable URL: the weekly digest footer "notification preferences" link lands here (sow-267). noindex.
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Notifications" description="Choose what the people you follow send you." noindex={true}>
  <section class="band">
    <div class="wrap notif-wrap">
      {/* Signed-OUT fallback (also the pre-hydration state; static SSG has no request-time cookie). */}
      <div class="sec-head center" data-notif-signedout>
        <span class="itile"><svg viewBox="0 0 24 24"><use href="#ico-bell"/></svg></span>
        <h1 class="h1 mt24">Notifications</h1>
        <p class="lead">Sign in with GitHub to choose what the people you follow send you, in app and by email.</p>
        <a href="/login/?return_to=%2Faccount%2Fnotifications%2F" class="btn btn-primary btn-lg mt24">Sign in <svg class="ar" viewBox="0 0 24 24" width="18" height="18"><use href="#ico-arrow"/></svg></a>
      </div>

      {/* Signed-IN surface, hydrated client-side from the httpOnly-cookie session (member-signal.ts). */}
      <div data-notif-signedin hidden>
        <div class="notif-head">
          <a class="notif-back" href="/account/">
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M15 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Account
          </a>
          <h1 class="h1">Notifications</h1>
          <p class="lead">What the people you follow send you. Set one default for everyone, then fine-tune any follow.</p>
        </div>
        <gbti-notifications-settings></gbti-notifications-settings>
      </div>
    </div>
  </section>

  <script>
    import { onMemberSignal, currentIdentity, readMemberSignal } from '../../lib/member-signal';

    const out = document.querySelector('[data-notif-signedout]') as HTMLElement | null;
    const inn = document.querySelector('[data-notif-signedin]') as HTMLElement | null;
    let mounted = false;

    function render(s: any) {
      const signedIn = !!(s && s.login);
      if (out) out.hidden = signedIn;
      if (inn) inn.hidden = !signedIn;
      if (signedIn) mount(s);
    }

    // Upgrade the inert <gbti-notifications-settings> once, on the first signed-in signal: inject the cookie-session
    // client, then import the element so its static tag hydrates and loads via the setClient subscriber fan-out.
    async function mount(s: any) {
      if (mounted) return;
      mounted = true;
      const signupBase = document.documentElement.dataset.signupBase || '';
      const { createWorkbenchClient } = await import('../../lib/workbench-client');
      const { setClient } = await import('../../../client-ui/src/base.mjs');
      setClient(createWorkbenchClient({ signupBase, login: String(s.login), githubId: s.githubId != null ? String(s.githubId) : null }));
      await import('../../../client-ui/src/elements/gbti-notifications-settings.mjs');
    }

    render(currentIdentity(readMemberSignal()));
    onMemberSignal(render); // BaseLayout invokes hydrateMemberSignal(); the cookie member arrives here
  </script>

  <style>
    .notif-wrap { max-width: 720px; }
    .notif-head { margin-bottom: 24px; }
    .notif-head .h1 { margin: 6px 0 6px; }
    .notif-head .lead { margin: 0; }
    .notif-back { display: inline-flex; align-items: center; gap: 5px; color: var(--fg-mute); font-size: 13.5px; font-weight: 600; text-decoration: none; }
    .notif-back:hover { color: var(--brand); }
    [data-notif-signedin][hidden] { display: none; }
  </style>
</BaseLayout>
