---
// sow-323: /submit-content/, the public explanation of how the content platform works.
//
// The owner asked for it in the same breath as collapsing the two paid plans (2026-09-12): a footer link to
// "Submit content" that takes the reader to a page explaining how our content platform works, including the
// revenue program. It is the honest front door to publishing, and it replaces the Curator application page,
// which is retired: publishing is included in the paid membership now.
//
// EDITORIAL REVIEW IS RETIRED (owner, 2026-10-16): "It is published when the person publishes it." Work a paid
// member publishes is live when they publish it, public by default, members only if the author chooses. This
// page used to explain a members-first, superadmin-approved flow; do not reintroduce any sentence about review.
//
// EVERY NUMBER AND NAME ON THIS PAGE IS BOUND, NOT WRITTEN. The plan name comes from the tier registry
// (house/membership-tiers.yml, superadmin-CODEOWNED) and the revenue splits from src/lib/membership.ts, which
// derives them from house/referral-config.yml. A page about money that hardcodes a percentage goes stale
// silently and reads as a promise, which is the failure the tier registry's own header was written to stop.
// The member dashboard already states these same numbers; disagreeing with it in public would be worse than
// saying nothing.
//
// The five qualities below are the OWNER'S, taken verbatim from their answer of 2026-09-12, when they were the
// approval criteria. With review retired they stay as guidance on what good work here looks like, not as a
// gate. Nothing here invents a standard, a turnaround time, or a promise.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { tierDisplay } from '../../lib/tiers';
import {
  FIRST_TOUCH_PCT, LAST_TOUCH_PCT, COLLAB_POOL_PCT, INVITE_PCT, HOLD_DAYS,
} from '../../lib/membership';

const paid = tierDisplay('member');
if (!paid) throw new Error('submit-content: house/membership-tiers.yml is missing the member tier');
const PLAN = paid.label;
const PRICE = `$${paid.priceAnnual}/yr`;

// The owner's words, 2026-09-12. Once approval criteria, now guidance only. Do not add to this list without asking them.
const criteria = [
  ['Original work', 'Something you made, ran, or worked through yourself.'],
  ['Useful to a builder', 'Someone building the same kind of thing should come away able to act on it.'],
  ['Specific', 'Concrete enough to follow. A general overview of a topic is not the same as what you learned doing it.'],
  ['Your own product is welcome', 'Writing about a project or product of your own is fine, as long as the write-up teaches something.'],
  ['Not promotion alone', 'A press release, or a post whose only purpose is the link at the bottom, is not a fit.'],
];

const steps = [
  {
    h: 'Write it where you like',
    p: 'The WorkBench on this site holds your articles, projects and prompts, and the editor you write them in. In the browser extension you can post a share directly, and its Submit content button opens the WorkBench editor here for an article, project or prompt. If you work with an AI agent, the MCP server lets it author through the same flow you do.',
  },
  {
    h: 'Publish it and it is live',
    p: 'When you publish, your work goes live on the network. There is no approval step in between. The site rebuilds in about 2 to 3 minutes, so give it a moment before you look for it.',
  },
  {
    h: 'You choose who reads it',
    p: 'Public is the default. A public piece can be read by anyone and appears in the public feeds. Choose Members only instead and the full piece is kept for members of the network. The choice is yours, piece by piece.',
  },
  {
    h: 'It stays yours',
    p: 'You edit a published piece whenever you like, and it keeps the date you wrote it.',
  },
];
---

<BaseLayout
  title="Submit content"
  description={`How publishing works on the GBTI Network: write in the WorkBench, publish, and your work is live, public by default or for members only. ${PLAN} membership includes publishing and a share of the revenue.`}
>
  <main class="sc-wrap">
    <header class="sc-head">
      <p class="sc-eyebrow">Submit content</p>
      <h1 class="h1">Publish your work on the network</h1>
      <p class="lead">
        This is a developer co-op, and the content is the members. Anything you publish is live when you
        publish it, public by default or for members only if you choose. Reading is free for everyone.
        Publishing is part of {PLAN} membership, at {PRICE}.
      </p>
      {/* sow-394 (owner, 2026-09-24): the buttons follow who is reading. "Open the WorkBench" sent a signed-out
          reader to a sign-in wall, and a free account still cannot publish once there, so both see the plans
          first. The signed-out set is the default, which is also what a reader without JavaScript gets; the
          member-signal classes on <html> (src/lib/member-signal.ts) switch it. is-gbti-member = any signed-in
          account (the Sign in button goes); is-gbti-member-active = an effective paid member (today's buttons). */}
      <div class="sc-cta sc-cta-out">
        <a class="btn btn-primary" href="/membership/">See membership <svg class="ar" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><use href="#ico-arrow"/></svg></a>
        <a class="btn btn-ghost sc-signin" href="/login/?return_to=%2Fsubmit-content%2F"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><use href="#ico-github"/></svg> Sign in</a>
      </div>
      <div class="sc-cta sc-cta-paid">
        <a class="btn btn-primary" href="/workbench/">Open the WorkBench</a>
        <a class="btn btn-ghost" href="/membership/">See membership</a>
      </div>
    </header>

    <section class="sc-sec" aria-labelledby="sc-how">
      <h2 class="h2" id="sc-how">How it works</h2>
      <ol class="sc-steps">
        {steps.map((s) => (
          <li>
            <h3 class="sc-step-h">{s.h}</h3>
            <p class="body">{s.p}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="sc-sec" aria-labelledby="sc-what">
      <h2 class="h2" id="sc-what">What you can submit</h2>
      <p class="body">
        Articles, projects and prompts, plus shares, which are links worth reading with a note on why. Your
        member profile is yours, and so are your comments, which go out as you write them.
      </p>
      <p class="body">
        Your work lives in your own folder in a public git repository, as plain markdown with its images beside
        it. You can read it, fork it, and take it with you. Nothing about publishing here signs your work over
        to us.
      </p>
    </section>

    <section class="sc-sec" aria-labelledby="sc-criteria">
      <h2 class="h2" id="sc-criteria">What good work here looks like</h2>
      <p class="body">These five things are what make a piece worth reading here.</p>
      <dl class="sc-crit">
        {criteria.map(([term, def]) => (
          <div class="sc-crit-row">
            <dt>{term}</dt>
            <dd>{def}</dd>
          </div>
        ))}
      </dl>
      <p class="body sc-quiet">
        This is guidance, not a gate. You can rework a piece and publish it again whenever you like.
      </p>
    </section>

    <section class="sc-sec" aria-labelledby="sc-revenue">
      <h2 class="h2" id="sc-revenue">The revenue program</h2>
      <p class="body">
        When a visitor becomes a paying member, the content that brought them in shares the revenue. The author
        of the earliest piece in their journey earns {FIRST_TOUCH_PCT}, the author of the last piece before they
        joined earns {LAST_TOUCH_PCT}, and {COLLAB_POOL_PCT} goes to a pool shared by the members whose comments
        and accepted contributions sit on those two pieces. Your profile page counts as an entry point, so a
        visitor who lands there and later joins credits you with no special link.
      </p>
      <p class="body">
        Separately, your own invite link pays a flat {INVITE_PCT} for the life of anyone who joins through it,
        funded from the platform's share so it never dilutes what authors earn. You take the larger of the two
        rather than both.
      </p>
      <p class="body">
        The split follows visits to a public page, so a public piece can earn from the moment it goes live.
        Payouts settle after a {HOLD_DAYS} day hold and arrive through Stripe Connect.
      </p>
      <p class="body">
        <a href="/revenue-model/">Read the full breakdown</a> for the worked example, every rule, and the
        frequently asked questions.
      </p>
    </section>

    <section class="sc-sec" aria-labelledby="sc-faq">
      <h2 class="h2" id="sc-faq">Questions</h2>
      <div class="sc-faq">
        <details>
          <summary>How soon is my piece live?</summary>
          <p class="body">As soon as the site rebuilds, which takes about 2 to 3 minutes after you publish. There is no review step in between.</p>
        </details>
        <details>
          <summary>Can I keep a piece for members only?</summary>
          <p class="body">Yes. Public is the default, and you can choose Members only for any piece you publish. The full piece is then kept for members of the network.</p>
        </details>
        <details>
          <summary>Do I have to publish to be a member?</summary>
          <p class="body">No. Membership is the community first. Publishing is included, and plenty of members read, comment and take part without writing anything.</p>
        </details>
        <details>
          <summary>What if I publish something and change my mind?</summary>
          <p class="body">Edit it or unpublish it. It is your folder and your work.</p>
        </details>
        <details>
          <summary>Do I need a card to read?</summary>
          <p class="body">No. A free account with GitHub gets you the network, the news feed, public shares, follows and collections. Membership adds the community, members-only content, publishing and the revenue share.</p>
        </details>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .sc-wrap { max-width: 760px; margin: 0 auto; padding: 48px 20px 72px; }
  .sc-head { margin: 0 0 40px; }
  .sc-eyebrow { font-family: var(--font-mono, monospace); font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--green-700); margin: 0 0 10px; }
  .sc-head .lead { margin: 14px 0 0; }
  .sc-cta { display: flex; flex-wrap: wrap; gap: 12px; margin: 24px 0 0; }
  /* sow-394: which button set shows (see the markup). */
  .sc-cta-paid { display: none; }
  :global(html.is-gbti-member) .sc-signin { display: none; }
  :global(html.is-gbti-member-active) .sc-cta-out { display: none; }
  :global(html.is-gbti-member-active) .sc-cta-paid { display: flex; }
  .sc-sec { margin: 0 0 40px; }
  .sc-sec .h2 { margin: 0 0 14px; }
  .sc-sec .body { margin: 0 0 14px; line-height: 1.7; }
  .sc-quiet { color: var(--fg-mute); }
  .sc-steps { list-style: none; margin: 0; padding: 0; counter-reset: sc; display: flex; flex-direction: column; gap: 22px; }
  .sc-steps > li { counter-increment: sc; padding-left: 44px; position: relative; }
  .sc-steps > li::before {
    content: counter(sc); position: absolute; left: 0; top: 0;
    width: 30px; height: 30px; border-radius: 999px;
    display: flex; align-items: center; justify-content: center;
    background: color-mix(in srgb, var(--green) 14%, transparent);
    color: var(--green-700); font-weight: 700; font-size: 14px;
  }
  .sc-step-h { margin: 2px 0 6px; font-family: var(--font-display, inherit); font-size: 18px; }
  .sc-crit { margin: 0; display: flex; flex-direction: column; gap: 14px; }
  .sc-crit-row { border-left: 3px solid var(--green); padding: 0 0 0 14px; }
  .sc-crit dt { font-weight: 700; margin: 0 0 3px; }
  .sc-crit dd { margin: 0; color: var(--fg-mute); line-height: 1.6; }
  .sc-faq { display: flex; flex-direction: column; gap: 10px; }
  .sc-faq details { border: 1px solid var(--line); border-radius: 10px; padding: 12px 16px; background: var(--paper); }
  .sc-faq summary { cursor: pointer; font-weight: 600; }
  .sc-faq details[open] summary { margin-bottom: 8px; }
  .sc-faq .body { margin: 0; }
  @media (max-width: 560px) {
    .sc-wrap { padding: 32px 16px 56px; }
    .sc-cta .btn { width: 100%; justify-content: center; }
  }
</style>
