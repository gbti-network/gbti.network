---
// sow-161: the native site admin surface, the primary admin surface (the extension relays to it). Staff sign in over
// the httpOnly-cookie session. <gbti-admin> mounts with caps="moderation,membership,roles", so content moderation,
// bans and grants, and role assignment all render here; the tab bar below adds the config managers (admin and up) and
// the superadmin tools (site settings, syndication, creator applications, member lookup). Each tab shows only when the
// caller's rank clears its data-min. The Worker + the SOW-005 gate are the real boundary (the role is re-checked
// server-side + at merge); this page is UX only. noindex: a per-staff surface.
import BaseLayout from '../layouts/BaseLayout.astro';
import MemberLookup from '../components/admin/MemberLookup.astro'; // sow-331
---
<BaseLayout title="Admin tools" description="GBTI Network admin." noindex={true}>
  <section class="band">
    <div class="wrap adm-wrap">
      {/* pre-hydration / non-staff fallback (static SSG has no request-time role). */}
      <div class="sec-head center" data-admin-gate>
        <span class="itile"><svg viewBox="0 0 24 24"><use href="#ico-id"/></svg></span>
        <h1 class="h1 mt24">Checking access&hellip;</h1>
      </div>

      <div data-admin-body hidden>
        <div class="sec-head">
          <h1 class="h1">Admin tools</h1>
          <p class="lead">Moderate content, manage member status, and assign roles across the co-op. Every action opens a gated pull request that auto-merges; the SOW-005 gate re-checks your role.</p>
        </div>
        <nav class="adm-tabs" role="tablist" aria-label="Admin sections" data-admin-tabs hidden>
          <button type="button" role="tab" data-tab="admin" aria-selected="false">Admin tools</button>
          <button type="button" role="tab" data-tab="quotes" data-min="admin" aria-selected="false" hidden>Splash quotes</button>
          <button type="button" role="tab" data-tab="news-sources" data-min="admin" aria-selected="false" hidden>News sources</button>
          <button type="button" role="tab" data-tab="coupons" data-min="admin" aria-selected="false" hidden>Coupons</button>
          <button type="button" role="tab" data-tab="categories" data-min="admin" aria-selected="false" hidden>Categories</button>
          <button type="button" role="tab" data-tab="tags" data-min="admin" aria-selected="false" hidden>Tags</button>
          <button type="button" role="tab" data-tab="site-settings" data-min="superadmin" aria-selected="false" hidden>Site settings</button>
          <button type="button" role="tab" data-tab="syndication" data-min="superadmin" aria-selected="false" hidden>Syndication</button>{/* sow-399: was Channels */}
          <button type="button" role="tab" data-tab="editorial" data-min="superadmin" aria-selected="false" hidden>Editorial review</button>{/* sow-323 */}
          <button type="button" role="tab" data-tab="member-lookup" data-min="superadmin" aria-selected="false" hidden>Member lookup</button>{/* sow-331 */}
          <button type="button" role="tab" data-tab="outbound-links" data-min="superadmin" aria-selected="false" hidden>Outbound links</button>{/* sow-289 */}
          <button type="button" role="tab" data-tab="ctas" data-min="superadmin" aria-selected="false" hidden>CTAs</button>{/* sow-281 */}
          <button type="button" role="tab" data-tab="digest" data-min="superadmin" aria-selected="false" hidden>Weekly email</button>{/* sow-266 */}
        </nav>

        <div class="adm-card" data-panel="admin">
          <gbti-admin caps="moderation,membership,roles"></gbti-admin>
        </div>

        {/* Config managers (admin+). The element only upgrades when its module is imported, which the script does
            for admin+ only, so a moderator sees no card. sow-161 increment 4: quotes (the first config manager). */}
        <div class="adm-card" data-panel="quotes" hidden>
          <h2 class="h2">Splash quotes</h2>
          <gbti-quote-manager></gbti-quote-manager>
        </div>
        <div class="adm-card" data-panel="news-sources" hidden>
          <h2 class="h2">News sources</h2>
          <gbti-news-source-manager></gbti-news-source-manager>
        </div>
        <div class="adm-card" data-panel="coupons" hidden>
          <h2 class="h2">Coupons</h2>
          <gbti-coupon-manager></gbti-coupon-manager>
        </div>
        {/* sow-323: the editorial review queue. SUPERADMIN, because approving PUBLISHES a member's work to the
            open web. Like the invites surface it opens no pull request of its own: the decision goes straight to
            the Worker, which does the commit, because only the Worker can read an encrypted members-only body. */}
        <div class="adm-card" data-panel="editorial" hidden>
          <h2 class="h2">Editorial review</h2>
          <gbti-editorial-manager></gbti-editorial-manager>
        </div>
        {/* sow-161 A: the two managers the owner asked for on the website. They carry their OWN headers (a chead /
            an explorer header), so no card <h2> here, matching the extension admin. The category->Discord-channel
            column shows for a SUPERADMIN only (sow-161 B, Option A): the workbench client exposes
            contentChannelPool + discordChannels only when isSuperadmin, so an admin sees the category tree +
            label/add + key-migration + tag rename/merge/retire but not the channel column (which they cannot write). */}
        <div class="adm-card" data-panel="categories" hidden>
          <gbti-categories-workspace></gbti-categories-workspace>
        </div>
        <div class="adm-card" data-panel="tags" hidden>
          <gbti-tag-explorer></gbti-tag-explorer>
        </div>
        {/* sow-271: SUPERADMIN, one tier above the config managers above it. The tab carries data-min="superadmin"
            and the module below is imported only for superadmin, so an admin never upgrades the element. */}
        <div class="adm-card" data-panel="site-settings" hidden>
          <h2 class="h2">Site settings</h2>
          <gbti-site-settings-manager></gbti-site-settings-manager>
        </div>
        {/* sow-266: SUPERADMIN. What the weekly digest says about membership, and who sponsors it. The module
            below is imported only for superadmin, and every write is a superadmin house PR. The settings
            themselves are not secret: they are committed to a public repository. */}
        <div class="adm-card" data-panel="digest" hidden>
          <h2 class="h2">Weekly email</h2>
          <gbti-digest-manager></gbti-digest-manager>
        </div>
        {/* sow-161 B: SUPERADMIN. The shared channel-map manager (channels x auto-share matrix, syndication
            templates + settings, engagement thresholds, moderation flag lists). The tab carries
            data-min="superadmin" and the module below is imported only for superadmin, so an admin never upgrades
            the element; every write lands as an auto-gated PR against superadmin-pinned house files.
            sow-399 (owner, 2026-09-24): syndication moved here from the extension in full, so the tab takes the
            name the owner knows it by (was Channels; #tab=channels still lands here). Publishing Activity, the
            queue with Approve and Cancel, works now that the website client carries those calls. */}
        <div class="adm-card" data-panel="syndication" hidden>
          <h2 class="h2">Syndication</h2>
          <gbti-channel-map-manager></gbti-channel-map-manager>
        </div>
        {/* sow-331: SUPERADMIN. Search an email address or a GitHub username and see everything held about the
            account. View only; the Worker route is superadmin-gated and fails closed, so the tab gate is UX. */}
        <div class="adm-card" data-panel="member-lookup" hidden>
          <h2 class="h2">Member lookup</h2>
          <MemberLookup />
        </div>
        {/* sow-289: SUPERADMIN, read only. The partner redirect paths (house/outbound-links.yml) beside their estimated
            daily clicks (house/outbound-clicks.yml, rolled up by reconcile). The element reads the two public build
            artifacts itself; the module is imported for superadmin only, so an admin never upgrades the tag. */}
        <div class="adm-card" data-panel="outbound-links" hidden>
          <h2 class="h2">Outbound links</h2>
          <gbti-outbound-link-manager></gbti-outbound-link-manager>
        </div>
        {/* sow-281: SUPERADMIN. The registered content CTAs (house/ctas.yml): add, edit, enable, and assign each to any
            content item. The Worker ops carry ROLE_RANK.superadmin and the file is superadmin-CODEOWNED; the module
            is imported for superadmin only, so an admin never upgrades the tag. sow-337: data-site-origin="page" reads the
            card list, the card images and the icon library from this page's own site (the policy here allows only
            that), so the preview site shows its own build. */}
        <div class="adm-card" data-panel="ctas" hidden>
          <h2 class="h2">CTAs</h2>
          <gbti-cta-manager data-site-origin="page"></gbti-cta-manager>
        </div>
      </div>
    </div>
  </section>

  <script>
    // Resolve the signed-in member from the httpOnly-cookie session, gate to moderator+ by the role the
    // /membership/status oracle now returns (sow-158 follow-up), then mount the shared <gbti-admin> over the cookie
    // adapter. Fail closed: a signed-out or non-staff visitor is sent to their account (the server + the SOW-005
    // gate re-check the role, so this gate is UX, not the boundary).
    const RANK: Record<string, number> = { member: 0, moderator: 1, admin: 2, superadmin: 3 };
    const gate = document.querySelector('[data-admin-gate]') as HTMLElement | null;
    const body = document.querySelector('[data-admin-body]') as HTMLElement | null;

    function readCookie(name: string): string | null {
      for (const part of document.cookie.split(';')) {
        const eq = part.indexOf('=');
        if (eq >= 0 && part.slice(0, eq).trim() === name) return part.slice(eq + 1).trim() || null;
      }
      return null;
    }
    function bounce() { location.replace('/account/'); }

    async function mount(login: string, githubId: string | null, rank: number) {
      if (gate) gate.hidden = true;
      if (body) body.hidden = false;
      const signupBase = document.documentElement.dataset.signupBase || '';
      const { createWorkbenchClient } = await import('../lib/workbench-client');
      const { setClient } = await import('../../client-ui/src/base.mjs');
      // sow-161 B: pass isSuperadmin so the workbench client exposes the channel-map surface (discordChannels +
      // the manager reads/writes) ONLY to a superadmin. This is the role gate for the categories channel column:
      // the shared element decides to draw the column by a capability check, so the capability must be role-scoped.
      setClient(createWorkbenchClient({ signupBase, login, githubId, isSuperadmin: rank >= RANK.superadmin }));
      await import('../../client-ui/src/elements/gbti-admin.mjs'); // defines the element; it renders on the setClient fan-out
      // Config managers are admin+ only. Importing the module upgrades the static tag (which then renders on the
      // setClient fan-out); a moderator never imports it, so the tag stays inert and the card stays hidden.
      if (rank >= RANK.admin) {
        // Import the admin+ config managers so their custom elements upgrade; the tab bar controls which shows.
        await Promise.all([
          import('../../client-ui/src/elements/gbti-quote-manager.mjs'),
          import('../../client-ui/src/elements/gbti-news-source-manager.mjs'),
          import('../../client-ui/src/elements/gbti-coupon-manager.mjs'),
          import('../../client-ui/src/elements/gbti-categories-workspace.mjs'), // sow-161 A
          import('../../client-ui/src/elements/gbti-tag-explorer.mjs'), // sow-161 A
        ]);
      }
      // sow-271: the site toggles are superadmin, so their module is imported one tier higher. An admin never
      // imports it, so the tag stays inert and the card stays hidden even if the tab were somehow revealed.
      if (rank >= RANK.superadmin) {
        await import('../../client-ui/src/elements/gbti-site-settings-manager.mjs');
        await import('../../client-ui/src/elements/gbti-channel-map-manager.mjs'); // sow-161 B: the superadmin Syndication workspace (was Channels)
        await import('../../client-ui/src/elements/gbti-outbound-link-manager.mjs'); // sow-289: the read-only outbound link board
        await import('../../client-ui/src/elements/gbti-cta-manager.mjs'); // sow-281: the CTA registry manager
        await import('../../client-ui/src/elements/gbti-editorial-manager.mjs'); // sow-323: the editorial review queue
        await import('../../client-ui/src/elements/gbti-digest-manager.mjs'); // sow-266: the digest pitch + sponsor slot
      }
      setupTabs(rank);
    }

    // sow-161 (admin-nav): break the stacked sections into a tab bar so no single long list (News sources)
    // buries the rest. The tab buttons are STATIC in the markup so the scoped component CSS styles them: a
    // button injected at runtime via innerHTML never receives Astro's data-astro-cid, so it renders unstyled.
    // A button carrying data-min shows only when the rank clears it, so a moderator sees the single Admin
    // tools section and no tab bar at all.
    function setupTabs(rank: number) {
      const bar = document.querySelector('[data-admin-tabs]') as HTMLElement | null;
      if (!bar) return;
      const cardOf = (name: string) => document.querySelector('.adm-card[data-panel="' + name + '"]') as HTMLElement | null;
      const btns = Array.from(bar.querySelectorAll('button[data-tab]')) as HTMLElement[];
      const eligible = btns.filter((b) => {
        const min = b.dataset.min ? (RANK[b.dataset.min] ?? 99) : 0;
        return rank >= min && !!cardOf(b.dataset.tab || '');
      });
      if (!eligible.length) return;
      eligible.forEach((b) => b.removeAttribute('hidden'));
      const names = eligible.map((b) => b.dataset.tab as string);

      // sow-399: the Channels tab became Syndication; an old link (a bookmark, the extension bell) still lands.
      const TAB_ALIASES: Record<string, string> = { channels: 'syndication' };
      const rawHash = (location.hash.match(/^#tab=([a-z-]+)/) || [])[1] || '';
      const hashName = TAB_ALIASES[rawHash] || rawHash;
      const initial = names.indexOf(hashName) >= 0 ? hashName : names[0];
      // The rest of a deep link after the tab (e.g. "&sub=activity", which the Syndication tool reads to open a
      // section) is kept on the FIRST show only. Rewriting the hash to "#tab=<name>" used to drop it before the
      // tool read it, so a link to Publishing Activity opened whatever section was last used.
      const deepRest = (location.hash.match(/^#tab=[a-z-]+(&.*)$/) || [])[1] || '';

      function show(name: string, keepRest = false) {
        for (const n of names) { const c = cardOf(n); if (c) c.hidden = n !== name; }
        for (const b of eligible) {
          const on = b.dataset.tab === name;
          b.setAttribute('aria-selected', on ? 'true' : 'false');
          b.classList.toggle('on', on);
        }
        try { history.replaceState(null, '', '#tab=' + name + (keepRest ? deepRest : '')); } catch { /* hash update is best-effort */ }
      }

      if (eligible.length > 1) {
        bar.hidden = false;
        bar.addEventListener('click', (e) => {
          const btn = (e.target as HTMLElement).closest('button[data-tab]') as HTMLElement | null;
          if (btn && btn.dataset.tab && names.indexOf(btn.dataset.tab) >= 0) show(btn.dataset.tab);
        });
      }

      show(initial, initial === hashName);
    }

    // sow-158 re-login fix: on a TRANSIENT status failure (deploy window / network blip) keep the valid session
    // and show a soft retry in the gate, instead of bouncing a signed-in staff member to /account.
    async function runGate() {
      // Cheap gate: no readable gbti_csrf means no web session -> not staff -> bounce (no network).
      if (!readCookie('gbti_csrf')) { bounce(); return; }
      const base = document.documentElement.dataset.signupBase || '';
      const { resolveMemberSession } = await import('../lib/member-gate');
      const s = await resolveMemberSession({ base });
      if (s.state === 'in') {
        const rank = RANK[s.payload.role ?? 'member'] ?? 0;
        if (s.payload.login && rank >= RANK.moderator) {
          mount(String(s.payload.login), s.payload.github_id != null ? String(s.payload.github_id) : null, rank);
        } else {
          bounce(); // signed in but not staff -> no admin surface
        }
      } else if (s.state === 'error') {
        if (gate) gate.innerHTML = '<h1 class="h1 mt24">Cannot reach the server right now.</h1><p class="lead">Your session is still active. <button type="button" data-admin-retry>Retry</button></p>';
        gate?.querySelector('[data-admin-retry]')?.addEventListener('click', () => location.reload());
      } else {
        bounce(); // definitive signed-out / stale csrf
      }
    }
    runGate();
  </script>

  <style>
    .adm-wrap { max-width: var(--maxw); }
    .sec-head { margin-bottom: 18px; }
    .sec-head .lead { max-width: 640px; }
    .adm-card { border: 1.5px solid var(--line); border-radius: 16px; background: var(--paper); padding: 20px 24px; }

    /* sow-161 (admin-nav): section tab bar, so no single long list buries the rest */
    .adm-tabs { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 22px; }
    .adm-tabs button {
      font: inherit; font-weight: 600; font-size: 14px; line-height: 1; cursor: pointer;
      padding: 10px 18px; border-radius: 999px;
      border: 1.5px solid var(--line); background: var(--paper); color: var(--fg);
      transition: border-color .15s ease, background .15s ease, color .15s ease;
    }
    .adm-tabs button:hover { border-color: var(--green); }
    .adm-tabs button.on { background: var(--green); border-color: var(--green); color: #fff; }
    .adm-tabs button:focus-visible { outline: 2px solid var(--green); outline-offset: 2px; }
  </style>
</BaseLayout>
