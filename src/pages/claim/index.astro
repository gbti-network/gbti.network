---
// sow-427: THE PREPARED-LISTING CLAIM PAGE, /claim/?code=<CODE>. A superadmin prepared a project for someone who is
// not a member yet and sent them this link. The page shows the project the way it will look once published, with a
// dialog over it carrying the superadmin's personal message; signing in with GitHub grants the free year, and the
// person then writes their own author note and publishes the listing under their name. The flow and every sentence
// on it live in src/lib/claim-core.mjs (pure, unit-tested); src/lib/claim-page.ts wires them to this markup.
//
// NOTHING ABOUT THE LISTING IS IN THIS FILE, AND NOTHING THE SCRIPT LEARNS REACHES THE DOCUMENT HEAD. A pasted link
// unfurls in Slack and LinkedIn from the static title, description and og tags, so they are generic on purpose
// (sow-427 trap 7): the project's title and the person's name must not reach whoever sees the unfurl. BaseLayout
// builds og:url from the pathname only, so the code never appears there, and the script never sets the tab title.
//
// The title is BARE ("An invitation"): BaseLayout appends " | GBTI Network" to both the page title and og:title, and a title
// that carries the brand double-brands the unfurl (test/page-titles.test.mjs).
//
// UNLISTED THREE WAYS. `noindex` here, the `claim` entry in the sitemap filter (astro.config.mjs), and
// `Referrer-Policy: no-referrer` for /claim/* (public/_headers) so the code in the address is not handed to any site
// this page loads from or links to.
//
// THE REAL SITE CHROME (sow-434, owner 2026-09-30: "it needs to appear integrated to show realism"). The page is no
// longer `bare`: the site header and footer render as on every other page, and a slim strip under the header says this
// is a preview of a listing that is not published yet and carries the one control a dismissed dialog leaves behind.
// A page with the chrome also mounts BaseLayout's digest invitation (a live subscribe form). It never opens here:
// `/claim/` is on INVITE_QUIET_PATHS in src/lib/digest-invite-core.mjs, which covers this page and the example profile
// at /claim/profile/ (test/claim-page-guards.test.mjs holds both).
import BaseLayout from '../../layouts/BaseLayout.astro';
import ClaimDialog from '../../components/claim/ClaimDialog.astro';
import ClaimListing from '../../components/claim/ClaimListing.astro';
import { SIGNUP_BASE } from '../../lib/membership';
import { CATEGORY_LABELS } from '../../lib/taxonomy';
import { REF_COOKIE, REF_VIA_COOKIE } from '../../lib/referral';
import { TOUCH_CAPTURE_ENABLED, TOUCH_SID_COOKIE } from '../../lib/touch.mjs';
// sow-434: the licence vocabulary, read at build exactly as src/pages/projects/[slug].astro reads it, so the preview's
// License row is built by the same licenseRow (the page script reads it from data-licenses). It is the public list
// from the repository, nothing about the listing.
import fs from 'node:fs';
import path from 'node:path';
import yaml from 'js-yaml';
const LICENSES = (() => {
  try { return yaml.load(fs.readFileSync(path.resolve(process.cwd(), 'house/licenses.yml'), 'utf8')); }
  catch { return null; }
})();
---
<BaseLayout
  title="An invitation"
  description="A private invitation to join GBTI Network, a professional publishing network for developers."
  noindex={true}
>
  <div
    class="cl"
    data-claim-root
    data-signup-base={SIGNUP_BASE}
    data-labels={JSON.stringify(CATEGORY_LABELS)}
    data-licenses={JSON.stringify(LICENSES)}
    data-ref-cookie={REF_COOKIE}
    data-via-cookie={REF_VIA_COOKIE}
    data-sid-cookie={TOUCH_CAPTURE_ENABLED ? TOUCH_SID_COOKIE : ''}
  >
    <div class="cl-strip" data-claim-strip hidden>
      <div class="pd-wrap cl-strip-in">
        <span class="cl-tag">Invitation preview</span>
        <span class="cl-strip-note">This listing is not published yet.</span>
        <button type="button" class="btn btn-primary cl-open" data-claim-open hidden>Claim this listing</button>
      </div>
    </div>

    <section class="cl-panel" data-claim-panel>
      <div class="cl-card">
        <h1 class="cl-card-title" data-claim-panel-title>Opening your invitation</h1>
        <p class="cl-card-text" data-claim-panel-text></p>
        <div class="cl-card-busy" data-claim-panel-busy><span class="cld-spin" aria-hidden="true"></span><span>One moment</span></div>
        <div class="cld-actions" data-claim-panel-actions></div>
      </div>
      <noscript>
        <div class="cl-card"><p class="cl-card-text">This invitation needs JavaScript to open. Turn it on for this site, then reload the page.</p></div>
      </noscript>
    </section>

    <ClaimListing />
    <ClaimDialog />
  </div>
</BaseLayout>

<script>
  import { startClaimPage } from '../../lib/claim-page';
  startClaimPage(document);
</script>

<style is:global>
  /* The strip pins under the site header, as the WorkBench preview bar does, and the listing's own sticky stack starts
     below it (ClaimListing.astro reads --cl-strip-h, so the height is fixed rather than measured). It is ink in both
     themes, so its copy uses the on-ink grey. A phone gives the sentence its own row under the pill and the button. */
  .cl { --cl-strip-h: 46px; }
  .cl-strip { position: sticky; top: var(--head-h); z-index: 41; height: var(--cl-strip-h); background: var(--ink); border-bottom: 1.5px solid var(--ink-3); }
  .cl-strip[hidden] { display: none; }
  .cl-strip-in { height: 100%; display: flex; align-items: center; gap: 12px; }
  .cl-tag { font-family: var(--f-mono); font-size: 10.5px; letter-spacing: .08em; font-weight: 700; text-transform: uppercase;
    color: var(--ink); background: var(--green-mint); padding: 3px 9px; border-radius: 999px; flex: none; }
  .cl-strip-note { color: #b8b4c2; font-size: 13px; flex: 1; min-width: 0; }
  .cl-open { margin-left: auto; padding: 6px 13px; font-size: 13px; border-radius: var(--r-sm); box-shadow: none; flex: none; }
  .cl-open:hover { transform: none; }
  .cl-open[hidden] { display: none; }
  @media (max-width: 560px) {
    .cl { --cl-strip-h: 72px; }
    .cl-strip-in { display: grid; grid-template-columns: auto 1fr; grid-template-areas: "tag open" "note note"; align-content: center; gap: 6px 10px; }
    .cl-tag { grid-area: tag; justify-self: start; }
    .cl-open { grid-area: open; justify-self: end; }
    .cl-strip-note { grid-area: note; font-size: 12.5px; }
  }

  .cl-panel { display: flex; justify-content: center; padding: 72px 16px 96px; min-height: 60vh; background: var(--paper-2); }
  .cl-panel[hidden] { display: none; }
  .cl-card { width: 100%; max-width: 520px; height: fit-content; padding: 34px; background: var(--paper); border: 1px solid var(--line);
    border-radius: var(--r-lg); box-shadow: var(--sh); }
  @media (max-width: 480px) { .cl-card { padding: 26px 20px; } }
  .cl-card-title { margin: 0 0 10px; font-family: var(--f-display); font-weight: 600; font-size: 26px; line-height: 1.2; color: var(--fg); }
  .cl-card-text { margin: 0; font-size: 15px; line-height: 1.6; color: var(--fg-soft); }
  .cl-card-text:empty { display: none; }
  .cl-card-busy { display: flex; align-items: center; gap: 10px; margin-top: 14px; font-size: 13.5px; color: var(--fg-mute); }
  .cl-card-busy[hidden] { display: none; }
</style>
