---
// sow-230 / sow-243: THE MEMBER-TIER INVITE LANDING. Audience-neutral on purpose: any campaign points at this
// one URL with its own ?coupon=, so a new invite audience needs a coupon and a link rather than a new page.
// Since 2026-09-11 the chrome lives once in src/components/invite/InviteLander.astro; this page is campaign
// data and copy. This page is the pattern the others converged on: no benefit sentence is typed here, the
// list comes from house/membership-tiers.yml through tierDisplay().
//
// IT EXISTS BECAUSE THE PAGE BEFORE IT ADVERTISED CREATOR BENEFITS WHILE GRANTING THE MEMBER TIER. The label
// and the price were right (both from tierDisplay); the benefit PROSE was inherited from the Creator page it
// was copied from. That is exactly what a shared template with no tier sentence of its own makes impossible.
//
// The FAQ answers the OFFER first (what am I getting, will I be charged, what happens when the year ends, how
// do I claim it), then the network. NO BENEFIT LIST IN THE FAQ, NO REVENUE COPY (banned-patterns.md #2).
//
// THE CAMPAIGN. A shared link carries a plain visible ?coupon=LINKEDINCONNECT, which prefills the coupon field
// (QA 2026-07-18: no secret token links); with no parameter the field is hand-editable. The parity test reads
// this line to check that the campaign's tier and this page's tier agree.
import InviteLander from '../../components/invite/InviteLander.astro';
import { BILLING_PERIOD } from '../../lib/membership';
import { tierDisplay, tierLabel, TIER } from '../../lib/tiers'; // sow-316: tierLabel NAMES a tier; tierDisplay binds this page's product

const memberTier = tierDisplay('member');
const TIER_LABEL = memberTier?.label ?? 'Network Member';
const TIER_PRICE_LABEL = `$${memberTier?.priceAnnual ?? 50}`;
const memberBenefits = memberTier?.benefits ?? [];

const faqs = [
  ['What does this invite give me?', `A full year at the ${TIER_LABEL} tier, with everything listed above, at no cost. It is a normal membership for the year, not a limited preview.`],
  ['Do I need a card to claim it?', 'No. No card is collected at any point during the free year, and nothing bills automatically.'],
  ['What happens when the free year ends?', `Nothing happens on its own. ${TIER_LABEL} is ${TIER_PRICE_LABEL} per ${BILLING_PERIOD} if you decide to continue, and you will not be charged unless you choose to.`],
  ['How do I claim it?', 'Sign in with GitHub from this page. Your coupon is already applied, so there is nothing to enter or remember.'],
  ['Can I pass this on to someone else?', 'It is meant for you, but the link works for whoever opens it first, so treat it as personal rather than forwardable.'],
  ['What is the GBTI Network?', `A professional publishing network for developers. Members read and discuss the work published across it and take part in a private community. Publishing your own articles, projects and prompts is the ${tierLabel(TIER.creator)} tier.`],
  ['Is all content public or private?', 'Both. Some work is published openly, and some is network-only. For network-only work, a stub with a short description appears on the public website, while the full content is readable by members inside the login-gated browser extension.'],
  ['Are comments on public-facing content also public?', 'By default, they are not, and can only be read inside the extension by other members. There is, however, the option to make a comment fully public.'],
  ['What does GBTI stand for?', 'God Bless The Internet; a phrase that expresses appreciation and goodwill toward the continued growth and enrichment of the internet.'],
  // The founding story is a FACT about GBTI and stays true for any audience (owner, 2026-08-15).
  ['Why is my first year free?', `The GBTI Network was founded by members of the Codeable network seeking a place to discuss the nuances of project development. This is a private invitation, so your first year at the ${TIER_LABEL} tier is on us.`],
] as const;
---

<InviteLander
  title="Your first year on us"
  description="A private invitation: a full year at the Network Member tier, first year free with your coupon."
  tierLabel={TIER_LABEL}
  tierPriceLabel={TIER_PRICE_LABEL}
  benefits={memberBenefits}
  benefitsHeading={`What ${TIER_LABEL} gives you`}
  benefitsLayout="grid2"
  nav={[{ href: '#benefits', label: 'What you get' }, { href: '#faq', label: 'FAQ' }]}
  navCta={{ href: '#claim', label: 'Claim free year' }}
  hero={{
    titleHtml: 'Your first year<br />on us.',
    lead: `GBTI is a professional publishing network for developers. Read the work published across it and join the conversation: a full year at the ${TIER_LABEL} tier, no card required.`,
    ctaLabel: 'Claim your free year',
    // The design's four mono chips: facts about the OFFER (how billing works), not benefit claims.
    meta: ['no card', 'no auto-bill', 'cancel anytime', 'github sign-in'],
  }}
  claimStyle="panel"
  faqs={faqs}
>
  <Fragment slot="after-faq">
    <!-- ================= CLOSING CTA ================= -->
    <section class="ci-sec">
      <div class="ci-close">
        <h2>Ready when you are</h2>
        <p>Your coupon covers the first year. Sign in with GitHub and you are in: commenting, Discord,
          and members-only reading.</p>
        <a href="#claim" class="btn-primary">Claim your free year</a>
        <!-- The design ended this line with "expires when the invite closes". DROPPED, because it is not
             true: every live coupon carries `expiresAt: null`, so none of them expires. -->
        <div class="ci-close-code" data-close-code hidden>coupon <span data-coupon-echo></span></div>
      </div>
    </section>
  </Fragment>
</InviteLander>
