---
// sow-158 Phase 2: the website sign-in surface.
// sow-271: the copy below no longer sends the reader to the extension for in-place editing. That became
// false when the website started upgrading <gbti-edit-panel> itself (see src/components/EditHooks.astro). A Turnstile-gated "Continue with GitHub" that navigates to the
// Worker's /signup/start (idempotent: an existing member is logged in and their trial clock is untouched; a new
// visitor is signed up into a free no-card trial), carrying a validated return_to so the member lands back where
// they started. The Worker sets the httpOnly gbti_session cookie on the OAuth callback; the header then hydrates
// the signed-in state from it (src/lib/member-signal.ts). Turnstile guards mass trial-creation on this shared
// signup/login endpoint (one solve per 30-day cookie session).
import BaseLayout from '../layouts/BaseLayout.astro';
import { REF_COOKIE, REF_VIA_COOKIE } from '../lib/referral';
import { TOUCH_CAPTURE_ENABLED, TOUCH_SID_COOKIE } from '../lib/touch.mjs';
import { TURNSTILE_SITE_KEY, SIGNUP_BASE } from '../lib/membership';
---
<BaseLayout title="Sign in" description="Sign in to GBTI Network with GitHub." noindex={true}>
  <section class="band">
    <div class="wrap login-wrap">
      <div class="login-card">
        <span class="itile"><svg viewBox="0 0 24 24"><use href="#ico-github"/></svg></span>
        <h1 class="h2 mt16">Sign in to GBTI Network</h1>
        <p class="body-sm muted mt8">
          Continue with GitHub. New here? You get a free account, no card required. Editing and publishing
          your own content works here on the site; the <a href="/extension/">browser extension</a> is optional.
        </p>
        <div class="login-cta mt20">
          <div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY} data-callback="gbtiTurnstileOk" data-expired-callback="gbtiTurnstileReset" data-error-callback="gbtiTurnstileReset" data-theme="auto"></div>
          <button type="button" data-login-go class="btn btn-primary btn-lg login-go" style="width:100%;margin-top:14px" disabled>
            <span class="lg-idle"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><use href="#ico-github"/></svg> Continue with GitHub</span>
            <span class="lg-busy"><span class="lg-spin" aria-hidden="true"></span>Taking you to GitHub&hellip;</span>
          </button>
        </div>
        <p class="body-sm muted tcenter mt12" style="font-size:13px" data-login-wait>Complete the check above to continue.</p>
        <!-- sow-442: GitHub's own sign-in and approval screens are where people stalled, so say what comes next. -->
        <div class="login-next">
          <div class="login-next-h">What happens next</div>
          <ol>
            <li><span class="login-next-n" aria-hidden="true">1</span><span>GitHub may ask you to sign in and, the first time, to approve read-only access to your profile and email.</span></li>
            <li><span class="login-next-n" aria-hidden="true">2</span><span>You come straight back, signed in.</span></li>
          </ol>
        </div>
      </div>
    </div>
  </section>

  <!-- sow-158 Phase 2: Cloudflare Turnstile + the gated /signup/start navigation carrying a same-site return_to. -->
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  <script define:vars={{ signupBase: SIGNUP_BASE, refCookie: REF_COOKIE, viaCookie: REF_VIA_COOKIE, sidCookie: TOUCH_SID_COOKIE, touchEnabled: TOUCH_CAPTURE_ENABLED }}>
    (function () {
      function cookie(name) {
        var c = document.cookie.split('; ').find(function (x) { return x.indexOf(name + '=') === 0; });
        return c ? decodeURIComponent(c.split('=').slice(1).join('=')) : '';
      }
      // A same-site return path from ?return_to. The Worker re-validates (safeReturnTo); this is a client sanity gate.
      function safeReturn() {
        try {
          var rt = new URLSearchParams(location.search).get('return_to') || '';
          if (rt && rt.charAt(0) === '/' && rt.charAt(1) !== '/' && rt.charAt(1) !== '\\' && rt.indexOf('\\') < 0) return rt;
        } catch (e) { /* ignore */ }
        return '/account/';
      }
      var btn = document.querySelector('[data-login-go]');
      var waitNote = document.querySelector('[data-login-wait]');
      window.gbtiTurnstileOk = function (token) { if (btn) { btn.disabled = false; btn.dataset.token = token; } if (waitNote) waitNote.hidden = true; };
      window.gbtiTurnstileReset = function () { if (btn) { btn.disabled = true; delete btn.dataset.token; } };
      // sow-442: a press always answers: the button holds a spinner and "Taking you to GitHub" until the browser
      // leaves; if it has not left in 15 seconds (offline, a blocked navigation) it comes back and the check runs
      // again, so nobody is left with a dead button.
      var pending = false;
      function setPending(on) {
        pending = on;
        if (!btn) return;
        btn.classList.toggle('is-pending', on);
        if (on) btn.setAttribute('aria-busy', 'true'); else btn.removeAttribute('aria-busy');
        if (!on && waitNote) waitNote.hidden = false;
      }
      function showPending() {
        setPending(true);
        setTimeout(function () {
          if (!pending) return;
          setPending(false);
          window.gbtiTurnstileReset();
          try { if (window.turnstile) window.turnstile.reset(); } catch (err) { /* widget not mounted */ }
        }, 15000);
      }
      // A Turnstile token is SINGLE USE. Spend it and immediately drop it, so a second click can never replay a
      // redeemed token into /signup/start (the Worker verifies before anything else and answers 403
      // turnstile_failed, which reads to the visitor as a dead sign-in button with no way back).
      if (btn) btn.addEventListener('click', function () {
        var token = btn.dataset.token;
        if (!token) return;
        window.gbtiTurnstileReset();
        showPending();
        var u = new URL(signupBase + '/signup/start');
        u.searchParams.set('cf-turnstile-response', token);
        var ref = cookie(refCookie); if (ref) u.searchParams.set('ref', ref);
        var via = cookie(viaCookie); if (via) u.searchParams.set('via', via);
        if (touchEnabled) { var sid = cookie(sidCookie); if (sid) u.searchParams.set('sid', sid); }
        u.searchParams.set('return_to', safeReturn());
        window.location.href = u.toString();
      });
      // Back/forward cache restores this page whole: enabled button, stale token, and NO expiry callback (the
      // page was frozen, not running). iOS Safari does this on every Back, so without a reset the normal way
      // back from a failed sign-in replays a spent token. Force a fresh challenge instead.
      window.addEventListener('pageshow', function (e) {
        if (!e.persisted) return;
        setPending(false); // sow-442: the restored page is no longer leaving
        window.gbtiTurnstileReset();
        try { if (window.turnstile) window.turnstile.reset(); } catch (err) { /* widget not mounted yet */ }
      });
    })();
  </script>

  <style>
    .login-wrap { max-width: 460px; }
    .login-card { text-align: center; padding: 8px 0 44px; }
    .login-card .itile { margin: 0 auto; }
    .login-cta { text-align: left; }
    /* sow-442: the button's idle and busy contents (a busy button is working, not off, so it is not faded) and the
       "What happens next" box. */
    .lg-idle, .lg-busy { align-items: center; justify-content: center; gap: 10px; }
    .lg-idle { display: inline-flex; }
    .lg-busy { display: none; }
    .login-go.is-pending .lg-idle { display: none; }
    .login-go.is-pending .lg-busy { display: inline-flex; }
    .login-go.is-pending, .login-go.is-pending:disabled { opacity: 1; cursor: progress; pointer-events: none; }
    .lg-spin { width: 16px; height: 16px; flex: none; border-radius: 50%; border: 2.5px solid rgba(255,255,255,.35); border-top-color: #fff; animation: lg-spin .9s linear infinite; }
    @keyframes lg-spin { to { transform: rotate(360deg); } }
    @media (prefers-reduced-motion: reduce) { .lg-spin { animation-duration: 2.4s; } }
    .login-next { margin-top: 18px; padding: 16px; text-align: left; background: var(--paper); border: 1px solid var(--line); border-radius: 10px; }
    .login-next-h { font-family: var(--f-mono); font-size: 10.5px; letter-spacing: .12em; text-transform: uppercase; color: var(--fg-soft); margin-bottom: 12px; }
    .login-next ol { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 10px; }
    .login-next li { display: flex; gap: 10px; font-size: 13.5px; line-height: 1.45; color: var(--fg-soft); }
    .login-next-n { flex: none; width: 20px; height: 20px; border-radius: 50%; background: var(--green-tint); color: var(--green); font-weight: 700; font-size: 12px; display: flex; align-items: center; justify-content: center; }
    :global(html[data-theme="dark"]) .login-next-n { color: var(--green-mint); }
  </style>
</BaseLayout>
