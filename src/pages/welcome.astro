---
// sow-207: the post-signup welcome flow on gbti.network. A signed-in member (fresh from signup, including a
// Codeable coupon invitee) lands here and walks the shared <gbti-welcome> wizard: connect Discord, follow the
// network channels, add their socials, follow members, and pick topics. The wizard is the SAME client-ui
// component the extension uses (client-ui/src/elements/gbti-welcome.mjs), wired to the cookie-session adapter
// (src/lib/workbench-client) so no GitHub token is in the page. Signed-out visitors get the sign-in prompt.
// noindex: a private, per-member surface. Mount pattern mirrors src/pages/account.astro.
//
// sow-387: the wizard is the website's alone now (the extension shows no setup steps), and the extension opens this
// page right after a member's first sign-in there. The page therefore waits for a CONFIRMED cookie session before it
// mounts the steps: it opens on the loading state, shows the steps only when the session read says signed in, the
// sign-in prompt only when it says signed out, and a reload message when the read failed. The extension's identity
// signal is display-only and no longer mounts anything here (a wizard mounted on it saved nothing).
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Welcome" description="Welcome to the GBTI Network. Finish setting up your membership." noindex={true}>
  <section class="band band-app">
    <div class="wrap wel-wrap">
      {/* Signed-OUT prompt. Hidden until the session read says signed out (sow-387): static SSG has no request-time
          cookie, so the page opens on the loading state below instead, and never flashes "Sign in" at a member. */}
      <div class="sec-head center" data-welcome-signedout hidden>
        <span class="itile"><svg viewBox="0 0 24 24"><use href="#ico-id"/></svg></span>
        <h1 class="h1 mt24">Welcome to the GBTI Network</h1>
        <p class="lead">
          Sign in with GitHub to finish setting up: follow members and channels, add your socials, and pick
          the topics you want in your feed. The Discord community comes with a paid membership.
        </p>
        <a href="/login/?return_to=%2Fwelcome%2F" class="btn btn-primary btn-lg mt24">Sign in <svg class="ar" viewBox="0 0 24 24" width="18" height="18"><use href="#ico-arrow"/></svg></a>
      </div>

      {/* A session read that failed (a Worker deploy window, a network blip). Not a signed-out answer. */}
      <div class="sec-head center" data-welcome-retry hidden>
        <span class="itile"><svg viewBox="0 0 24 24"><use href="#ico-id"/></svg></span>
        <h1 class="h1 mt24">Welcome to the GBTI Network</h1>
        <p class="lead">We could not confirm your sign-in just now. Reload the page to try again.</p>
        <button type="button" class="btn btn-primary btn-lg mt24" data-welcome-reload>Reload</button>
      </div>

      {/* Signed-IN welcome wizard, hydrated client-side from the httpOnly-cookie session (member-signal.ts). Visible
          from the start with its loading line, which is the page's state until the session read ends. */}
      <div data-welcome-signedin>
        <div data-welcome-mount>
          <p class="wel-load">Loading your welcome&hellip;</p>
          <noscript><p class="wel-load">This page needs JavaScript. <a href="/login/?return_to=%2Fwelcome%2F">Sign in</a> with it turned on to finish setting up.</p></noscript>
          <gbti-welcome></gbti-welcome>
        </div>
        <p class="wel-skip"><a href="/account/" data-welcome-skip>Skip for now, go to my account</a></p>
      </div>
    </div>
  </section>

  <script>
    import { whenCookieState, hasWebSessionCookie } from '../lib/member-signal';
    import { welcomeView } from '../lib/member-signal-core.mjs';

    const out = document.querySelector('[data-welcome-signedout]') as HTMLElement | null;
    const inn = document.querySelector('[data-welcome-signedin]') as HTMLElement | null;
    const retry = document.querySelector('[data-welcome-retry]') as HTMLElement | null;
    document.querySelector('[data-welcome-reload]')?.addEventListener('click', () => location.reload());

    let mounted = false; // the client-ui wizard loads once, on the first signed-in signal

    // sow-343: a brand-new account arrives here from sign-in with `next`, where it was headed. The skip link sends it
    // on. Same-site paths only, the same rule the login page applies to return_to; anything else is ignored.
    function safeNext(): string {
      try {
        const n = new URLSearchParams(location.search).get('next') || '';
        if (n.charAt(0) === '/' && n.charAt(1) !== '/' && n.charAt(1) !== '\\' && n.indexOf('\\') < 0 && !/[\u0000-\u001f]/.test(n)) return n;
      } catch { /* ignore */ }
      return '';
    }
    const next = safeNext();
    const skip = document.querySelector('[data-welcome-skip]') as HTMLAnchorElement | null;
    if (skip && next) { skip.href = next; skip.textContent = 'Skip for now and continue'; }

    // sow-387: one of four faces (member-signal-core welcomeView). 'loading' and 'wizard' share the signed-in block,
    // whose loading line stays until the wizard mounts.
    function show(view: string, s: any) {
      if (out) out.hidden = view !== 'signin';
      if (retry) retry.hidden = view !== 'retry';
      if (inn) inn.hidden = view !== 'loading' && view !== 'wizard';
      if (view === 'wizard' && s && s.login) mountWelcome(s);
    }

    async function mountWelcome(s: any) {
      if (mounted) return;
      mounted = true;
      const signupBase = document.documentElement.dataset.signupBase || '';
      // Set the client BEFORE defining the element, so <gbti-welcome>'s connectedCallback -> load() sees it
      // (avoids the client-ready race; the same ordering account.astro uses).
      const { createWorkbenchClient } = await import('../lib/workbench-client');
      const { setClient } = await import('../../client-ui/src/base.mjs');
      const adapter = createWorkbenchClient({ signupBase, login: String(s.login), githubId: s.githubId != null ? String(s.githubId) : null });
      setClient(adapter);
      // sow-343: the WorkBench progress card links to one step (?step=<key>); the element ignores a key it does not know.
      const step = new URLSearchParams(location.search).get('step');
      if (step) document.querySelector('gbti-welcome')?.setAttribute('start-step', step);
      document.querySelectorAll('.wel-load').forEach((el) => el.setAttribute('hidden', ''));
      // Defining the element upgrades the static tag; it renders on the setClient subscriber fan-out.
      await import('../../client-ui/src/elements/gbti-welcome.mjs');
      // When the member finishes the wizard, land on the account hub (the website member surface, sow-158).
      document.querySelector('gbti-welcome')?.addEventListener('gbti:welcome-done', () => {
        window.location.href = '/account/';
      });
    }

    // First paint: with no session cookie the answer is already known (sign in); with one, stay on the loading state.
    show(welcomeView({ hasSessionCookie: hasWebSessionCookie() }), null);
    // BaseLayout invokes hydrateMemberSignal(); its read settles here. A read that never settles (a failed chunk
    // load) is treated as a failed read after WAIT_MS, so the page cannot sit on "Loading" for ever.
    const WAIT_MS = 15000;
    let settled = false;
    whenCookieState().then(({ state, signal }) => {
      settled = true;
      show(welcomeView({ hasSessionCookie: true, cookie: { state } }), signal);
    });
    setTimeout(() => { if (!settled) show(welcomeView({ hasSessionCookie: true, cookie: { state: 'error' } }), null); }, WAIT_MS);
  </script>

  <style>
    .wel-wrap { max-width: 1040px; }
    .wel-load { color: var(--fg-mute); font-size: 14px; }
    .wel-load[hidden] { display: none; }
    .wel-skip { text-align: center; margin-top: 28px; font-size: 13.5px; }
    .wel-skip a { color: var(--fg-mute); }
    .wel-skip a:hover { color: var(--green-700); }
  </style>
</BaseLayout>
