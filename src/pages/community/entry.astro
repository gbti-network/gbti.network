---
// sow-494: one COMMUNITY entry, /community/entry/?id=<id>. A static shell: the entry, its answers and its discussion
// are read at run time from the signup Worker, which answers not_found both for an entry that does not exist and for
// one not shared with this member, so the page names nothing it should not. noindex, and out of the sitemap.
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Community" description="An entry in GBTI Network Community, for members." noindex={true}>
  <section class="band band-app">
    <div class="wrap community-entry-wrap">
      <div class="cm-signin" data-cm-signedout hidden>
        <span class="itile"><svg viewBox="0 0 24 24"><use href="#ico-grid"/></svg></span>
        <h1 class="h2 mt16">Sign in to take part</h1>
        <p class="lead">Community entries are for members. Sign in with GitHub to answer and join the discussion.</p>
        <a href="/login/?return_to=%2Fcommunity%2F" class="btn btn-primary btn-lg mt16" data-cm-return>Sign in <svg class="ar" viewBox="0 0 24 24" width="18" height="18"><use href="#ico-arrow"/></svg></a>
      </div>
      <div data-cm-mount>
        <gbti-community-entry></gbti-community-entry>
      </div>
    </div>
  </section>
  <script>
    import { mountCommunity } from '../../lib/community-page';
    const id = new URLSearchParams(location.search).get('id') || '';
    document.querySelector('gbti-community-entry')?.setAttribute('entry-id', id);
    const back = document.querySelector('[data-cm-return]') as HTMLAnchorElement | null;
    if (back) back.href = `/login/?return_to=${encodeURIComponent(location.pathname + location.search)}`;
    mountCommunity({ tag: 'gbti-community-entry', element: () => import('../../../client-ui/src/elements/gbti-community-entry.mjs') });
  </script>
  <style>
    .community-entry-wrap { max-width: 840px; }
    .cm-signin { text-align: center; padding: 24px 0; }
  </style>
</BaseLayout>
