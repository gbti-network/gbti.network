{
  "manifest_version": 3,
  "name": "GBTI Network Extension",
  "version": "0.6.0",
  "description": "Opens the GBTI Network hub on every new tab: read member articles and projects, save for later, share, and follow news.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "identity"],
  "host_permissions": [
    "https://gbti.network/*",
    "https://signup.gbti.network/*"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://gbti.network/*"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Open GBTI Network",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  }
}
